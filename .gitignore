**/node_modules
/.stx
/pantry
.stx
pantry
.claude/scheduled_tasks.lock
# Crosswind writes compiled CSS to dist/crosswind.css; STX picks it up
# automatically at build time, so it's a generated artifact rather than
# tracked source. Same with any other build output that lands here.
dist/
**/dist/
/.screenshots
# Local environment and decryption keys
.env
.env.local
.env.keys
.env.development
.env.staging

# Production values are encrypted and safe to deploy from source
!.env.production

# Runtime databases and build state
database/stacks.sqlite
database/stacks_testing.sqlite
database/*.sqlite-wal
database/*.sqlite-shm

# Generated from app/Models by `buddy migrate:regenerate --force`, which every
# build runs (scripts/build-desktop-{app,windows}.ts, and ci.yml before the
# tests). The numbering is not stable across regenerations - the same
# cleanup_runs table was 0000000073 when a80e390 removed these from the tree and
# is 0000000002 today - so tracking them produces a diff that says nothing on
# every build. A hand-written migration would need a negation here.
database/migrations/
storage/framework/stx/
storage/framework/.cache/
storage/framework/auto-imports/*
!storage/framework/auto-imports/.gitkeep
storage/framework/runtime/
storage/cloud/
storage/framework/cache/
storage/logs/
/storage/framework/frontend-dist
/storage/framework/desktop-dist
/storage/framework/desktop-windows
/storage/framework/desktop-dmg

# Staged into the .app by `buddy build:dmg`; both halves are build output
# (the rendered UI, and the migrations generated from app/Models).
/app/Desktop/Resources

# Local AI-client projections; Buddy rebuilds these from framework defaults
/.claude
/.codex
/.gemini
/CLAUDE.md
/GEMINI.md
/.github/copilot-instructions.md

# Local framework pointers and update state
/.framework
/.stacks
/.stacks-channel
/.stacks-version
/.tmp-upgrade/

# Compiled CLI release artifacts (produced by scripts/build-binaries.ts)
#
# Every target name the script can emit, not the two that exist today: a
# `--keep` build leaves the raw binary beside the archive, and the Windows
# .exe - 44 MB of it - was not covered by the darwin-only pattern.
# `system-cleaner.ts` has no dash after the name, so the entry point is never
# matched; the negation below is belt and braces.
packages/cli/bin/*.zip
packages/cli/bin/system-cleaner-*
!packages/cli/bin/system-cleaner.ts

# Local visual-QA output
.shots/

# Regenerated by local tooling; removed from the tree in 92dcdcd
pantry.lock
storage/framework/discovered-packages.json

# Client scripts bundled from resources/scripts by scripts/build-client-scripts.ts.
# `bun run dev` and `bun run build:app` both build them; editing the output
# rather than the source would be silently overwritten.
/public/app-menu.js
/public/native-dialog.js
/public/platform-gate.js
/public/settings-panel.js
/public/settings-window.js
/public/vpn-panel.js
/public/vpn-window.js
