<script server>
// The sidebar: six places, one row each.
//
// It lists sections, never tools. Each section has a page of its own that
// presents its tools as cards, so the sidebar stays a short list of places to
// go instead of an index of every screen in the app. It was fourteen icons,
// then fourteen rows under five headings; both made the sidebar the thing you
// had to read before you could do anything.
//
// The table lives in `resources/lib/sections.ts`, which the toolbar, the
// section pages and the Go menu read too.
//
// `active` is the view's `nav` id: a section page's `hub-…`, or a tool's own
// id, which lights the section holding it. SPA navigations only swap
// `[data-stx-content]` and leave this mounted, so the client block below
// re-syncs the selection from the URL on every route change.
const { SECTIONS, sectionFor } = require('~/resources/lib/sections')

const current = sectionFor($props.active || '')
export const activeSection = current ? current.section.id : ''

export const rows = SECTIONS.map(section => ({
  id: section.id,
  label: section.label,
  href: section.href,
  icon: section.icon,
  // Every path that lights this row, space-separated for the client sync.
  routes: [section.href, ...(section.id === 'overview' ? [] : section.tools.map(tool => tool.href))].join(' '),
  scans: section.tools.flatMap(tool => tool.scans || []).join(' '),
}))

export const groups = [
  rows.filter(row => row.id === 'overview'),
  rows.filter(row => row.id !== 'overview'),
]
</script>

<script client>
function syncActive(): void {
  const path = (useRoute().path || '/').replace(/\/+$/, '') || '/'
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-item]'))

  // A section's own page wins outright; otherwise the longest tool path that
  // matches, so `/app/disk` never also lights `/app`.
  let best: HTMLAnchorElement | null = null
  let bestLength = -1
  for (const item of items) {
    for (const route of (item.getAttribute('data-rail-routes') || '').split(' ')) {
      if (!route) continue
      const matches = path === route || (route !== '/app' && path.startsWith(`${route}/`))
      if (matches && route.length > bestLength) {
        best = item
        bestLength = route.length
      }
    }
  }

  for (const item of items) {
    const selected = item === best
    item.toggleAttribute('data-active', selected)
    if (selected)
      item.setAttribute('aria-current', 'page')
    else
      item.removeAttribute('aria-current')
  }
}

/**
 * Mark the section whose scan is still running.
 *
 * A disk or large-file scan keeps going in the agent after you leave its
 * screen. The sidebar outlives navigation, so it is the one place that can say
 * so from anywhere in the app.
 */
function syncScanning(): void {
  // Nobody can see the dot while the window is hidden; ask again when it is
  // shown rather than every two seconds in the dark.
  if (document.hidden)
    return
  fetch('/api/scan-state', { method: 'POST', cache: 'no-store' })
    .then(r => r.json())
    .then((d: { scans?: { kind: string, status: string }[] }) => {
      const busy = new Set((d.scans || []).filter(scan => ['queued', 'running', 'cancelling'].includes(scan.status))
        .map(scan => scan.kind))
      for (const item of Array.from(document.querySelectorAll<HTMLElement>('[data-rail-item]'))) {
        const kinds = (item.getAttribute('data-rail-scans') || '').split(' ').filter(Boolean)
        item.toggleAttribute('data-scanning', kinds.some(kind => busy.has(kind)))
      }
    })
    .catch(() => {})
}

useEventListener('stx:navigate', syncActive)
useEventListener('stx:load', syncActive)
// The runtime's document overload does not attach (its first argument is
// read as the event name), and visibilitychange bubbles to the window anyway.
useEventListener('visibilitychange' as keyof WindowEventMap, syncScanning)

// Two seconds: fast enough that the dot appears while you are still deciding
// where to click, slow enough to be invisible next to a scan's own work.
useIntervalFn(syncScanning, 2000, { immediate: true })
</script>

<nav class="rail" id="app-sidebar" aria-label="SystemCleaner sections">
  <!--
    Three bands, top to bottom: where you start, the five places you go, and
    the app itself. Overview stands apart because it is the one row that is
    about every section at once.
  -->
  <div class="rail-groups">
    @foreach (groups as group)
      <div class="side-group">
        @foreach (group as row)
          <a
            class="rail-item side-row"
            data-tone="{{ row.id }}"
            data-rail-item="{{ row.id }}"
            data-rail-routes="{{ row.routes }}"
            data-rail-scans="{{ row.scans }}"
            href="{{ row.href }}"
            data-stx-link
            @if(activeSection === row.id)data-active aria-current="page"@endif
          >
            <span class="side-tile" aria-hidden="true"><span class="{{ row.icon }}"></span></span>
            <span class="side-label">{{ row.label }}</span>
            @if(row.id === 'apps')
              <span class="side-badge" data-updates-badge hidden></span>
            @endif
          </a>
        @endforeach
      </div>
    @endforeach
  </div>

  <div class="rail-foot">
    <!-- The one figure worth carrying everywhere: how full the disk is. -->
    <a class="side-disk" href="/app/disk" data-stx-link aria-label="Disk Usage">
      <span class="side-disk-head">
        <span class="side-disk-name">Startup disk</span>
        <span class="side-disk-free" data-metric="disk-free" data-metric-template="{value} free">&hellip;</span>
      </span>
      <span class="side-disk-bar"><span data-metric="disk-pct" data-metric-style="--pct"></span></span>
    </a>
    <button class="side-row side-utility" type="button" data-open-settings>
      <span class="side-utility-icon" aria-hidden="true"><span class="i-f7-gear-alt-fill"></span></span>
      <span class="side-label">Settings</span>
    </button>
    <span class="side-local" title="Every scan and every clean runs on this Mac. Nothing is uploaded.">
      <span class="i-f7-lock-fill" aria-hidden="true"></span>
      <span>Everything stays on this Mac</span>
    </span>
  </div>
</nav>
