<script server>
// Icon rail. Labels live in tooltips rather than in the row, so the rail
// costs 76px instead of 234px and the content column gets the difference.
//
// Privacy and Schedule are not here — they moved to the top strip
// (`AppTopNav`), because they configure the app rather than inspect the Mac,
// and a rail of scanners was the wrong company for them.
//
// `active` is passed by each view so a cold page load paints the correct
// selection with no flash. SPA navigations only swap `[data-stx-content]`,
// which leaves this rail mounted, so the client block below re-syncs the
// selection on every route change.
export const active = $props.active || ''

export const groups = [
  [
    { id: 'dashboard', label: 'Dashboard', icon: 'i-f7-square-grid-2x2-fill', href: '/app' },
  ],
  [
    { id: 'startup', label: 'Startup Items', icon: 'i-f7-bolt-fill', href: '/app/startup' },
    { id: 'extensions', label: 'Extensions', icon: 'i-f7-square-stack-3d-up-fill', href: '/app/extensions' },
    { id: 'processes', label: 'Processes', icon: 'i-f7-chart-bar-alt-fill', href: '/app/processes' },
  ],
  [
    { id: 'disk', label: 'Disk Usage', icon: 'i-f7-chart-pie-fill', href: '/app/disk' },
    { id: 'large-files', label: 'Large Files', icon: 'i-f7-doc-on-doc-fill', href: '/app/large-files' },
    { id: 'duplicates', label: 'Duplicates', icon: 'i-f7-square-on-square', href: '/app/duplicates' },
  ],
  [
    { id: 'applications', label: 'Applications', icon: 'i-f7-app-fill', href: '/app/applications' },
    { id: 'maintenance', label: 'Maintenance', icon: 'i-f7-wrench-fill', href: '/app/maintenance' },
    { id: 'updates', label: 'Updates', icon: 'i-f7-arrow-down-circle-fill', href: '/app/updates' },
  ],
  [
    { id: 'cleanup', label: 'Quick Clean', icon: 'i-f7-sparkles', href: '/app/cleanup' },
  ],
]
</script>

<script client>
function syncActive(): void {
  const path = useRoute().path
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-rail-item]'))

  // Longest matching href wins, so `/app/disk` does not also light up `/app`.
  let best: HTMLAnchorElement | null = null
  for (const item of items) {
    const href = item.getAttribute('href') || ''
    const matches = path === href || path.startsWith(`${href}/`)
    if (matches && (!best || href.length > (best.getAttribute('href') || '').length))
      best = item
  }

  for (const item of items) {
    const selected = item === best
    item.toggleAttribute('data-active', selected)
    if (selected)
      item.setAttribute('aria-current', 'page')
    else
      item.removeAttribute('aria-current')
  }
}

/**
 * Mark the section whose scan is still running.
 *
 * A disk or large-file scan keeps going in the agent after you leave its
 * screen, and until now nothing said so — you came back to a spinner with no
 * way of knowing whether it had been working the whole time or had died. The
 * rail outlives navigation, so it is the one place that can carry this.
 */
function syncScanning(): void {
  fetch('/api/scan-progress', { method: 'POST' })
    .then(r => r.json())
    .then((d: { scanning?: boolean, kind?: string }) => {
      const busy = d?.scanning ? (d.kind === 'large-files' ? 'large-files' : 'disk') : ''
      for (const item of Array.from(document.querySelectorAll<HTMLElement>('[data-rail-item]')))
        item.toggleAttribute('data-scanning', item.getAttribute('data-rail-item') === busy)
    })
    .catch(() => {})
}

useEventListener('stx:navigate', syncActive)
useEventListener('stx:load', syncActive)

// Two seconds: fast enough that the dot appears while you are still deciding
// where to click, slow enough to be invisible next to a scan's own work.
useIntervalFn(syncScanning, 2000, { immediate: true })
</script>

<nav class="rail" aria-label="SystemCleaner sections">
  <a class="rail-brand" href="/app" data-stx-link aria-label="SystemCleaner dashboard">
    <img src="/images/systemcleaner-mark.svg" width="30" height="30" alt="" />
  </a>

  <div class="rail-groups">
    @foreach (groups as group)
      <div class="rail-group">
        @foreach (group as item)
          <a
            class="rail-item"
            data-rail-item="{{ item.id }}"
            href="{{ item.href }}"
            data-stx-link
            aria-label="{{ item.label }}"
            @if(active === item.id)data-active aria-current="page"@endif
          >
            <span class="rail-icon {{ item.icon }}" aria-hidden="true"></span>
            <span class="rail-tip" role="tooltip">{{ item.label }}</span>
          </a>
        @endforeach
      </div>
    @endforeach
  </div>

  <div class="rail-foot">
    <span class="rail-badge rail-item" aria-label="All processing happens on this Mac">
      <span class="i-f7-lock-shield-fill rail-icon" aria-hidden="true"></span>
      <span class="rail-tip" role="tooltip">Local only</span>
    </span>
  </div>
</nav>
