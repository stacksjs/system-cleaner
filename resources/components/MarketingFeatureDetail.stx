<script server>
import { FEATURES, MARKETING_SECTIONS, featureBySlug, sectionOf } from '~/app/Support/Marketing/catalog'

export const feature = featureBySlug($props.slug) || FEATURES[0]
export const section = sectionOf(feature)
export const featureIcon = `i-f7-${feature.icon}`
// The rest of this section first, then one feature from each other section,
// so the list reads as "more here" before "elsewhere in the app".
export const siblings = section.features.filter(item => item.slug !== feature.slug)
export const elsewhere = MARKETING_SECTIONS
  .filter(other => other.id !== section.id && other.features.length > 0)
  .map(other => ({ ...other.features[0], tone: other.id, sectionLabel: other.label, sectionIcon: other.icon }))
export const sectionTools = section.tools.join(', ')
</script>

<MarketingPageHero
  :tone="section.id"
  :icon="featureIcon"
  :crumb="section.label"
  :crumbIcon="section.icon"
  :title="feature.name"
  :lede="feature.summary"
  secondaryHref="/features"
  secondaryLabel="All features"
/>

<article class="site-container">
  <section class="detail" aria-labelledby="feature-how-title" data-tone="{{ section.id }}">
    <div>
      <h2 id="feature-how-title">How it works</h2>
      <p>{{ feature.description }}</p>
    </div>
    <aside class="fact">
      <span class="tone-tile tone-tile-lg"><span class="{{ featureIcon }}" aria-hidden="true"></span></span>
      <strong>{{ feature.metric }}</strong>
      <span>{{ feature.detail }}</span>
    </aside>
  </section>

  <section class="where" aria-labelledby="feature-where-title">
    <h2 id="feature-where-title" class="sub-title">Where it lives in the app</h2>
    <div class="where-grid">
      <p>You will find it in the app's <strong>{{ section.label }}</strong> section, which holds {{ sectionTools }}. {{ section.lede }}</p>
      <figure class="app-window">
        <img src="{{ section.image }}" width="1400" height="900" loading="lazy" decoding="async" alt="The {{ section.label }} page in SystemCleaner" />
      </figure>
    </div>
  </section>

  @if(siblings.length)
    <section class="more" aria-labelledby="feature-siblings-title">
      <h2 id="feature-siblings-title" class="sub-title">More in {{ section.label }}</h2>
      <ul class="card-list">
        @foreach (siblings as item)
          <li>
            <a href="/features/{{ item.slug }}" data-stx-link data-tone="{{ section.id }}">
              <span class="tone-tile tone-tile-lg"><span class="i-f7-{{ item.icon }}" aria-hidden="true"></span></span>
              <span>
                <strong>{{ item.name }}</strong>
                <small>{{ item.summary }}</small>
              </span>
              <span class="arrow i-f7-arrow-right" aria-hidden="true"></span>
            </a>
          </li>
        @endforeach
      </ul>
    </section>
  @endif

  <section class="more" aria-labelledby="feature-elsewhere-title">
    <h2 id="feature-elsewhere-title" class="sub-title">Elsewhere in SystemCleaner</h2>
    <ul class="card-list">
      @foreach (elsewhere as item)
        <li>
          <a href="/features/{{ item.slug }}" data-stx-link data-tone="{{ item.tone }}">
            <span class="tone-tile tone-tile-lg"><span class="i-f7-{{ item.icon }}" aria-hidden="true"></span></span>
            <span>
              <strong>{{ item.name }}</strong>
              <small>{{ item.sectionLabel }}: {{ item.summary }}</small>
            </span>
            <span class="arrow i-f7-arrow-right" aria-hidden="true"></span>
          </a>
        </li>
      @endforeach
    </ul>
  </section>
</article>

<MarketingDownload />
