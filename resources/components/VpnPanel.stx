<div class='vpn-panel' x-data='vpnXData()' x-destroy='stop()'>
  <section class='vpn-hero' aria-label='VPN status' :data-state='tone()'>
    <div class='vpn-hero-art' aria-hidden='true'>
      <div class='vpn-hero-orbits'>
        <span class='i-f7-shield-lefthalf-fill vpn-emblem'></span>
      </div>
    </div>
    <div class='vpn-hero-text'>
      <div class='flex gap-2 items-center vpn-provider'><span class='vpn-status-dot' aria-hidden='true'></span> Localtunnels VPN</div>
      <h2 aria-live='polite' x-text='title()'>Checking status</h2>
      <p x-text='summary()'></p>
      <div class='grid gap-2 vpn-session' x-show='reading?.connected' x-cloak>
        <span><span class='vpn-session-label'>Coordinator</span> <strong x-text='reading?.connection?.coordinatorUrl'></strong></span>
        <span><span class='vpn-session-label'>Tunnel address</span> <strong x-text='reading?.connection?.tunnel?.address'></strong></span>
      </div>
    </div>
  </section>

  <div class='vpn-alert' role='status' x-show='statusError' x-cloak>
    <span class='i-f7-exclamationmark-circle' aria-hidden='true'></span>
    <span x-text='statusError'></span>
    <button type='button' class='vpn-button vpn-button--quiet' @click='refresh(true)' :disabled='refreshing'>Refresh</button>
  </div>

  <div class='grid gap-4 vpn-content' x-show='reading' x-cloak>
    <section class='vpn-connection vpn-surface' aria-label='Connection' x-show='available()'>
      <div class='flex gap-3 items-start vpn-section-heading'>
        <span class='i-f7-link vpn-section-icon' aria-hidden='true'></span>
        <div>
          <h2>Connection</h2>
          <p x-show='available() && !reading?.connection && !reading?.needsRestore && reading?.core.healthy'>Use the address and key from your network administrator.</p>
          <p x-show='reading?.connection'>This session is managed by SystemCleaner.</p>
        </div>
      </div>

      <div class='vpn-setup' x-show='available() && !reading?.core.healthy && !reading?.connection'>
        <h3>Set up Localtunnels</h3>
        <p>SystemCleaner downloads the Localtunnels CLI and its VPN library from the official release, then runs a self-test.</p>
        <button type='button' class='vpn-button vpn-button--primary' @click="act('install')" :disabled='operation()'>
          <span class='i-f7-arrow-down-circle' aria-hidden='true'></span>
          <span x-text="operation() === 'install' ? 'Installing…' : reading?.core.available ? 'Repair Localtunnels' : 'Install Localtunnels'"></span>
        </button>
      </div>

      <form class='grid gap-4 vpn-form' x-show='available() && reading?.core.healthy && !reading?.connection && !reading?.needsRestore' @submit.prevent="act('connect')">
        <div class='vpn-field'>
          <label for='vpn-coordinator'>Coordinator address</label>
          <input id='vpn-coordinator' type='text' x-model='coordinator' placeholder='wss://vpn.example.com:51821'
            required autocomplete='off' spellcheck='false' autocapitalize='off' :disabled='operation()' aria-describedby='vpn-coordinator-hint'>
          <p id='vpn-coordinator-hint'>Accepts ws:// or wss://. Use wss:// for remote coordinators.</p>
        </div>
        <div class='vpn-field'>
          <label for='vpn-auth'>Auth key <span>· if required</span></label>
          <div class='vpn-input-row'>
            <input id='vpn-auth' type='password' :type="showKey ? 'text' : 'password'" x-model='authKey'
              autocomplete='off' spellcheck='false' autocapitalize='off' :disabled='operation()' placeholder='Coordinator key'>
            <button class='vpn-button vpn-button--quiet' type='button' @click='showKey = !showKey' :aria-pressed='showKey'
              x-text="showKey ? 'Hide' : 'Show'">Show</button>
          </div>
        </div>
        <fieldset class='vpn-routing' :disabled='operation()'>
          <legend>Traffic routing</legend>
          <div class='grid gap-2 vpn-choices'>
            <label class='vpn-choice' :data-selected="routing === 'mesh'">
              <input type='radio' name='vpn-routing' value='mesh' x-model='routing'>
              <span><strong>Private network</strong><small>Reach peers on your VPN.</small></span>
            </label>
            <label class='vpn-choice' :data-selected="routing === 'exit'">
              <input type='radio' name='vpn-routing' value='exit' x-model='routing'>
              <span><strong>Use exit node</strong><small>Route internet traffic and DNS through the VPN.</small></span>
            </label>
          </div>
          <p x-show="routing === 'exit'">Requires a trusted coordinator with an online exit node. Localtunnels selects an advertised exit automatically.</p>
        </fieldset>
        <div class='flex gap-3 items-center vpn-actions'>
          <button type='submit' class='vpn-button vpn-button--primary' :disabled='operation() || !coordinator.trim()'>
            <span class='i-f7-power' aria-hidden='true'></span>
            <span x-text="operation() === 'connect' ? 'Connecting…' : 'Connect'">Connect</span>
          </button>
          <small>Requires macOS authorization</small>
        </div>
      </form>

      <div class='vpn-actions' x-show='available() && reading?.connection'>
        <button type='button' class='vpn-button vpn-button--danger' @click="act('disconnect')" :disabled='operation()'>
          <span class='i-f7-power' aria-hidden='true'></span>
          <span x-text="operation() === 'disconnect' ? 'Disconnecting…' : 'Disconnect'">Disconnect</span>
        </button>
      </div>
      <div class='vpn-actions' x-show='reading?.needsRestore && reading?.core.available'>
        <button type='button' class='vpn-button vpn-button--primary' @click="act('disconnect')" :disabled='operation()'>
          <span class='i-f7-arrow-clockwise' aria-hidden='true'></span>
          <span x-text="operation() === 'disconnect' ? 'Restoring…' : 'Restore network settings'">Restore network settings</span>
        </button>
      </div>
      <div class='vpn-alert' role='status' :data-error='failed' x-show='notice' x-cloak>
        <span class='i-f7-info-circle' aria-hidden='true'></span><span x-text='notice'></span>
      </div>
    </section>

    <aside class='vpn-diagnostics vpn-surface' aria-label='Localtunnels diagnostics'>
      <div class='flex gap-3 items-start vpn-section-heading'>
        <span class='i-f7-waveform-path-ecg vpn-section-icon' aria-hidden='true'></span>
        <h2>Diagnostics</h2>
      </div>
      <dl class='vpn-readings'>
        <div><dt>VPN core</dt><dd x-text='coreSummary()'></dd></div>
        <div><dt>Device identity</dt><dd x-text="reading?.identity ? 'Ready' : 'Created at first connection'"></dd></div>
        <div><dt>IPv4 tunnel interfaces</dt><dd x-text='reading?.tunnels?.length ?? 0'></dd></div>
      </dl>
      <details class='vpn-details'>
        <summary>Technical details</summary>
        <div x-show='reading?.core.cliPath'>
          <strong>CLI path</strong><code x-text='reading?.core.cliPath'></code>
        </div>
        <p x-show='reading?.core.detail' x-text='reading?.core.detail'></p>
        <div x-show='reading?.identity'>
          <strong>Device public key</strong>
          <code x-text='reading?.identity?.publicKey'></code>
        </div>
        <div x-show='reading?.tunnels?.length'>
          <strong>Tunnel interfaces</strong>
          <ul>
            <template x-for='t in reading?.tunnels || []' :key="t.name + t.address">
              <li><code x-text="t.name + ' · ' + t.address"></code></li>
            </template>
          </ul>
        </div>
      </details>
      <button type='button' class='vpn-button vpn-button--quiet' @click='refresh(true)' :disabled='refreshing'>
        <span class='i-f7-arrow-clockwise' aria-hidden='true'></span>
        <span x-text="refreshing ? 'Checking…' : 'Refresh status'">Refresh status</span>
      </button>
    </aside>
  </div>
</div>
