<script client>
interface ChartTick {
  label: string
  offset: number
}

interface SystemHistory {
  cpuPath: string
  cpuArea: string
  memoryPath: string
  memoryArea: string
  cpuLabel: string
  memoryLabel: string
  yTicks: ChartTick[]
  xTicks: ChartTick[]
  plot: { left: number, right: number, top: number, bottom: number }
  sampleCount: number
}

interface DashboardStats {
  success: boolean
  cpuAvgPercent: number
  memPercent: number
  systemHistory: SystemHistory
}

const EMPTY: SystemHistory = {
  cpuPath: '',
  cpuArea: '',
  memoryPath: '',
  memoryArea: '',
  cpuLabel: '0%',
  memoryLabel: '0%',
  yTicks: [],
  xTicks: [],
  plot: { left: 40, right: 948, top: 12, bottom: 174 },
  sampleCount: 0,
}

const history = state<SystemHistory>(EMPTY)
const available = state(true)
const loading = state(true)

const plotted = derived(() => history().sampleCount > 1 && available())

async function refreshActivity(): Promise<void> {
  try {
    const response = await fetch('/api/dashboard-stats', { method: 'POST' })
    const data = await response.json() as DashboardStats
    if (!response.ok || !data.success)
      throw new Error('System activity is unavailable')

    history.set(data.systemHistory)
    available.set(true)
  }
  catch {
    available.set(false)
  }
  finally {
    loading.set(false)
  }
}

void refreshActivity()
useIntervalFn(refreshActivity, 5000)
</script>

<section class="activity-chart card" aria-labelledby="activity-heading">
  <div class="activity-header">
    <div>
      <div class="card-label">Live activity</div>
      <h2 id="activity-heading">System history</h2>
      <p class="activity-caption">Percent of capacity, sampled every 5 seconds</p>
    </div>
    <div class="activity-legend" aria-label="Current activity">
      <span><i class="cpu legend-swatch"></i>CPU <b>{{ history().cpuLabel }}</b></span>
      <span><i class="legend-swatch memory"></i>Memory <b>{{ history().memoryLabel }}</b></span>
    </div>
  </div>

  <div :if="plotted()" class="activity-plot">
    <svg viewBox="0 0 960 200" role="img" aria-label="CPU and memory usage over the recent sampling window, as a percentage">
      <defs>
        <linearGradient id="activity-fill-cpu" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-opacity=".3" />
          <stop offset="100%" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="activity-fill-memory" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-opacity=".24" />
          <stop offset="100%" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Y axis: one rule + one label per 25% step -->
      <g class="axis-y">
        <line :for="tick in history().yTicks" :key="tick.label"
          :x1="history().plot.left" :x2="history().plot.right"
          :y1="tick.offset" :y2="tick.offset" class="grid-line" />
        <text :for="tick in history().yTicks" :key="tick.label"
          :x="history().plot.left - 8" :y="tick.offset"
          x-text="tick.label" class="axis-label axis-label-y"></text>
      </g>

      <!-- X axis: elapsed time behind the newest sample -->
      <g class="axis-x">
        <line :x1="history().plot.left" :x2="history().plot.right"
          :y1="history().plot.bottom" :y2="history().plot.bottom" class="axis-line" />
        <line :for="tick in history().xTicks" :key="tick.offset"
          :x1="tick.offset" :x2="tick.offset"
          :y1="history().plot.bottom" :y2="history().plot.bottom + 4" class="axis-line" />
        <text :for="tick in history().xTicks" :key="tick.offset"
          :x="tick.offset" :y="history().plot.bottom + 17"
          x-text="tick.label" class="axis-label axis-label-x"></text>
      </g>

      <path :d="history().memoryArea" class="activity-area memory" />
      <path :d="history().cpuArea" class="activity-area cpu" />
      <path :d="history().memoryPath" class="activity-line memory" />
      <path :d="history().cpuPath" class="activity-line cpu" />
    </svg>
  </div>

  <p :if="loading()" class="activity-state">Reading this Mac...</p>
  <p :if="!loading() && history().sampleCount < 2 && available()" class="activity-state">Collecting the next sample...</p>
  <p :if="!available()" class="activity-state">Live activity is temporarily unavailable.</p>
</section>

<style>
.activity-chart { margin-bottom: var(--space-5); overflow: hidden; }
.activity-header { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-5); padding: var(--space-4) var(--space-5) var(--space-1); }
.activity-header h2 { margin: var(--space-1) 0 0; font-size: 15px; font-weight: 600; }
.activity-caption { margin: var(--space-1) 0 0; color: var(--secondary, #8e8e93); font-size: 11px; }
.activity-legend { display: flex; gap: var(--space-4); color: var(--secondary, #8e8e93); font-size: 11px; }
.activity-legend span { display: inline-flex; align-items: center; gap: var(--space-tight); }
.activity-legend b { color: var(--ink, #f5f5f7); font-weight: 600; font-variant-numeric: tabular-nums; }
.legend-swatch { width: 10px; height: 3px; border-radius: 2px; }
#activity-fill-cpu stop { stop-color: var(--accent); }
#activity-fill-memory stop { stop-color: var(--cyan); }
.legend-swatch.cpu { background: var(--accent); }
.legend-swatch.memory { background: var(--cyan); }
.activity-plot { padding: var(--space-1) var(--space-5) var(--space-4); }
.activity-plot svg { display: block; width: 100%; height: auto; }
.grid-line { stroke: color-mix(in srgb, var(--secondary, #8e8e93) 26%, transparent); stroke-width: 1; }
.axis-line { stroke: color-mix(in srgb, var(--secondary, #8e8e93) 52%, transparent); stroke-width: 1; }
.axis-label { fill: var(--secondary, #8e8e93); font-size: 10px; font-variant-numeric: tabular-nums; }
.axis-label-y { text-anchor: end; dominant-baseline: middle; }
.axis-label-x { text-anchor: middle; }
.activity-area.cpu { fill: url(#activity-fill-cpu); }
.activity-area.memory { fill: url(#activity-fill-memory); }
.activity-line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.activity-line.cpu { stroke: var(--accent); }
.activity-line.memory { stroke: var(--cyan); }
.activity-state { min-height: 180px; display: grid; place-items: center; margin: 0; color: var(--secondary, #8e8e93); font-size: 12px; }
@media (max-width: 720px) {
  .activity-header { align-items: stretch; flex-direction: column; gap: var(--space-3); }
  .activity-legend { justify-content: space-between; }
}
</style>
