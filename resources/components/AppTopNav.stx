<script server>
export const active = $props.active || ''
export const items = [
  { id: 'updates', label: 'Updates', icon: 'i-f7-arrow-down-circle-fill', href: '/app/updates' },
  { id: 'maintenance', label: 'Maintenance', icon: 'i-f7-wrench-fill', href: '/app/maintenance' },
  { id: 'privacy', label: 'Privacy', icon: 'i-f7-eye-slash-fill', href: '/app/privacy' },
  { id: 'schedule', label: 'Schedule', icon: 'i-f7-clock-fill', href: '/app/schedule' },
]
</script>

<!-- AppKit owns the window buttons; this app owns its navigation toolbar. -->
<header class="topnav" aria-label="Window toolbar">
  <nav class="toolbar-navigation flex items-center gap-1" aria-label="Page navigation">
    <button class="toolbar-button" type="button" data-toolbar-sidebar aria-label="Hide Sidebar" aria-controls="app-sidebar" aria-expanded="true" title="Hide Sidebar (⌥⌘S)">
      <span class="i-f7-sidebar-left" aria-hidden="true"></span>
    </button>
    <span class="toolbar-separator" aria-hidden="true"></span>
    <div class="flex items-center" role="group" aria-label="History">
      <button class="toolbar-button" type="button" data-toolbar-back aria-label="Back" title="Back" disabled><span class="i-f7-chevron-left" aria-hidden="true"></span></button>
      <button class="toolbar-button" type="button" data-toolbar-forward aria-label="Forward" title="Forward" disabled><span class="i-f7-chevron-right" aria-hidden="true"></span></button>
    </div>
  </nav>
  <div class="profile" data-profile>
    <button
      class="profile-chip"
      type="button"
      data-profile-chip
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls="account-menu"
      aria-label="Account and settings"
    >
      <span class="profile-avatar" aria-hidden="true">
        <span class="profile-picture" data-profile-picture><span class="i-f7-person-fill"></span></span>
        <span class="profile-dot" data-updates-dot hidden></span>
      </span>
      <span class="profile-text">
        <span class="profile-name" data-profile-name>This Mac</span>
      </span>
      <span class="profile-caret i-f7-chevron-down" aria-hidden="true"></span>
    </button>

    <div class="menu" id="account-menu" role="menu" data-profile-menu hidden>
      <div class="menu-heading" data-profile-host>This Mac</div>
      <div class="menu-rule" role="separator"></div>
      @foreach (items as item)
        <a
          class="menu-item"
          role="menuitem"
          data-topnav-item="{{ item.id }}"
          href="{{ item.href }}"
          data-stx-link
          @if(active === item.id)data-active aria-current="page"@endif
        >
          <span class="menu-icon {{ item.icon }}" aria-hidden="true"></span>
          <span class="menu-label">{{ item.label }}</span>
          @if(item.id === 'updates')
            <span class="menu-badge" data-updates-badge hidden></span>
          @endif
        </a>
      @endforeach

      <div class="menu-rule" role="separator"></div>

      <!--
        Settings opens a panel instead of navigating, which is why it is below
        the rule rather than a fifth link above it. `data-open-settings` is the
        same hook the ⌘, menu item uses; `settings-panel.ts` listens for it on
        the document.
      -->
      <button class="menu-item" type="button" role="menuitem" data-open-settings>
        <span class="menu-icon i-f7-gear-alt-fill" aria-hidden="true"></span>
        <span class="menu-label">Settings</span>
        <span class="menu-shortcut">&#8984;,</span>
      </button>
    </div>
  </div>
</header>
