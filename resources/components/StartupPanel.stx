<!-- Startup items management panel -->
<div class='card-row'>
  <!--
    Leads the row, and is absent on a tidy Mac. An entry whose program is
    gone is the only thing on this screen that can be removed without knowing
    what it does, so it gets counted first - but a card reading 0 would put a
    permanent empty slot on a machine that has nothing wrong with it.
  -->
  <div class='card' x-show='deadStartup().length > 0' x-cloak>
    <div class='card-label'>Dead</div>
    <div class='card-value' style='color: var(--red);' x-text='deadStartup().length'>0</div>
    <div class='card-detail'>Program no longer installed</div>
  </div>
  <div class='card'>
    <div class='card-label'>Active</div>
    <div class='card-value' style='color: var(--orange);'>{{ enabledStartup().length }}</div>
    <div class='card-detail'>Running at startup</div>
  </div>
  <div class='card'>
    <div class='card-label'>Disabled</div>
    <div class='card-value dim'>{{ disabledStartup().length }}</div>
    <div class='card-detail'>Not running</div>
  </div>
  <!--
    Counted by scope rather than by launchd's vocabulary, and the detail line
    comes from the items themselves. The labels used to read "User Agents" and
    "System Daemons" over "~/Library/LaunchAgents" and "/Library/LaunchDaemons",
    which say nothing true on Windows - where the same two groups are the
    registry's HKCU and HKLM keys and the two Startup folders. The page is
    prerendered, so it cannot be told which platform it is on; it can be told
    where the rows it was given came from.
  -->
  <div class='card'>
    <div class='card-label'>Yours</div>
    <div class='card-value'>{{ startupItems.filter(function(i){ return i.scope === 'user'; }).length }}</div>
    <div class='card-detail'>{{ startupSources('user') }}</div>
  </div>
  <div class='card'>
    <div class='card-label'>System-wide</div>
    <div class='card-value'>{{ startupItems.filter(function(i){ return i.scope === 'system'; }).length }}</div>
    <div class='card-detail'>{{ startupSources('system') }}</div>
  </div>
</div>

<div class='tabs'>
  <button class='tab' :class="{ active: startupFilter === 'all' }" @click="setFilter('all')">All (<span>{{ startupItems.length }}</span>)</button>
  <button class='tab' :class="{ active: startupFilter === 'enabled' }" @click="setFilter('enabled')">Enabled (<span>{{ enabledStartup().length }}</span>)</button>
  <button class='tab' x-show='deadStartup().length > 0' x-cloak :class="{ active: startupFilter === 'dead' }" @click="setFilter('dead')">Dead (<span x-text='deadStartup().length'>0</span>)</button>
  <button class='tab' :class="{ active: startupFilter === 'vendor' }" @click="setFilter('vendor')">Third-party</button>
  <button class='tab' :class="{ active: startupFilter === 'system' }" @click="setFilter('system')">Built-in</button>
</div>

<div class='tbl-wrap'>
  <div class='tbl-bar'>
    <span class='tbl-title'>Startup Items</span>
    <!--
      The one bulk action this screen can offer. "Disable Selected" sat here
      permanently hidden because there is no safe way to sweep a list where
      most rows might be load-bearing; a dead entry has no such problem, so
      this sweeps exactly those and nothing else. The server re-derives the
      set from a fresh scan, so this button cannot delete anything live even
      if the list it was rendered from is stale.
    -->
    <div style='display: flex; gap: var(--space-tight);'>
      <button class='btn btn-danger btn-sm' x-cloak x-show='deadStartup().length > 0'
        @click="doRemoveDead(deadPaths(), deadIds(), deadStartup().map(function(i){ return i.name; }))">
        Delete Dead (<span x-text='deadStartup().length'>0</span>)
      </button>
    </div>
  </div>
  <table>
    <thead>
      <tr>
        <th style='width: 28px;'><input type="checkbox" class="check" @click="allOn(enabledIds())" /></th>
        <th>Name</th>
        <th>Scope</th>
        <th>Status</th>
        <th>Run at Load</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <template x-for="item in startupItems" :key="item.id">
        <tr x-show="!isRemoved(item.id) && rowVisible(item)" :data-item-id="item.id">
          <td><input type="checkbox" class="check" :checked="isOn(item.id)" @click="toggle(item.id)" /></td>
          <td>
            <div class='item-row'><span class='item-glyph' :class="item.icon" aria-hidden="true"></span><span class='item-name' x-text="item.name"></span></div>
            <!--
              A dead row shows the path it cannot find instead of the vendor.
              "Delete this, it is safe" is not a claim to make without showing
              the evidence, and the vendor is the one thing already obvious
              from the name beside it.
            -->
            <div class='item-sub' x-show='!item.targetMissing' x-text="item.vendor"></div>
            <div class='item-sub item-sub-dead' x-show='item.targetMissing' x-cloak x-text="item.program"></div>
          </td>
          <td>
            <span class='badge badge-green' x-show="item.scope === 'user'">User</span>
            <span class='badge badge-orange' x-show="item.scope !== 'user'" x-cloak>System</span>
          </td>
          <td>
            <span x-show="!isDisabled(item.id) && !item.targetMissing" class="badge badge-green">Active</span>
            <span x-show="isDisabled(item.id) && !item.targetMissing" x-cloak class="badge badge-gray">Disabled</span>
            <span x-show="item.targetMissing" x-cloak class="badge badge-red" title="launchd cannot run this - the program it points at is gone">Dead</span>
          </td>
          <td>
            <span x-show='item.runAtLoad' class='i-f7-checkmark-alt run-at-load' aria-label='Runs at login'></span>
            <span x-show='!item.runAtLoad' x-cloak class='dim'>-</span>
          </td>
          <td>
            <span x-show="item.category === 'system'" class='dim' style='font-size: 10px;'>Apple</span>
            <div x-show="item.category !== 'system'" style='display: flex; gap: var(--space-1);' x-cloak>
              <button x-show="!isDisabled(item.id)" class="btn btn-sm" @click="doToggle(item.filepath, item.name, 'disable', item.id)">Disable</button>
              <button x-show="isDisabled(item.id)" x-cloak class="btn btn-sm" @click="doToggle(item.filepath, item.name, 'enable', item.id)">Enable</button>
              <button class='btn btn-danger btn-sm' @click="doRemove(item.filepath, item.name, item.id)">Delete</button>
            </div>
            <span x-show="isRemoved(item.id)" x-cloak class="badge badge-gray">Removed</span>
          </td>
        </tr>
      </template>
    </tbody>
  </table>
</div>
