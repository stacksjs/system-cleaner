<script server>
// The tour shows the app as it opens: the overview, then two of the section
// pages it leads to. Section pages wear the same colours in light and dark
// mode, so each view needs one image rather than a pair.
export const lead = {
  name: 'Overview',
  copy: 'A health score and one card per section: junk you can clean, free space, login items, pending updates and browsing traces. One look tells you where to go next.',
  image: 'overview',
  href: '/app',
}

export const pair = [
  {
    name: 'Cleanup',
    copy: 'How much junk is safe to remove, the tools that remove it, and a record of what you have already reclaimed.',
    image: 'cleanup',
    href: '/app/clean',
  },
  {
    name: 'Storage',
    copy: 'Free space at a glance, the quickest wins, and the tools that find large files, duplicates and similar photos.',
    image: 'storage',
    href: '/app/storage',
  },
]
</script>

<section id="app-tour" class="app-tour section" aria-labelledby="app-tour-title">
  <div class="site-container">
    <div class="section-heading">
      <h2 id="app-tour-title">Six sections. One window.</h2>
      <p class="section-intro">Each section opens on what matters right now, with its tools one click away. Every scan stays on your Mac.</p>
    </div>

    <div class="tour-lead">
      <figure class="app-window">
        <figcaption class="app-window-bar">
          <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>{{ lead.name }}</span>
        </figcaption>
        <picture>
          <img src="/images/showcase/{{ lead.image }}.jpg" width="1400" height="900" loading="lazy" alt="SystemCleaner {{ lead.name }}: a health score and one card for each section" />
        </picture>
      </figure>
      <div class="tour-lead-copy">
        <h3>{{ lead.name }}</h3>
        <div>
          <p>{{ lead.copy }}</p>
          <a class="tour-link" href="{{ lead.href }}" data-stx-link>Open {{ lead.name }} <span class="i-f7-arrow-right" aria-hidden="true"></span></a>
        </div>
      </div>
    </div>

    <div class="tour-pair">
      @foreach (pair as view)
        <article class="tour-card">
          <figure class="app-window">
            <figcaption class="app-window-bar">
              <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>{{ view.name }}</span>
            </figcaption>
            <picture>
                  <img src="/images/showcase/{{ view.image }}.jpg" width="1400" height="900" loading="lazy" alt="SystemCleaner {{ view.name }} section page" />
            </picture>
          </figure>
          <div>
            <h3>{{ view.name }}</h3>
            <p>{{ view.copy }}</p>
            <a class="tour-link" href="{{ view.href }}" data-stx-link>Open {{ view.name }} <span class="i-f7-arrow-right" aria-hidden="true"></span></a>
          </div>
        </article>
      @endforeach
    </div>
  </div>
</section>
