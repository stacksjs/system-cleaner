<!-- Quick Clean panel -->
<div class='card-row'>
  <div class='card' style='grid-column: span 2;'>
    <div class='card-label'>Space Recoverable</div>
    <!-- Turns green only once there is a real figure. Green on "Scanning…"
         reads as a result, which it is not. -->
    <div class='card-value clean-total is-scanning' id='total-cleanable'>Scanning&hellip;</div>
    <div class='card-detail'><span id='cleanup-visible-count'>{{ cleanCategories.length }}</span> cleanable categories found</div>
  </div>
  <div class='card'>
    <div class='card-label'>Disk Free</div>
    <div class='card-value'>{{ diskAvail }}</div>
    <div class='card-detail'><span>{{ diskPercent }}</span>% used</div>
  </div>
</div>

<div x-show='cleanCategories.length > 0'>
  <!-- Category filter. The list runs to eighty-odd rows on a working developer
       machine, which is too many to read as one column. Filtering hides rows
       rather than re-rendering them, because the size cells and the size sort
       are written into the DOM by scanCleanupSizes and a re-render throws both
       away. -->
  <div class='filter-row'>
    <button class='btn btn-sm' :class="filter === 'all' ? 'btn-active' : ''" @click="setFilter('all')">All</button>
    <template x-for='c in categoriesPresent()' :key='c'>
      <button class='btn btn-sm cap' :class="filter === c ? 'btn-active' : ''" @click='setFilter(c)' x-text='c'></button>
    </template>
  </div>

  <div style='display: flex; gap: 8px; margin-bottom: 16px; align-items: center; flex-wrap: wrap;'>
    <button class='btn' @click='toggleAllSafe()'>
      <span x-text="allSafeSelected() ? 'Deselect All' : 'Select All Safe'">Select All Safe</span>
    </button>
    <button class='btn btn-danger' x-cloak x-show='selected.length > 0' onclick='doCleanSelected()'>
      Clean Selected (<span x-text='selected.length'>0</span>)
    </button>
    <button class='btn btn-danger btn-icon' onclick='doEmptyTrash()'>
      <span class='i-f7-trash-fill' aria-hidden='true'></span>
      Empty Trash
    </button>
    <button class='btn btn-icon btn-sm' data-rescan style='margin-left: auto;' onclick='scanCleanupSizes(true)'>
      <span class='i-f7-arrow-clockwise' aria-hidden='true'></span>
      Rescan
    </button>
  </div>

  <div class='tbl-wrap'>
    <div class='tbl-bar'>
      <div>
        <span class='tbl-title'>Cleanable Items</span>
        <span class='tbl-count' id='cleanup-sort-label'>scanning sizes...</span>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th style='width: 28px;'><input type='checkbox' class='check' @click='toggleAllSafe()' /></th>
          <th>Category</th>
          <th>Size</th>
          <th>Path</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id='cleanup-tbody'>
        <template x-for="cat in cleanCategories" :key="cat.id">
          <tr :data-clean-id="cat.id" :data-clean-path="cat.path" :data-clean-category="cat.category" :data-clean-risk="cat.risk">
            <td><input type='checkbox' class='check' :checked="isOn(cat.id)" @click="toggle(cat.id)" /></td>
            <td>
              <div class='item-row'>
                <span class='item-glyph' :class="cat.icon" aria-hidden='true'></span>
                <span class='item-name' x-text='cat.name'></span>
                <!-- Session transcripts and downloaded models are the biggest
                     entries here and the only ones nothing rebuilds. Say so on
                     the row, not just in the confirm dialog. -->
                <span class='badge badge-orange' x-show="cat.risk === 'caution'">not rebuilt</span>
              </div>
              <div class='item-sub'>{{ cat.desc }}</div>
            </td>
            <td class='clean-size is-pending'>&mdash;</td>
            <td><div class="item-path" :title="cat.path">{{ shortPath(cat.path) }}</div></td>
            <td>
              <!-- Neutral, deliberately. Thirty-nine red buttons in a column
                   stop reading as danger by about the twentieth; the colour is
                   spent on the two actions below that genuinely warrant it. -->
              <button class='btn btn-sm'
                :disabled="cleaning[cat.id]"
                onclick="doCleanDir(this.closest('tr').getAttribute('data-clean-path'), this.closest('tr').querySelector('.item-name').textContent, this.closest('tr').getAttribute('data-clean-id'), this.closest('tr').getAttribute('data-clean-risk'))">
                <span x-show="!cleaning[cat.id]">Clean</span>
                <span x-show="cleaning[cat.id]">...</span>
              </button>
            </td>
          </tr>
        </template>
      </tbody>
    </table>
  </div>

  <div style='margin-top: 12px; padding: 12px 16px; background: var(--surface-soft); border-radius: 8px; border: 0.5px solid var(--line); font-size: 11px; color: var(--tertiary);'>
    Cleaning removes contents inside each directory. Some apps may rebuild caches on next launch. Rows marked <span class='badge badge-orange'>not rebuilt</span> hold real content &mdash; session transcripts, downloaded models &mdash; so <strong style='color: #98989d;'>Select All Safe</strong> leaves them for you to tick yourself. Some directories sit inside others; the total above counts the overlap once. Click <strong style='color: #98989d;'>Rescan</strong> after cleaning to see updated sizes.
  </div>
</div>

<div x-show='!targetsLoading && cleanCategories.length === 0' x-cloak>
  <div class='tbl-wrap'>
    <div class='empty-state'>Your system is clean! No cache directories found.</div>
  </div>
</div>
