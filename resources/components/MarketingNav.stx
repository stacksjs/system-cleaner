<script server>
import { FEATURES } from '~/app/Support/Marketing/catalog'
import { USE_CASES } from '~/app/Support/Marketing/use-cases'
import { DOWNLOAD_URL, SOURCE_URL } from '~/app/Support/Marketing/distribution'

export const features = FEATURES
export const useCases = USE_CASES
export const downloadUrl = DOWNLOAD_URL
export const sourceUrl = SOURCE_URL
</script>

<script client>
// Same dismissal contract as the mega panel: the sheet has to close when the
// route changes, otherwise tapping a link on a phone leaves the overlay
// covering the page it just loaded.
const sheetOpen = state(false)

function closeSheet(): void {
  sheetOpen.set(false)
}

function toggleSheet(): void {
  sheetOpen.update(value => !value)
}

useEventListener('stx:navigate', closeSheet)
useEventListener('stx:load', closeSheet)

useEventListener('keydown', (event) => {
  if ((event as KeyboardEvent).key === 'Escape')
    closeSheet()
})
</script>

<header class="site-nav-wrap">
  <nav class="site-container site-nav" aria-label="Primary navigation">
    <a class="brand" href="/" data-stx-link aria-label="SystemCleaner home">
      <BrandMark :size="32" />
      <span>SystemCleaner</span>
    </a>

    <div class="desktop-nav">
      <MegaMenu />
      <a class="nav-link" href="/privacy" data-stx-link>Privacy</a>
    </div>

    <div class="nav-actions">
      <a class="button button-secondary" href="{{ sourceUrl }}" rel="noreferrer">
        <span class="h-4 w-4 i-f7-logo-github" aria-hidden="true"></span>
        View source
      </a>
      <a class="button button-primary" href="{{ downloadUrl }}" rel="noreferrer">
        <span class="h-4 w-4 i-f7-cloud-download-fill" aria-hidden="true"></span>
        Download
      </a>
    </div>

    <button
      type="button"
      class="nav-burger"
      aria-controls="mobile-sheet"
      :aria-expanded="sheetOpen() ? 'true' : 'false'"
      @click="toggleSheet()"
    >
      <span class="h-5 w-5" :class="sheetOpen() ? 'i-f7-xmark' : 'i-f7-line-horizontal-3'" aria-hidden="true"></span>
      <span class="nav-burger-label">Menu</span>
    </button>
  </nav>

  <div class="mobile-sheet" id="mobile-sheet" :data-open="sheetOpen() ? 'true' : 'false'" :aria-hidden="sheetOpen() ? 'false' : 'true'">
    <div class="mobile-sheet-inner site-container">
      <p class="mobile-sheet-label">Features</p>
      <div class="mobile-links">
        @foreach (features as feature)
          <a class="nav-link" href="/features/{{ feature.slug }}" data-stx-link @click="closeSheet()">{{ feature.shortName }}</a>
        @endforeach
      </div>
      <p class="mobile-sheet-label mobile-sheet-label-spaced">Use cases</p>
      <div class="mobile-links">
        @foreach (useCases as useCase)
          <a class="nav-link" href="/use-cases/{{ useCase.slug }}" data-stx-link @click="closeSheet()">{{ useCase.shortName }}</a>
        @endforeach
      </div>
      <div class="mobile-links mobile-links-wide">
        <a class="nav-link" href="/features" data-stx-link @click="closeSheet()">All features</a>
        <a class="nav-link" href="/use-cases" data-stx-link @click="closeSheet()">All use cases</a>
        <a class="nav-link" href="/privacy" data-stx-link @click="closeSheet()">Privacy</a>
      </div>
      <div class="mobile-actions">
        <a class="button button-secondary" href="{{ sourceUrl }}" rel="noreferrer">
          <span class="h-4 w-4 i-f7-logo-github" aria-hidden="true"></span>
          View source
        </a>
        <a class="button button-primary" href="{{ downloadUrl }}" rel="noreferrer">
          <span class="h-4 w-4 i-f7-cloud-download-fill" aria-hidden="true"></span>
          Download
        </a>
      </div>
    </div>
  </div>
</header>
