<script server>
import { featureBySlug, sectionOf } from '~/app/Support/Marketing/catalog'
import { USE_CASES, useCaseBySlug } from '~/app/Support/Marketing/use-cases'

const useCase = useCaseBySlug($props.slug) || USE_CASES[0]

// Numbered in the template, so the step index has to survive into the markup.
export const steps = useCase.workflow.map((step, index) => ({
  ...step,
  index: String(index + 1).padStart(2, '0'),
}))

// A use case names feature slugs; anything unresolvable is dropped rather
// than rendered as a dead link.
export const relatedFeatures = useCase.features
  .map(slug => featureBySlug(slug))
  .filter(Boolean)
  .map(feature => ({ ...feature, sectionLabel: sectionOf(feature).label }))

export const related = USE_CASES.filter(item => item.slug !== useCase.slug)
export const reclaims = useCase.reclaims
export const name = useCase.name
export const headline = useCase.headline
export const description = useCase.description
export const icon = `i-f7-${useCase.icon}`
export const tone = useCase.tone
export const metric = useCase.metric
export const detail = useCase.detail
</script>

<MarketingPageHero
  :tone="tone"
  :icon="icon"
  crumb="Use cases"
  crumbHref="/use-cases"
  crumbIcon="i-f7-person-2-fill"
  :title="headline"
  :lede="description"
  secondaryHref="/use-cases"
  secondaryLabel="All use cases"
/>

<article class="site-container" data-tone="{{ tone }}">

  <section class="detail" aria-labelledby="use-case-fit-title">
    <div>
      <h2 id="use-case-fit-title">What a pass looks like</h2>
      <ol class="usecase-steps">
        @foreach (steps as step)
          <li>
            <span class="usecase-step-index">{{ step.index }}</span>
            <div>
              <strong>{{ step.title }}</strong>
              <p>{{ step.body }}</p>
            </div>
          </li>
        @endforeach
      </ol>
    </div>
    <aside class="fact">
      <span class="tone-tile tone-tile-lg"><span class="{{ icon }}" aria-hidden="true"></span></span>
      <strong>{{ metric }}</strong>
      <span>{{ detail }}</span>
    </aside>
  </section>

  <section class="where" aria-labelledby="use-case-reclaim-title">
    <h2 id="use-case-reclaim-title" class="sub-title">What SystemCleaner finds for you</h2>
    <p class="section-intro">The app sizes each of these on your Mac before you decide anything, and removes only what you select.</p>
    <div class="reclaim-grid">
      @foreach (reclaims as group)
        <div class="reclaim-card">
          <h3>{{ group.title }}</h3>
          <ul>
            @foreach (group.items as item)
              <li>
                <span class="i-f7-checkmark-alt reclaim-tick" aria-hidden="true"></span>
                <span>{{ item }}</span>
              </li>
            @endforeach
          </ul>
        </div>
      @endforeach
    </div>
  </section>

  <section class="more" aria-labelledby="use-case-features-title">
    <h2 id="use-case-features-title" class="sub-title">The tools this leans on</h2>
    <ul class="card-list">
      @foreach (relatedFeatures as feature)
        <li>
          <a href="/features/{{ feature.slug }}" data-stx-link data-tone="{{ feature.section }}">
            <span class="tone-tile tone-tile-lg"><span class="i-f7-{{ feature.icon }}" aria-hidden="true"></span></span>
            <span>
              <strong>{{ feature.name }}</strong>
              <small>{{ feature.sectionLabel }}: {{ feature.summary }}</small>
            </span>
            <span class="arrow i-f7-arrow-right" aria-hidden="true"></span>
          </a>
        </li>
      @endforeach
    </ul>
  </section>

  <section class="more" aria-labelledby="more-use-cases-title">
    <h2 id="more-use-cases-title" class="sub-title">Other ways people use it</h2>
    <ul class="card-list">
      @foreach (related as item)
        <li>
          <a href="/use-cases/{{ item.slug }}" data-stx-link data-tone="{{ item.tone }}">
            <span class="tone-tile tone-tile-lg"><span class="i-f7-{{ item.icon }}" aria-hidden="true"></span></span>
            <span>
              <strong>{{ item.name }}</strong>
              <small>{{ item.summary }}</small>
            </span>
            <span class="arrow i-f7-arrow-right" aria-hidden="true"></span>
          </a>
        </li>
      @endforeach
    </ul>
  </section>
</article>

<MarketingDownload />
