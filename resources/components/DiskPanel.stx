<!--
  DiskScope — sunburst disk usage analyzer.

  The SVG path math (segment arcs) stays imperative — declarative templating
  doesn't help when generating hundreds of computed `<path d="...">` strings.
  Everything else (folder sidebar, scan totals, inspector card) is bound
  reactively, and the imperative scan code talks to the scope via _exec().
-->
<!--
  Volume figures come from `/api/system-disk-info` at runtime, not from a
  `<script server>` block. The packaged app ships prerendered HTML, so anything
  a server script computed would be frozen at build time — here it rendered as
  nothing at all, leaving "Macintosh HD / total" and "used / free" with no
  numbers beside them.
-->
<div class='disk-layout'
  x-data="{
  scanInfo: null,
  scanTotalLabel: '',
  rootName: '',
  drilled: false,
  crumbs: [],
  defaultSize: '',
  defaultName: '',
  volumeTotal: '-',
  volumeUsed: '-',
  volumeFree: '-',
  volumePct: 0,
  init() {
    var self = this;
    fetch('/api/system-disk-info', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.success) return;
        self.volumeTotal = d.fDiskTotal;
        self.volumeUsed = d.fDiskUsed;
        self.volumeFree = d.fDiskFree;
        self.volumePct = d.diskPct;
        if (!self.hasResults && self.scanState === 'idle') self.rootName = self.defaultName = d.homeName || '';
      })
      .catch(function() {});
    queueMicrotask(function() { typeof diskPanelMount === 'function' && diskPanelMount(); });
  },
  topItems: [],
  hovered: null,
  scanState: 'idle',
  scanId: '',
  scanStatus: '',
  cancelling: false,
  hasResults: false,
  scanError: '',
  scanProgress: '',
  scanProgressPath: '',
  scanProgressFullPath: '',
  scanStalled: false,
  centerSize() { return this.hovered ? this.hovered.formattedSize : this.defaultSize; },
  centerName() { return this.hovered ? this.hovered.name : this.defaultName; },
  metaText() {
    if (this.scanState === 'scanning') return this.scanProgress || 'Scanning disk…';
    if (this.scanState === 'cancelled') return 'Scan cancelled · ' + this.scanProgress;
    if (this.scanState === 'error') return this.scanError || 'Scan failed';
    if (this.scanInfo) return Number(this.scanInfo.folderCount || 0).toLocaleString() + ' folders · took ' + this.scanInfo.scanTime + (this.scanInfo.truncated ? ' · partial' : '') + (this.scanInfo.cached ? ' · from the last scan' : '');
    return 'Scan your home folder to see what fills it.';
  },
  unmeasuredNote() {
    var n = this.scanInfo ? (this.scanInfo.unmeasured || 0) : 0;
    if (this.scanState === 'cancelled') return 'Scan cancelled. The chart keeps everything measured before cancellation.';
    if (!n) return 'This scan ran out of time before it finished. Everything shown here was measured exactly.';
    return 'This scan ran out of time with ' + n + (n === 1 ? ' folder' : ' folders') + ' still unmeasured, so the total is lower than the real one. Everything shown here was measured exactly.';
  },
  unreadableNote() {
    var n = this.scanInfo ? (this.scanInfo.unreadable || 0) : 0;
    return 'macOS kept SystemCleaner out of ' + n.toLocaleString() + (n === 1 ? ' folder' : ' folders') + ', so what is inside is not counted. Full Disk Access lets it read them.';
  },
}">

  <!-- Disk sidebar -->
  <div class='disk-sidebar'>
    <div class='disk-sidebar-section'>
      <div class='disk-card'>
        <div class='disk-card-head'>
          <span class='disk-card-icon' aria-hidden='true'><span class='i-f7-floppy-disk'></span></span>
          <div>
            <div class='disk-card-name'>Startup disk</div>
            <div class='disk-card-sub' x-text="volumeTotal + ' total'">- total</div>
          </div>
        </div>
        <div class='disk-usage-bar'>
          <div class='disk-usage-fill'
               :class="volumePct >= 95 ? 'is-critical' : (volumePct >= 85 ? 'is-tight' : '')"
               :style="'width: ' + volumePct + '%'"></div>
        </div>
        <div class='disk-usage-text'>
          <span x-text="volumeUsed + ' used'">- used</span>
          <span x-text="volumeFree + ' free'">- free</span>
        </div>
      </div>
    </div>

    <div class='disk-sidebar-section'>
      <div class='disk-section-label' x-text="drilled ? rootName : 'Home folder'">Home folder</div>
      <div class='disk-total' x-text="scanTotalLabel">-</div>
      <div class='disk-meta' x-text="metaText()">Scan your home folder to see what fills it.</div>
      <button class='mt-3 btn btn-sm' data-cancel-scan x-show="scanState === 'scanning'" x-cloak
        @click='cancelDiskScan()' :disabled='cancelling || !scanId' x-text="cancelling ? 'Cancelling…' : 'Cancel scan'">Cancel scan</button>
      <button class='mt-3 btn btn-sm' x-show="scanState !== 'scanning' && hasResults" x-cloak @click='startDiskScan()'>Scan again</button>
    </div>

    <!-- A scan that ran out of time is a real answer, but only if it says so:
         52 GB of a 490 GB disk looks like the whole picture otherwise. It now
         also says how many folders it never got to, because "partial" without
         a number is impossible to weigh. -->
    <div class='disk-notice-wrap' x-show='scanInfo && scanInfo.truncated' x-cloak>
      <div class='disk-notice' x-text='unmeasuredNote()'></div>
    </div>

    <!-- Unreadable folders are a permission problem, not a scan problem, and
         the fix is somewhere else entirely, so the notice carries the way
         there. -->
    <div class='disk-notice-wrap' x-show='scanInfo && scanInfo.unreadable > 0' x-cloak>
      <div class='disk-notice'>
        <span x-text='unreadableNote()'></span>
        <button type='button' class='btn btn-sm disk-notice-action' @click="fetch('/api/open-privacy-settings', { method: 'POST' })">Open Privacy &amp; Security</button>
      </div>
    </div>

    <div class='disk-list-head disk-sidebar-section'>
      <div class='disk-section-label'>Largest items</div>
    </div>
    <!-- Pointing at a row shows it in the inspector and keeps it there, the
         same rule the chart follows, so the inspector's buttons stay
         reachable; clicking a folder opens it in the chart. -->
    <div class='folder-list'>
      <template x-for="item in topItems" :key="item.idx">
        <button type='button' class="folder-item"
            @mouseover="diskHover(item.idx)"
            @focus="diskHover(item.idx)"
            @click="diskOpen(item.idx)">
          <span class="folder-dot" :style="'background:' + item.color"></span>
          <span class="folder-name">{{ item.name }}</span>
          <span class="folder-size">{{ item.formattedSize }}</span>
          <span class="folder-bar-track">
            <span class="folder-bar-fill" :style="'width:' + item.barPct + '%;background:' + item.color"></span>
          </span>
        </button>
      </template>
    </div>
  </div>

  <!-- Sunburst chart -->
  <div class='disk-chart'>
    <nav class='disk-crumbs' aria-label='Folder path' x-show="hasResults && crumbs.length > 1" x-cloak>
      <template x-for="crumb in crumbs" :key="crumb.level">
        <span class='disk-crumb'>
          <button type='button' class='disk-crumb-link' :disabled='crumb.last' :aria-current="crumb.last ? 'page' : null" @click='diskUpTo(crumb.level)'>{{ crumb.name }}</button>
          <span class='disk-crumb-sep i-f7-chevron-right' aria-hidden='true' x-show='!crumb.last'></span>
        </span>
      </template>
    </nav>
    <div class='disk-live-status' aria-description='The chart shows folders measured so far.' x-show="scanState === 'scanning' && hasResults" x-cloak>
      <div class='flex gap-2 items-center min-w-0'>
        <span class='disk-live-indicator i-f7-arrow-2-circlepath' aria-hidden='true'></span>
        <span class='disk-live-heading' role='status' x-text="cancelling ? 'Cancelling scan…' : (scanStatus === 'queued' ? 'Scan queued' : 'Scanning disk')">Scanning disk</span>
        <span class='disk-live-metrics' x-text='scanProgress'></span>
      </div>
      <div class='disk-live-path' x-text='scanProgressPath' :title='scanProgressFullPath'></div>
    </div>

    <div id='disk-loading' x-show="!hasResults || scanState === 'error'" style='position: relative; z-index: 1; text-align: center; color: var(--tertiary); font-size: 13px;'>
      <div class='disk-empty-glyph' :class="scanState === 'scanning' ? 'is-scanning' : ''">
        <span class='i-f7-chart-pie-fill' aria-hidden='true'></span>
      </div>
      <div x-show="scanState === 'cancelled'" role='status' x-cloak>
        <div>Scan cancelled. No folders had finished measuring yet.</div>
        <button class='mt-3 btn' @click='startDiskScan()'>Scan Again</button>
      </div>
      <div x-show="scanState === 'idle'">
        <div style='margin-bottom: var(--space-3);'>Analyze disk usage with an interactive sunburst chart</div>
        <button class='btn' onclick='startDiskScan()' style='padding: var(--space-2) var(--space-5); font-size: 13px;'>Scan Disk</button>
        <div style='margin-top: var(--space-2); font-size: 10px; color: var(--tertiary);'>Results are cached for 10 minutes</div>
      </div>
      <div x-show="scanState === 'scanning'">
        <div>Scanning disk&hellip;</div>
        <!-- The count and the current directory are what distinguish a slow
             scan from a hung one. Both come from /api/scan-progress. -->
        <div style='margin-top: var(--space-2); font-size: 12px; font-variant-numeric: tabular-nums; color: var(--ink);'
             x-show='scanProgress' x-text='scanProgress'></div>
        <div class='scan-path' x-show='scanProgressPath' x-text='scanProgressPath'></div>
        <div style='margin-top: var(--space-2); font-size: 10px; color: var(--tertiary);' x-show='!scanStalled'>Measuring every folder on a large home directory takes a minute or two. The total on the left climbs as it goes.</div>
        <!-- A quiet counter alone cannot identify a permission failure. -->
        <div class='scan-blocked' x-show='scanStalled' x-cloak>
          <strong>Still measuring this folder.</strong> Large folders can take longer. If macOS shows a permission prompt, answer it to continue.
        </div>
      </div>
      <!-- A failed scan used to drop straight back to the idle state, so the
           button simply reappeared and the user was left to guess. -->
      <div x-show="scanState === 'error'" x-cloak>
        <div style='margin-bottom: var(--space-2); color: var(--red); font-weight: 600;'>Scan failed</div>
        <div style='margin-bottom: var(--space-3); max-width: 42ch; color: var(--secondary);' x-text='scanError'></div>
        <button class='btn' onclick='startDiskScan()' style='padding: var(--space-2) var(--space-5); font-size: 13px;'>Try Again</button>
      </div>
    </div>
    <svg class='sunburst-svg' id='sunburst' viewBox='-320 -320 640 640' x-show="hasResults && scanState !== 'error'" x-cloak>
      <circle cx='0' cy='0' r='115' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <circle cx='0' cy='0' r='170' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <circle cx='0' cy='0' r='225' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <g id='segments-group'></g>
      <circle cx='0' cy='0' r='57' class='center-bg' />
      <circle cx='0' cy='0' r='57' class='center-ring' />
      <text x='0' y='-5' class='center-text-size' x-text="centerSize()"></text>
      <text x='0' y='12' class='center-text-name' x-text="centerName()"></text>
      <text x='0' y='26' class='center-back' id='center-back'>Back</text>
    </svg>
  </div>

  <!-- Inspector -->
  <div class='disk-inspector'>
    <div class='inspector-title'>Details</div>
    <div class='inspector-body'>
      <div class='inspector-placeholder' x-show="!hovered">
        <span class='inspector-placeholder-mark' aria-hidden='true'><span class='i-f7-chart-pie-fill'></span></span>
        <div>Point at a ring or a folder in the list to see what it holds.</div>
      </div>
      <template x-if="hovered">
        <div class="info-card">
          <div class="info-icon-row">
            <div class="info-type-icon" :style="'background:' + hovered.color + '24;color:' + hovered.color">
              <span :class="hovered.isDir ? 'i-f7-folder-fill' : 'i-f7-doc-fill'" aria-hidden="true"></span>
            </div>
            <div class="min-w-0">
              <div class="info-type-name">{{ hovered.name }}</div>
              <div class="info-type-kind">{{ (hovered.isDir ? 'Folder' : 'File') + ' in ' + rootName }}</div>
            </div>
          </div>
          <div class="info-row"><span class="info-label">Size</span><span class="info-value">{{ hovered.formattedSize }}</span></div>
          <div class="info-row"><span class="info-label">{{ 'Share of ' + rootName }}</span><span class="info-value">{{ hovered.percent + '%' }}</span></div>
          <template x-if="hovered.isDir">
            <div class="info-row"><span class="info-label">Items inside</span><span class="info-value">{{ hovered.childCount }}</span></div>
          </template>
          <div class="info-bar">
            <div class="info-bar-track"><div class="info-bar-fill" :style="'width:' + hovered.percent + '%;background:' + hovered.color"></div></div>
            <div class="info-bar-text">{{ hovered.formattedSize + ' of ' + defaultSize }}</div>
          </div>
          <div class="info-path" x-show="hovered.fullPath">{{ hovered.fullPath }}</div>
          <div class="info-actions" x-show="hovered.fullPath && !hovered.aggregate">
            <button class="btn btn-accent btn-sm" x-show="hovered.isDir && hovered.childCount > 0" @click="diskOpen(hovered.idx)">Open folder</button>
            <button class="btn btn-sm" @click="diskRevealInFinder(hovered.fullPath)">Reveal in Finder</button>
          </div>
          <!-- The one destructive action, set apart from the two that only
               look, and labelled with what it costs. It asks first. -->
          <div class="info-danger" x-show="hovered.fullPath && !hovered.aggregate && hovered.isDir && hovered.depth >= 1">
            <button class="btn btn-danger btn-sm"
                    :disabled="scanState === 'scanning'"
                    @click="diskDeletePath(hovered.fullPath, hovered.name, hovered.size)">{{ 'Delete ' + hovered.formattedSize + '…' }}</button>
          </div>
        </div>
      </template>
    </div>
  </div>

</div>

<style>
@keyframes pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }
.disk-empty-glyph { margin-bottom: var(--space-4); color: var(--tertiary); }
.disk-empty-glyph span { display: inline-block; width: 30px; height: 30px; }
.disk-empty-glyph.is-scanning { animation: pulse 1.5s ease-in-out infinite; }
.scan-blocked { margin: var(--space-3) auto 0; max-width: 42ch; padding: var(--space-2) var(--space-3); border: .5px solid color-mix(in srgb, var(--orange) 32%, transparent); border-radius: 6px; background: color-mix(in srgb, var(--orange) 10%, var(--surface)); color: var(--secondary); font-size: 11px; line-height: 1.5; }
.scan-blocked strong { display: block; margin-bottom: var(--space-half); color: var(--ink); }
/* Centred like everything else in this column: a max-width block with no auto
   margin sits left, which read as misaligned against the text above it. */
.scan-path { margin: var(--space-1) auto 0; max-width: 46ch; overflow: hidden; color: var(--tertiary); font: 10px/1.5 'SF Mono', Menlo, monospace; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
@media (prefers-reduced-motion: reduce) { .disk-empty-glyph.is-scanning { animation: none; } }
</style>
