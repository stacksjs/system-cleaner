<!--
  DiskScope — sunburst disk usage analyzer.

  The SVG path math (segment arcs) stays imperative — declarative templating
  doesn't help when generating hundreds of computed `<path d="...">` strings.
  Everything else (folder sidebar, scan totals, inspector card) is bound
  reactively, and the imperative scan code talks to the scope via _exec().
-->
<!--
  Volume figures come from `/api/system-disk-info` at runtime, not from a
  `<script server>` block. The packaged app ships prerendered HTML, so anything
  a server script computed would be frozen at build time — here it rendered as
  nothing at all, leaving "Macintosh HD / total" and "used / free" with no
  numbers beside them.
-->
<div class='disk-layout'
  x-data="{
  scanInfo: null,
  scanTotalLabel: '',
  rootName: '',
  drilled: false,
  defaultSize: '',
  defaultName: '',
  volumeTotal: '-',
  volumeUsed: '-',
  volumeFree: '-',
  volumePct: 0,
  init() {
    var self = this;
    fetch('/api/system-disk-info', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (!d.success) return;
        self.volumeTotal = d.fDiskTotal;
        self.volumeUsed = d.fDiskUsed;
        self.volumeFree = d.fDiskFree;
        self.volumePct = d.diskPct;
        self.scanTotalLabel = self.defaultSize = d.fDiskUsed;
        self.rootName = self.defaultName = d.homeName || '';
      })
      .catch(function() {});
    queueMicrotask(function() { typeof diskPanelMount === 'function' && diskPanelMount(); });
  },
  topItems: [],
  hovered: null,
  scanState: 'idle',
  scanError: '',
  scanProgress: '',
  scanProgressPath: '',
  scanStalled: false,
  centerSize() { return this.hovered ? this.hovered.formattedSize : this.defaultSize; },
  centerName() { return this.hovered ? this.hovered.name : this.defaultName; },
  metaText() {
    if (this.scanState === 'scanning') return this.scanProgress || 'Scanning disk…';
    if (this.scanState === 'error') return this.scanError || 'Scan failed';
    if (this.scanInfo) return this.scanInfo.folderCount + ' folders · ' + this.scanInfo.scanTime + (this.scanInfo.truncated ? ' · partial' : '') + (this.scanInfo.cached ? ' (cached)' : '');
    return 'Click Scan Disk to analyze';
  },
  unmeasuredNote() {
    var n = this.scanInfo ? (this.scanInfo.unmeasured || 0) : 0;
    if (!n) return 'This scan ran out of time before it finished. Everything shown here was measured exactly.';
    return 'This scan ran out of time with ' + n + (n === 1 ? ' folder' : ' folders') + ' still unmeasured, so the total is lower than the real one. Everything shown here was measured exactly.';
  },
  unreadableNote() {
    var n = this.scanInfo ? (this.scanInfo.unreadable || 0) : 0;
    return 'macOS would not let SystemCleaner read ' + n + (n === 1 ? ' folder' : ' folders') + ', so what is inside them is missing from these numbers. Grant Full Disk Access in System Settings › Privacy & Security to include them.';
  },
}">

  <!-- Disk sidebar -->
  <div class='disk-sidebar'>
    <div class='disk-sidebar-section'>
      <div class='disk-card'>
        <div style='display: flex; align-items: center; gap: 8px; margin-bottom: 8px;'>
          <div style='width: 30px; height: 30px; background: linear-gradient(135deg, #3a3a3c, #48484a); border-radius: 7px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #98989d;'>HD</div>
          <div>
            <div style='font-size: 12px; font-weight: 600;'>Macintosh HD</div>
            <div style='font-size: 10px; color: var(--tertiary);' x-text="volumeTotal + ' total'">- total</div>
          </div>
        </div>
        <div class='disk-usage-bar'>
          <div class='disk-usage-fill'
               :class="volumePct >= 95 ? 'is-critical' : (volumePct >= 85 ? 'is-tight' : '')"
               :style="'width: ' + volumePct + '%'"></div>
        </div>
        <div class='disk-usage-text'>
          <span x-text="volumeUsed + ' used'">- used</span>
          <span x-text="volumeFree + ' free'">- free</span>
        </div>
      </div>
    </div>

    <div class='disk-sidebar-section'>
      <div style='font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; color: var(--tertiary); margin-bottom: 8px;' x-text="(drilled ? 'Folder: ' : 'Home: ') + rootName">Home</div>
      <div style='font-size: 18px; font-weight: 700; margin-bottom: 2px;' x-text="scanTotalLabel">-</div>
      <div style='font-size: 10px; color: var(--tertiary);' x-text="metaText()">Click 'Scan Disk' to analyze</div>
    </div>

    <!-- A scan that ran out of time is a real answer, but only if it says so:
         52 GB of a 490 GB disk looks like the whole picture otherwise. It now
         also says how many folders it never got to, because "partial" without
         a number is impossible to weigh. -->
    <div class='disk-notice-wrap' x-show='scanInfo && scanInfo.truncated' x-cloak>
      <div class='disk-notice' x-text='unmeasuredNote()'></div>
    </div>

    <!-- Unreadable folders are a permission problem, not a scan problem, and
         the fix is somewhere else entirely. -->
    <div class='disk-notice-wrap' x-show='scanInfo && scanInfo.unreadable > 0' x-cloak>
      <div class='disk-notice' x-text='unreadableNote()'></div>
    </div>

    <div class='disk-sidebar-section' style='padding-bottom: 4px;'>
      <div style='font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; color: var(--tertiary);'>Largest Items</div>
    </div>
    <div class='folder-list'>
      <template x-for="item in topItems" :key="item.idx">
        <div class="folder-item"
            @mouseover="hovered = item"
            @mouseleave="hovered = null">
          <span class="folder-dot" :style="'background:' + item.color"></span>
          <span class="folder-name">{{ item.name }}</span>
          <span class="folder-size">{{ item.formattedSize }}</span>
          <div class="folder-bar-track">
            <div class="folder-bar-fill" :style="'width:' + item.barPct + '%;background:' + item.color"></div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Sunburst chart -->
  <div class='disk-chart'>
    <div id='disk-loading' x-show="scanState !== 'done'" style='position: relative; z-index: 1; text-align: center; color: var(--tertiary); font-size: 13px;'>
      <div class='disk-empty-glyph' :class="scanState === 'scanning' ? 'is-scanning' : ''">
        <span class='i-f7-chart-pie-fill' aria-hidden='true'></span>
      </div>
      <div x-show="scanState === 'idle'">
        <div style='margin-bottom: 12px;'>Analyze disk usage with an interactive sunburst chart</div>
        <button class='btn' onclick='startDiskScan()' style='padding: 8px 20px; font-size: 13px;'>Scan Disk</button>
        <div style='margin-top: 8px; font-size: 10px; color: #48484a;'>Results are cached for 10 minutes</div>
      </div>
      <div x-show="scanState === 'scanning'">
        <div>Scanning disk&hellip;</div>
        <!-- The count and the current directory are what distinguish a slow
             scan from a hung one. Both come from /api/scan-progress. -->
        <div style='margin-top: 8px; font-size: 12px; font-variant-numeric: tabular-nums; color: var(--ink);'
             x-show='scanProgress' x-text='scanProgress'></div>
        <div class='scan-path' x-show='scanProgressPath' x-text='scanProgressPath'></div>
        <div style='margin-top: 8px; font-size: 10px; color: var(--tertiary);' x-show='!scanStalled'>Measuring every folder on a large home directory takes a minute or two. The total on the left climbs as it goes.</div>
        <!-- Counted nothing for eight seconds: macOS is holding the read until
             someone answers, and no amount of waiting changes that. -->
        <div class='scan-blocked' x-show='scanStalled' x-cloak>
          <strong>Waiting for permission to read your files.</strong>
          If macOS asked, answer the prompt. Otherwise grant SystemCleaner
          Full Disk Access in System Settings &rsaquo; Privacy &amp; Security.
        </div>
      </div>
      <!-- A failed scan used to drop straight back to the idle state, so the
           button simply reappeared and the user was left to guess. -->
      <div x-show="scanState === 'error'" x-cloak>
        <div style='margin-bottom: 8px; color: var(--red); font-weight: 600;'>Scan failed</div>
        <div style='margin-bottom: 12px; max-width: 42ch; color: var(--secondary);' x-text='scanError'></div>
        <button class='btn' onclick='startDiskScan()' style='padding: 8px 20px; font-size: 13px;'>Try Again</button>
      </div>
    </div>
    <svg class='sunburst-svg' id='sunburst' viewBox='-320 -320 640 640' x-show="scanState === 'done'" x-cloak>
      <circle cx='0' cy='0' r='115' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <circle cx='0' cy='0' r='170' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <circle cx='0' cy='0' r='225' fill='none' stroke='var(--line-soft)' stroke-width='0.5' />
      <g id='segments-group'></g>
      <circle cx='0' cy='0' r='57' class='center-bg' />
      <circle cx='0' cy='0' r='57' class='center-ring' />
      <text x='0' y='-5' class='center-text-size' x-text="centerSize()"></text>
      <text x='0' y='12' class='center-text-name' x-text="centerName()"></text>
      <text x='0' y='26' class='center-back' id='center-back'>Back</text>
    </svg>
  </div>

  <!-- Inspector -->
  <div class='disk-inspector'>
    <div class='inspector-title'>Inspector</div>
    <div class='inspector-body'>
      <div class='inspector-placeholder' x-show="!hovered">
        <div>Hover over a segment<br>to inspect its details</div>
      </div>
      <template x-if="hovered">
        <div class="info-card">
          <div class="info-icon-row">
            <div class="info-type-icon" :style="'background:' + hovered.color + '20;color:' + hovered.color">{{ hovered.isDir ? 'Dir' : 'File' }}</div>
            <div>
              <div class="info-type-name">{{ hovered.name }}</div>
              <div class="info-type-kind">{{ (hovered.isDir ? 'Folder' : 'File') + ' · Level ' + hovered.depth }}</div>
            </div>
          </div>
          <div class="info-row"><span class="info-label">Size</span><span class="info-value">{{ hovered.formattedSize }}</span></div>
          <div class="info-row"><span class="info-label">% of View</span><span class="info-value">{{ hovered.percent + '%' }}</span></div>
          <template x-if="hovered.isDir">
            <div class="info-row"><span class="info-label">Items</span><span class="info-value">{{ hovered.childCount }}</span></div>
          </template>
          <div class="info-row" style="border-bottom:none"><span class="info-label">Depth</span><span class="info-value">{{ 'Ring ' + hovered.depth }}</span></div>
          <div class="info-path">{{ hovered.fullPath }}</div>
          <div class="info-bar">
            <div class="info-bar-label">Proportion</div>
            <div class="info-bar-track"><div class="info-bar-fill" :style="'width:' + hovered.percent + '%;background:' + hovered.color"></div></div>
            <div class="info-bar-text">{{ hovered.formattedSize + ' of ' + defaultSize }}</div>
          </div>
          <template x-if="hovered.isDir && hovered.childCount > 0">
            <div class="info-drill">Click segment to drill down</div>
          </template>
          <div class="info-actions" x-show="hovered.fullPath">
            <button class="btn btn-sm" @click="diskRevealInFinder(hovered.fullPath)">Reveal in Finder</button>
            <button class="btn btn-danger btn-sm"
                    x-show="hovered.isDir && hovered.depth >= 1"
                    @click="diskDeletePath(hovered.fullPath, hovered.name, hovered.size)"
                    x-text="'Delete ' + hovered.formattedSize">Delete</button>
          </div>
        </div>
      </template>
    </div>
  </div>

</div>

<style>
@keyframes pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }
.disk-empty-glyph { margin-bottom: 14px; color: var(--tertiary); }
.disk-empty-glyph span { display: inline-block; width: 30px; height: 30px; }
.disk-empty-glyph.is-scanning { animation: pulse 1.5s ease-in-out infinite; }
.scan-blocked { margin: 10px auto 0; max-width: 42ch; padding: 8px 12px; border: .5px solid color-mix(in srgb, var(--orange) 32%, transparent); border-radius: 6px; background: color-mix(in srgb, var(--orange) 10%, var(--surface)); color: var(--secondary); font-size: 11px; line-height: 1.5; }
.scan-blocked strong { display: block; margin-bottom: 2px; color: var(--ink); }
/* Centred like everything else in this column: a max-width block with no auto
   margin sits left, which read as misaligned against the text above it. */
.scan-path { margin: 3px auto 0; max-width: 46ch; overflow: hidden; color: var(--tertiary); font: 10px/1.5 'SF Mono', Menlo, monospace; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
@media (prefers-reduced-motion: reduce) { .disk-empty-glyph.is-scanning { animation: none; } }
</style>
