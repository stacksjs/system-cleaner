<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@yield('description')">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">
    <title>@yield('title')</title>
    <link rel="canonical" href="@yield('canonical')">
    <link rel="icon" href="/images/systemcleaner-mark.svg" type="image/svg+xml">
    @appearanceBootstrap({
      storageKey: 'systemcleaner-appearance',
      appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
      colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
    })
    <style>
      @font-face {
        font-family: 'Geist';
        src: url('/fonts/geist-latin-wght-normal.woff2') format('woff2-variations');
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
      }
      :root {
        color-scheme: light;
        --page: #f4f5f7;
        --surface: #ffffff;
        --surface-soft: #e9edf3;
        --ink: #15171a;
        --body: #50545b;
        --muted: #737880;
        --line: rgba(21, 23, 26, 0.11);
        --line-strong: rgba(21, 23, 26, 0.18);
        --accent: #0a67d8;
        --accent-strong: #0758bb;
        --accent-soft: rgba(10, 103, 216, 0.10);
        --on-accent: #f8fbff;
        --shadow: 0 28px 70px rgba(34, 45, 63, 0.16);
      }
      :root.dark, :root[data-color-mode='dark'] {
        color-scheme: dark;
        --page: #111214;
        --surface: #1b1d20;
        --surface-soft: #25282d;
        --ink: #f3f5f8;
        --body: #b5bac2;
        --muted: #8a9099;
        --line: rgba(255, 255, 255, 0.10);
        --line-strong: rgba(255, 255, 255, 0.18);
        --accent: #409cff;
        --accent-strong: #6db3ff;
        --accent-soft: rgba(64, 156, 255, 0.13);
        --on-accent: #07111d;
        --shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-color-mode='light']) {
          color-scheme: dark;
          --page: #111214;
          --surface: #1b1d20;
          --surface-soft: #25282d;
          --ink: #f3f5f8;
          --body: #b5bac2;
          --muted: #8a9099;
          --line: rgba(255, 255, 255, 0.10);
          --line-strong: rgba(255, 255, 255, 0.18);
          --accent: #409cff;
          --accent-strong: #6db3ff;
          --accent-soft: rgba(64, 156, 255, 0.13);
          --on-accent: #07111d;
          --shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { overflow-x: clip; background: var(--page); scroll-behavior: smooth; }
      body { margin: 0; min-width: 320px; overflow-x: clip; background: var(--page); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      .type-geist { font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; }
      a { color: inherit; text-decoration: none; }
      button, input { font: inherit; }
      img { display: block; max-width: 100%; }
      .site-container { width: min(100% - 32px, 1240px); margin-inline: auto; }
      .site-nav-wrap { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--page) 86%, transparent); backdrop-filter: blur(24px) saturate(160%); }
      .site-nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 68px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; flex: none; font-size: 15px; font-weight: 650; letter-spacing: -0.02em; }
      .brand img { width: 32px; height: 32px; }
      .desktop-nav { display: flex; align-items: center; align-self: stretch; gap: 3px; }
      .nav-link { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: 10px; color: var(--body); font-size: 14px; font-weight: 520; transition: color .18s ease, background .18s ease; }
      .nav-link:hover, .nav-link:focus-visible { color: var(--ink); background: var(--surface-soft); outline: none; }
      .mega-root { display: flex; align-items: center; height: 100%; }
      .mega-panel { position: absolute; inset-inline: 0; top: 100%; visibility: hidden; opacity: 0; transform: translateY(-7px); border-bottom: 1px solid var(--line); background: var(--surface); box-shadow: 0 22px 42px rgba(22, 32, 47, 0.12); transition: opacity .18s ease, transform .18s ease, visibility .18s; }
      .mega-root:hover .mega-panel, .mega-root:focus-within .mega-panel { visibility: visible; opacity: 1; transform: translateY(0); }
      .mega-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; padding-block: 24px 28px; }
      .mega-item { display: grid; grid-template-columns: 34px 1fr; gap: 11px; padding: 13px; border-radius: 14px; transition: background .18s ease, transform .18s ease; }
      .mega-item:hover, .mega-item:focus-visible { background: var(--surface-soft); transform: translateY(-1px); outline: none; }
      .mega-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
      .mega-item strong { display: block; font-size: 14px; letter-spacing: -0.01em; }
      .mega-item span:last-child { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.45; }
      .nav-actions { display: flex; align-items: center; gap: 8px; flex: none; }
      .button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 17px; border: 1px solid transparent; border-radius: 12px; cursor: pointer; font-size: 14px; font-weight: 620; white-space: nowrap; transition: transform .18s ease, background .18s ease, border-color .18s ease; }
      .button:active { transform: translateY(1px) scale(.99); }
      .button-primary { background: var(--accent); color: var(--on-accent); }
      .button-primary:hover { background: var(--accent-strong); }
      .button-secondary { border-color: var(--line-strong); background: var(--surface); color: var(--ink); }
      .button-secondary:hover { background: var(--surface-soft); }
      .mobile-nav { display: none; }
      .hero { display: grid; grid-template-columns: minmax(420px, .84fr) minmax(560px, 1.16fr); gap: clamp(42px, 5.5vw, 76px); align-items: center; padding-block: clamp(68px, 7vw, 94px) clamp(86px, 9vw, 118px); }
      .hero-copy { max-width: 610px; }
      .eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
      .hero h1, .feature-hero h1 { margin: 0; max-width: 64rem; font-size: clamp(44px, 4.4vw, 62px); font-weight: 680; line-height: .98; letter-spacing: -.055em; }
      .hero h1 span { display: block; white-space: nowrap; }
      .hero-copy > p:not(.eyebrow), .feature-hero > p { max-width: 54ch; margin: 24px 0 0; color: var(--body); font-size: clamp(17px, 1.6vw, 19px); line-height: 1.58; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
      .hero-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 36px 0 0; padding-top: 22px; border-top: 1px solid var(--line); }
      .hero-facts div { min-width: 0; }
      .hero-facts dt { font-size: 13px; font-weight: 680; }
      .hero-facts dd { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
      .hero-visual { position: relative; min-width: 0; }
      .hero-visual::before { position: absolute; inset: 12% -5% -7% 10%; border-radius: 38px; background: var(--accent-soft); content: ''; transform: rotate(2deg); }
      .app-window { position: relative; overflow: hidden; margin: 0; border: 1px solid var(--line-strong); border-radius: 18px; background: var(--surface); box-shadow: var(--shadow); }
      .app-window-bar { position: relative; display: flex; height: 38px; align-items: center; justify-content: center; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 88%, var(--surface-soft)); color: var(--muted); font-size: 11px; font-weight: 600; }
      .traffic-lights { position: absolute; left: 14px; display: flex; gap: 7px; }
      .traffic-lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
      .traffic-lights i:nth-child(2) { background: #febc2e; }
      .traffic-lights i:nth-child(3) { background: #28c840; }
      .app-window img { width: 100%; height: auto; background: var(--page); }
      .app-window-hero { transform: rotate(-.7deg); }
      .section { padding-block: clamp(82px, 9vw, 118px); border-top: 1px solid var(--line); }
      .section-heading { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(36px, 7vw, 100px); align-items: end; }
      .section h2 { margin: 0; max-width: 16ch; font-size: clamp(34px, 4.5vw, 56px); line-height: 1.02; letter-spacing: -.047em; }
      .section-intro { max-width: 54ch; margin: 0; color: var(--body); font-size: 18px; line-height: 1.6; }
      .feature-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(196px, auto)); grid-auto-flow: dense; gap: 12px; margin-top: 48px; }
      .feature-cell { position: relative; min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); transition: border-color .2s, transform .2s; }
      .feature-cell:hover { border-color: var(--line-strong); transform: translateY(-2px); }
      .feature-cell-1 { grid-column: 1 / span 2; grid-row: 1 / span 2; background: linear-gradient(145deg, var(--surface), var(--accent-soft)); }
      .feature-cell-2 { grid-column: 3 / span 2; grid-row: 1; }
      .feature-cell-3 { grid-column: 3; grid-row: 2; }
      .feature-cell-4 { grid-column: 4; grid-row: 2; background: var(--surface-soft); }
      .feature-cell-5 { grid-column: 1; grid-row: 3; }
      .feature-cell-6 { grid-column: 2; grid-row: 3; }
      .feature-cell-7 { grid-column: 3 / span 2; grid-row: 3; background: linear-gradient(145deg, var(--accent-soft), var(--surface)); }
      .feature-cell a { display: flex; height: 100%; min-height: 196px; flex-direction: column; justify-content: space-between; gap: 32px; padding: 25px; }
      .feature-cell-1 a { min-height: 404px; }
      .feature-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: var(--accent-soft); color: var(--accent); }
      .feature-icon > span { width: 20px; height: 20px; }
      .feature-arrow { position: absolute; top: 25px; right: 25px; width: 16px; height: 16px; color: var(--muted); }
      .feature-cell h3 { margin: 0; font-size: clamp(18px, 1.8vw, 23px); letter-spacing: -.025em; }
      .feature-cell p { margin: 9px 0 0; color: var(--body); font-size: 14px; line-height: 1.52; }
      .app-tour { background: color-mix(in srgb, var(--surface-soft) 66%, var(--page)); }
      .app-tour-heading { display: grid; grid-template-columns: .72fr 1fr 1fr; gap: 38px; align-items: end; }
      .app-tour-heading .eyebrow { margin: 0; align-self: start; }
      .app-tour-heading > p:last-child { max-width: 42ch; margin: 0; color: var(--body); font-size: 17px; line-height: 1.58; }
      .app-tour-grid { display: grid; gap: clamp(62px, 9vw, 118px); margin-top: 64px; }
      .tour-card { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: clamp(38px, 6vw, 84px); align-items: center; }
      .tour-card:nth-child(even) { grid-template-columns: minmax(0, 1fr) 280px; }
      .tour-card:nth-child(even) .tour-copy { grid-column: 2; }
      .tour-card:nth-child(even) .app-window { grid-column: 1; grid-row: 1; }
      .tour-copy h3 { margin: 0; font-size: 28px; letter-spacing: -.035em; }
      .tour-copy p { margin: 14px 0 0; color: var(--body); font-size: 15px; line-height: 1.62; }
      .tour-copy a { display: inline-flex; align-items: center; gap: 7px; margin-top: 22px; color: var(--accent); font-size: 14px; font-weight: 650; }
      .tour-copy a span { width: 14px; height: 14px; transition: transform .18s; }
      .tour-copy a:hover span { transform: translateX(3px); }
      .privacy-band { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: end; padding: clamp(38px, 6vw, 70px); border: 1px solid var(--line); border-radius: 20px; background: var(--surface-soft); }
      .privacy-icon { display: block; width: 30px; height: 30px; margin-bottom: 28px; color: var(--accent); }
      .privacy-band h2 { max-width: 11ch; }
      .privacy-band p { max-width: 50ch; margin: 0; color: var(--body); font-size: 17px; line-height: 1.65; }
      .subscribe { border-top: 1px solid var(--line); }
      .subscribe-inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; align-items: center; padding-block: 86px; }
      .subscribe h2 { margin: 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -.04em; }
      .subscribe-copy { max-width: 46ch; margin: 16px 0 0; color: var(--body); line-height: 1.6; }
      .subscribe-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: end; }
      .field { display: grid; gap: 8px; }
      .field label { color: var(--body); font-size: 13px; font-weight: 620; }
      .field input { width: 100%; height: 46px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 12px; outline: none; background: var(--surface); color: var(--ink); }
      .field input::placeholder { color: var(--muted); }
      .field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
      .subscribe-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--muted); font-size: 13px; }
      .subscribe-status[data-tone='error'] { color: #c43131; }
      .subscribe-status[data-tone='success'] { color: var(--accent); }
      .site-footer { border-top: 1px solid var(--line); }
      .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding-block: 30px; color: var(--muted); font-size: 13px; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 20px; }
      .footer-links a:hover { color: var(--ink); }
      .feature-hero { padding-block: clamp(80px, 12vw, 150px) 76px; }
      .feature-hero h1 { max-width: 14ch; }
      .feature-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(38px, 8vw, 110px); padding-block: 68px 108px; border-top: 1px solid var(--line); }
      .feature-layout h2 { margin: 0; font-size: clamp(28px, 4vw, 44px); letter-spacing: -.035em; }
      .feature-layout p { max-width: 58ch; color: var(--body); font-size: 17px; line-height: 1.7; }
      .feature-fact { align-self: start; padding: 28px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
      .feature-fact strong { display: block; font-size: 24px; letter-spacing: -.03em; }
      .feature-fact span { display: block; margin-top: 8px; color: var(--body); line-height: 1.55; }
      .feature-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0 0 100px; padding: 1px; list-style: none; background: var(--line); border-radius: 18px; overflow: hidden; }
      .feature-list a { display: flex; align-items: center; justify-content: space-between; min-height: 96px; padding: 20px 24px; background: var(--surface); }
      .feature-list a:hover { background: var(--surface-soft); }
      @media (max-width: 900px) {
        .desktop-nav { display: none; }
        .mobile-nav { display: block; border-top: 1px solid var(--line); }
        .mobile-nav summary { display: flex; align-items: center; justify-content: space-between; height: 48px; cursor: pointer; color: var(--body); }
        .mobile-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; padding-bottom: 20px; }
        .hero { grid-template-columns: 1fr; padding-block: 66px 82px; }
        .hero-copy { max-width: 720px; }
        .hero-visual { max-width: 820px; }
        .feature-grid { grid-template-columns: repeat(2, 1fr); }
        .feature-cell { grid-column: auto; grid-row: auto; }
        .feature-cell-1 a { min-height: 260px; }
        .app-tour-heading, .section-heading { grid-template-columns: 1fr; gap: 20px; }
        .tour-card, .tour-card:nth-child(even) { grid-template-columns: 220px minmax(0, 1fr); }
        .tour-card:nth-child(even) .tour-copy { grid-column: 1; }
        .tour-card:nth-child(even) .app-window { grid-column: 2; }
        .privacy-band, .subscribe-inner, .feature-layout { grid-template-columns: 1fr; }
      }
      @media (max-width: 640px) {
        .site-container { width: min(100% - 24px, 1240px); }
        .site-nav { height: 62px; }
        .nav-actions .button-secondary { display: none; }
        .hero { padding-block: 52px 72px; }
        .hero h1, .feature-hero h1 { font-size: clamp(40px, 12vw, 54px); }
        .hero h1 span { white-space: normal; }
        .hero-facts { grid-template-columns: 1fr; gap: 12px; }
        .feature-grid, .feature-list { grid-template-columns: 1fr; }
        .feature-cell a, .feature-cell-1 a { min-height: 210px; }
        .app-window { border-radius: 13px; }
        .app-window-bar { height: 32px; }
        .tour-card, .tour-card:nth-child(even) { grid-template-columns: 1fr; gap: 24px; }
        .tour-card:nth-child(even) .tour-copy, .tour-card:nth-child(even) .app-window { grid-column: 1; }
        .tour-card:nth-child(even) .app-window { grid-row: auto; }
        .privacy-band { padding: 30px 24px; }
        .subscribe-form { grid-template-columns: 1fr; }
        .subscribe-form .button { width: 100%; }
        .footer-inner { align-items: flex-start; flex-direction: column; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        .app-window-hero { transform: none; }
      }
    </style>
  </head>
  <body>
    <MarketingNav />
    <main data-stx-content>
      @yield('content')
    </main>
    <MarketingSubscribe />
    <MarketingFooter />
  </body>
</html>
