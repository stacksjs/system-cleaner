<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@yield('description')">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">
    <title>@yield('title')</title>
    <link rel="canonical" href="@yield('canonical')">
    <link rel="icon" href="/images/systemcleaner-icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/images/systemcleaner-icon.png">
    @appearanceBootstrap({
      storageKey: 'systemcleaner-appearance',
      appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
      colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
    })
    <style>
      :root {
        color-scheme: light;
        --page: #f4f5f7;
        --surface: #ffffff;
        --surface-soft: #e9edf3;
        --ink: #15171a;
        --body: #50545b;
        --muted: #737880;
        --line: rgba(21, 23, 26, 0.11);
        --line-strong: rgba(21, 23, 26, 0.18);
        --accent: #0a67d8;
        --accent-strong: #0758bb;
        --accent-soft: rgba(10, 103, 216, 0.10);
        --on-accent: #f8fbff;
        --shadow: 0 28px 70px rgba(34, 45, 63, 0.16);
      }
      :root.dark, :root[data-color-mode='dark'] {
        color-scheme: dark;
        --page: #111214;
        --surface: #1b1d20;
        --surface-soft: #25282d;
        --ink: #f3f5f8;
        --body: #b5bac2;
        --muted: #8a9099;
        --line: rgba(255, 255, 255, 0.10);
        --line-strong: rgba(255, 255, 255, 0.18);
        --accent: #409cff;
        --accent-strong: #6db3ff;
        --accent-soft: rgba(64, 156, 255, 0.13);
        --on-accent: #07111d;
        --shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-color-mode='light']) {
          color-scheme: dark;
          --page: #111214;
          --surface: #1b1d20;
          --surface-soft: #25282d;
          --ink: #f3f5f8;
          --body: #b5bac2;
          --muted: #8a9099;
          --line: rgba(255, 255, 255, 0.10);
          --line-strong: rgba(255, 255, 255, 0.18);
          --accent: #409cff;
          --accent-strong: #6db3ff;
          --accent-soft: rgba(64, 156, 255, 0.13);
          --on-accent: #07111d;
          --shadow: 0 32px 80px rgba(0, 0, 0, 0.42);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { overflow-x: clip; background: var(--page); scroll-behavior: smooth; }
      body { margin: 0; min-width: 320px; overflow-x: clip; background: var(--page); color: var(--ink); font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      button, input { font: inherit; }
      img { display: block; max-width: 100%; }
      .site-container { width: min(100% - 32px, 1240px); margin-inline: auto; }
      .site-nav-wrap { position: sticky; top: 0; z-index: 40; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--page) 86%, transparent); backdrop-filter: blur(24px) saturate(160%); }
      .site-nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 68px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; flex: none; font-size: 15px; font-weight: 650; letter-spacing: -0.02em; }
      .brand img { width: 34px; height: 34px; border-radius: 9px; box-shadow: 0 7px 18px rgba(33, 48, 67, 0.16); }
      .desktop-nav { display: flex; align-items: center; align-self: stretch; gap: 3px; }
      .nav-link { display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 12px; border-radius: 10px; color: var(--body); font-size: 14px; font-weight: 520; transition: color .18s ease, background .18s ease; }
      .nav-link:hover, .nav-link:focus-visible { color: var(--ink); background: var(--surface-soft); outline: none; }
      .mega-root { display: flex; align-items: center; height: 100%; }
      .mega-panel { position: absolute; inset-inline: 0; top: 100%; visibility: hidden; opacity: 0; transform: translateY(-7px); border-bottom: 1px solid var(--line); background: var(--surface); box-shadow: 0 22px 42px rgba(22, 32, 47, 0.12); transition: opacity .18s ease, transform .18s ease, visibility .18s; }
      .mega-root:hover .mega-panel, .mega-root:focus-within .mega-panel { visibility: visible; opacity: 1; transform: translateY(0); }
      .mega-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; padding-block: 24px 28px; }
      .mega-item { display: grid; grid-template-columns: 34px 1fr; gap: 11px; padding: 13px; border-radius: 14px; transition: background .18s ease, transform .18s ease; }
      .mega-item:hover, .mega-item:focus-visible { background: var(--surface-soft); transform: translateY(-1px); outline: none; }
      .mega-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
      .mega-item strong { display: block; font-size: 14px; letter-spacing: -0.01em; }
      .mega-item span:last-child { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.45; }
      .nav-actions { display: flex; align-items: center; gap: 8px; flex: none; }
      .button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 17px; border: 1px solid transparent; border-radius: 12px; cursor: pointer; font-size: 14px; font-weight: 620; white-space: nowrap; transition: transform .18s ease, background .18s ease, border-color .18s ease; }
      .button:active { transform: translateY(1px) scale(.99); }
      .button-primary { background: var(--accent); color: var(--on-accent); }
      .button-primary:hover { background: var(--accent-strong); }
      .button-secondary { border-color: var(--line-strong); background: var(--surface); color: var(--ink); }
      .button-secondary:hover { background: var(--surface-soft); }
      .mobile-nav { display: none; }
      .hero { display: grid; grid-template-columns: minmax(0, .82fr) minmax(460px, 1.18fr); gap: clamp(40px, 7vw, 100px); align-items: center; min-height: calc(100dvh - 68px); padding-block: 54px; }
      .hero-copy { max-width: 590px; }
      .eyebrow { margin: 0 0 18px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
      .hero h1, .feature-hero h1 { margin: 0; max-width: 12ch; font-size: clamp(45px, 6.2vw, 80px); font-weight: 680; line-height: .98; letter-spacing: -.062em; }
      .hero-copy > p:not(.eyebrow), .feature-hero > p { max-width: 52ch; margin: 24px 0 0; color: var(--body); font-size: clamp(17px, 2vw, 20px); line-height: 1.55; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
      .hero-visual { position: relative; min-width: 0; }
      .hero-visual::before { content: ''; position: absolute; inset: 12% -6% -8% 14%; border-radius: 44px; background: var(--accent-soft); filter: blur(2px); transform: rotate(4deg); }
      .hero-product { position: relative; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 24px; background: var(--surface); box-shadow: var(--shadow); transform: rotate(-1.5deg); }
      .hero-product img { width: 100%; height: auto; }
      .hero-icon-stage { display: grid; place-items: center; aspect-ratio: 1.35; background: linear-gradient(135deg, var(--surface), var(--surface-soft)); }
      .hero-icon-stage img { width: min(54%, 330px); border-radius: 24%; box-shadow: 0 25px 60px rgba(20, 33, 51, .25); }
      .section { padding-block: clamp(76px, 10vw, 132px); border-top: 1px solid var(--line); }
      .section h2 { margin: 0; max-width: 12ch; font-size: clamp(34px, 5vw, 62px); line-height: 1.02; letter-spacing: -.048em; }
      .section-intro { max-width: 58ch; margin: 22px 0 0; color: var(--body); font-size: 18px; line-height: 1.6; }
      .feature-grid { display: grid; grid-template-columns: 1.25fr .75fr 1fr; grid-auto-rows: minmax(230px, auto); gap: 14px; margin-top: 54px; }
      .feature-cell { position: relative; overflow: hidden; min-width: 0; padding: 28px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
      .feature-cell:first-child { grid-row: span 2; background: linear-gradient(160deg, var(--surface), var(--accent-soft)); }
      .feature-cell:nth-child(4) { grid-column: span 2; background: var(--surface-soft); }
      .feature-cell:nth-child(6) { background: linear-gradient(145deg, var(--accent-soft), var(--surface)); }
      .feature-cell a { display: flex; height: 100%; flex-direction: column; }
      .feature-cell .icon { width: 28px; height: 28px; color: var(--accent); }
      .feature-cell h3 { margin: auto 0 0; padding-top: 46px; font-size: 22px; letter-spacing: -.025em; }
      .feature-cell p { margin: 10px 0 0; color: var(--body); font-size: 14px; line-height: 1.55; }
      .privacy-band { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: end; padding: clamp(38px, 6vw, 72px); border-radius: 20px; background: #17191d; color: #f4f6f9; }
      .privacy-band h2 { max-width: 10ch; }
      .privacy-band p { max-width: 50ch; margin: 0; color: #b7bdc7; font-size: 17px; line-height: 1.65; }
      .subscribe { border-top: 1px solid var(--line); }
      .subscribe-inner { display: grid; grid-template-columns: .9fr 1.1fr; gap: 56px; align-items: start; padding-block: 86px; }
      .subscribe h2 { margin: 0; font-size: clamp(30px, 4vw, 48px); letter-spacing: -.04em; }
      .subscribe-copy { max-width: 46ch; margin: 16px 0 0; color: var(--body); line-height: 1.6; }
      .subscribe-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: end; }
      .field { display: grid; gap: 8px; }
      .field label { color: var(--body); font-size: 13px; font-weight: 620; }
      .field input { width: 100%; height: 46px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 12px; outline: none; background: var(--surface); color: var(--ink); }
      .field input::placeholder { color: var(--muted); }
      .field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
      .subscribe-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--muted); font-size: 13px; }
      .subscribe-status[data-tone='error'] { color: #c43131; }
      .subscribe-status[data-tone='success'] { color: var(--accent); }
      .site-footer { border-top: 1px solid var(--line); }
      .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding-block: 30px; color: var(--muted); font-size: 13px; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 20px; }
      .footer-links a:hover { color: var(--ink); }
      .feature-hero { padding-block: clamp(80px, 12vw, 150px) 76px; }
      .feature-hero h1 { max-width: 14ch; }
      .feature-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(38px, 8vw, 110px); padding-block: 68px 108px; border-top: 1px solid var(--line); }
      .feature-layout h2 { margin: 0; font-size: clamp(28px, 4vw, 44px); letter-spacing: -.035em; }
      .feature-layout p { max-width: 58ch; color: var(--body); font-size: 17px; line-height: 1.7; }
      .feature-fact { align-self: start; padding: 28px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
      .feature-fact strong { display: block; font-size: 24px; letter-spacing: -.03em; }
      .feature-fact span { display: block; margin-top: 8px; color: var(--body); line-height: 1.55; }
      .feature-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0 0 100px; padding: 1px; list-style: none; background: var(--line); border-radius: 18px; overflow: hidden; }
      .feature-list a { display: flex; align-items: center; justify-content: space-between; min-height: 96px; padding: 20px 24px; background: var(--surface); }
      .feature-list a:hover { background: var(--surface-soft); }
      @media (max-width: 900px) {
        .desktop-nav { display: none; }
        .mobile-nav { display: block; border-top: 1px solid var(--line); }
        .mobile-nav summary { display: flex; align-items: center; justify-content: space-between; height: 48px; cursor: pointer; color: var(--body); }
        .mobile-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; padding-bottom: 20px; }
        .hero { grid-template-columns: 1fr; min-height: auto; padding-block: 66px 80px; }
        .hero-copy { max-width: 720px; }
        .hero-visual { max-width: 720px; }
        .feature-grid { grid-template-columns: repeat(2, 1fr); }
        .feature-cell:first-child { grid-row: auto; }
        .feature-cell:nth-child(4) { grid-column: auto; }
        .privacy-band, .subscribe-inner, .feature-layout { grid-template-columns: 1fr; }
      }
      @media (max-width: 640px) {
        .site-container { width: min(100% - 24px, 1240px); }
        .site-nav { height: 62px; }
        .nav-actions .button-secondary { display: none; }
        .hero { min-height: auto; padding-block: 52px 72px; }
        .hero h1, .feature-hero h1 { font-size: clamp(42px, 13vw, 58px); }
        .feature-grid, .feature-list { grid-template-columns: 1fr; }
        .feature-cell { min-height: 220px; }
        .privacy-band { padding: 30px 24px; }
        .subscribe-form { grid-template-columns: 1fr; }
        .subscribe-form .button { width: 100%; }
        .footer-inner { align-items: flex-start; flex-direction: column; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        .hero-product { transform: none; }
      }
    </style>
  </head>
  <body>
    <MarketingNav />
    <main data-stx-content>
      @yield('content')
    </main>
    <MarketingSubscribe />
    <MarketingFooter />
  </body>
</html>
