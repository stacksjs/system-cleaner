<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@yield('description')">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">
    <title>@yield('title')</title>
    <link rel="canonical" href="@yield('canonical')">
    <link rel="icon" href="/images/systemcleaner-mark.svg" type="image/svg+xml">
    @appearanceBootstrap({
      storageKey: 'systemcleaner-appearance',
      appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
      colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
    })
    <style>
      @font-face {
        font-family: 'Geist';
        src: url('/fonts/geist-latin-wght-normal.woff2') format('woff2-variations');
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
      }

      /*
        Shape system, applied everywhere on the marketing site:
          --r-pill   interactive controls (buttons, chips, pills)
          --r-panel  cards, bento cells, app windows, bands
          --r-field  form inputs
        Nothing on this site uses a radius outside those three.
      */
      :root {
        color-scheme: light;
        --page: #f4f5f7;
        --surface: #ffffff;
        --surface-soft: #eaeef4;
        --surface-sunk: #e2e7ef;
        --ink: #15171a;
        --body: #4b5058;
        --muted: #737880;
        --line: rgba(21, 23, 26, 0.10);
        --line-strong: rgba(21, 23, 26, 0.17);
        --accent: #0a67d8;
        --accent-strong: #0954b2;
        --accent-soft: rgba(10, 103, 216, 0.09);
        --accent-glow: rgba(10, 103, 216, 0.16);
        --on-accent: #ffffff;
        --shadow-sm: 0 2px 10px rgba(24, 33, 48, 0.06);
        --shadow: 0 30px 70px rgba(29, 39, 56, 0.15);
        --r-pill: 999px;
        --r-panel: 20px;
        --r-field: 12px;
      }
      :root.dark, :root[data-color-mode='dark'] {
        color-scheme: dark;
        --page: #0f1113;
        --surface: #191c1f;
        --surface-soft: #22262a;
        --surface-sunk: #15181b;
        --ink: #f3f5f8;
        --body: #b3b9c1;
        --muted: #878d95;
        --line: rgba(255, 255, 255, 0.09);
        --line-strong: rgba(255, 255, 255, 0.17);
        --accent: #409cff;
        --accent-strong: #6fb4ff;
        --accent-soft: rgba(64, 156, 255, 0.13);
        --accent-glow: rgba(64, 156, 255, 0.22);
        --on-accent: #06131f;
        --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.3);
        --shadow: 0 34px 84px rgba(0, 0, 0, 0.5);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-color-mode='light']) {
          color-scheme: dark;
          --page: #0f1113;
          --surface: #191c1f;
          --surface-soft: #22262a;
          --surface-sunk: #15181b;
          --ink: #f3f5f8;
          --body: #b3b9c1;
          --muted: #878d95;
          --line: rgba(255, 255, 255, 0.09);
          --line-strong: rgba(255, 255, 255, 0.17);
          --accent: #409cff;
          --accent-strong: #6fb4ff;
          --accent-soft: rgba(64, 156, 255, 0.13);
          --accent-glow: rgba(64, 156, 255, 0.22);
          --on-accent: #06131f;
          --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.3);
          --shadow: 0 34px 84px rgba(0, 0, 0, 0.5);
        }
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { overflow-x: clip; background: var(--page); scroll-behavior: smooth; }
      body {
        margin: 0; min-width: 320px; overflow-x: clip;
        background: var(--page); color: var(--ink);
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      button, input { font: inherit; }
      img { display: block; max-width: 100%; }
      h1, h2, h3 { text-wrap: balance; }
      p { text-wrap: pretty; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

      .site-container { width: min(100% - 40px, 1180px); margin-inline: auto; }
      .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

      /* ---------- Navigation ---------- */
      .site-nav-wrap {
        position: sticky; top: 0; z-index: 40;
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--page) 82%, transparent);
        backdrop-filter: blur(22px) saturate(170%);
        -webkit-backdrop-filter: blur(22px) saturate(170%);
      }
      .site-nav { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 68px; }
      .brand { display: inline-flex; align-items: center; gap: 10px; flex: none; font-size: 15px; font-weight: 650; letter-spacing: -0.02em; }
      .brand { color: var(--ink); }
      .brand .brand-mark { width: 32px; height: 32px; }
      .desktop-nav { display: flex; align-items: center; align-self: stretch; gap: 2px; }
      .nav-link {
        display: inline-flex; align-items: center; gap: 6px;
        height: 36px; padding: 0 13px; border: 0; border-radius: var(--r-pill);
        background: none; color: var(--body); cursor: pointer;
        font-size: 14px; font-weight: 520; white-space: nowrap;
        transition: color .18s ease, background .18s ease;
      }
      .nav-link:hover, .nav-link:focus-visible { color: var(--ink); background: var(--surface-soft); }

      /* One bar holds every mega trigger, so the panels share a single
         open-state and can never stack on top of each other. */
      .mega-bar { display: flex; align-items: center; align-self: stretch; gap: 2px; }
      .mega-menu { position: relative; display: flex; align-items: center; height: 100%; }
      .mega-chevron { transition: transform .2s ease; }
      .mega-trigger[aria-expanded='true'] { color: var(--ink); background: var(--surface-soft); }
      .mega-trigger[aria-expanded='true'] .mega-chevron { transform: rotate(180deg); }
      /* The panel spans the viewport rather than the trigger, so it is
         positioned against the nav bar's height instead of its own flow. */
      .mega-panel {
        position: fixed; left: 0; right: 0; top: 68px;
        visibility: hidden; opacity: 0; transform: translateY(-8px);
        border-bottom: 1px solid var(--line);
        background: var(--surface);
        box-shadow: var(--shadow);
        transition: opacity .18s ease, transform .18s ease, visibility .18s;
      }
      .mega-panel[data-open='true'] { visibility: visible; opacity: 1; transform: translateY(0); }
      .mega-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; padding-block: 22px 26px; }
      /* Six use-case tiles land as two even rows of three rather than a row
         of four and a stranded pair. */
      .mega-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .mega-item { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding: 13px; border-radius: var(--r-field); transition: background .18s ease; }
      .mega-item:hover, .mega-item:focus-visible { background: var(--surface-soft); }
      .mega-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
      .mega-item strong { display: block; font-size: 14px; letter-spacing: -0.01em; }
      .mega-item span:last-child { display: block; margin-top: 4px; color: var(--muted); font-size: 12px; line-height: 1.45; }
      .mega-item-all .mega-icon { background: var(--accent); color: var(--on-accent); }

      .nav-actions { display: flex; align-items: center; gap: 8px; flex: none; }
      .nav-burger {
        display: none; align-items: center; gap: 8px;
        height: 38px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: var(--r-pill);
        background: var(--surface); color: var(--ink); cursor: pointer; font-size: 14px; font-weight: 600;
      }
      .mobile-sheet { display: none; }

      /* ---------- Buttons ---------- */
      .button {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 42px; padding: 0 20px;
        border: 1px solid transparent; border-radius: var(--r-pill);
        cursor: pointer; font-size: 14px; font-weight: 620; white-space: nowrap;
        transition: transform .16s ease, background .18s ease, border-color .18s ease, box-shadow .18s ease;
      }
      .button:active { transform: translateY(1px) scale(.99); }
      .button-primary { background: var(--accent); color: var(--on-accent); box-shadow: 0 8px 22px var(--accent-glow); }
      .button-primary:hover { background: var(--accent-strong); }
      .button-secondary { border-color: var(--line-strong); background: var(--surface); color: var(--ink); }
      .button-secondary:hover { background: var(--surface-soft); }
      .button-lg { min-height: 52px; padding: 0 28px; font-size: 15px; }

      /* Mac App Store lockup. Sized against the primary button so the pair
         reads as one row of equal-weight actions. */
      .store-button {
        display: inline-flex; align-items: center; gap: 11px;
        min-height: 52px; padding: 0 22px 0 18px;
        border: 1px solid var(--line-strong); border-radius: var(--r-pill);
        background: var(--surface); color: var(--ink);
        transition: background .18s ease, border-color .18s ease, transform .16s ease;
      }
      .store-button:hover { background: var(--surface-soft); }
      .store-button:active { transform: translateY(1px) scale(.99); }
      .store-button .store-glyph { width: 24px; height: 24px; color: var(--ink); }
      .store-button small { display: block; color: var(--muted); font-size: 11px; line-height: 1.1; }
      .store-button strong { display: block; margin-top: 2px; font-size: 15px; font-weight: 620; letter-spacing: -0.01em; }

      /* ---------- Hero ---------- */
      .hero {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
        gap: clamp(36px, 4vw, 56px); align-items: center;
        padding-block: clamp(52px, 5vw, 80px) clamp(48px, 5vw, 72px);
      }
      /* Sized so the headline sets on two lines at every desktop width. */
      .hero-copy { max-width: 610px; }
      .eyebrow { margin: 0 0 16px; color: var(--accent); font-size: 12px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
      .hero h1 {
        margin: 0;
        font-size: clamp(36px, 3.4vw, 48px); font-weight: 680;
        line-height: 1.06; letter-spacing: -.04em;
      }
      .hero-copy > p:not(.eyebrow) { max-width: 46ch; margin: 20px 0 0; color: var(--body); font-size: clamp(16px, 1.4vw, 18px); line-height: 1.6; }
      .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 30px; }
      .hero-visual { position: relative; min-width: 0; }
      .hero-visual::before {
        position: absolute; inset: 14% -6% -8% 8%; content: '';
        border-radius: 40px; background: var(--accent-soft); transform: rotate(2deg);
      }

      /* ---------- App window chrome ---------- */
      .app-window {
        position: relative; overflow: hidden; margin: 0;
        border: 1px solid var(--line-strong); border-radius: var(--r-panel);
        background: var(--surface); box-shadow: var(--shadow);
      }
      .app-window-bar {
        position: relative; display: flex; height: 38px; align-items: center; justify-content: center;
        border-bottom: 1px solid var(--line);
        background: color-mix(in srgb, var(--surface) 86%, var(--surface-soft));
        color: var(--muted); font-size: 11px; font-weight: 600;
      }
      .traffic-lights { position: absolute; left: 14px; display: flex; gap: 7px; }
      .traffic-lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
      .traffic-lights i:nth-child(2) { background: #febc2e; }
      .traffic-lights i:nth-child(3) { background: #28c840; }
      .app-window img { width: 100%; height: auto; background: var(--page); }

      /* ---------- Requirement band under the hero ---------- */
      .spec-band { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface-sunk); }
      .spec-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding-block: 22px; }
      .spec-row div { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .spec-row span[class*='i-'] { flex: none; width: 18px; height: 18px; color: var(--accent); }
      .spec-row p { margin: 0; color: var(--body); font-size: 13.5px; line-height: 1.4; }
      .spec-row b { color: var(--ink); font-weight: 620; }

      /* ---------- Generic section rhythm ---------- */
      .section { padding-block: clamp(68px, 7vw, 100px); }
      .section + .section { border-top: 1px solid var(--line); }
      .section-heading { max-width: 46rem; }
      .section h2 { margin: 0; font-size: clamp(27px, 2.9vw, 38px); line-height: 1.1; letter-spacing: -.035em; }
      .section-intro { max-width: 56ch; margin: 14px 0 0; color: var(--body); font-size: 16.5px; line-height: 1.6; }

      /* ---------- Feature bento ---------- */
      .feature-grid {
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-auto-rows: minmax(178px, auto); gap: 12px; margin-top: 44px;
      }
      .feature-cell {
        position: relative; min-width: 0; overflow: hidden;
        border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface);
        transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
      }
      .feature-cell:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
      .feature-cell-1 { grid-column: span 2; grid-row: span 2; background: linear-gradient(150deg, var(--surface) 30%, var(--accent-soft)); }
      .feature-cell-2 { grid-column: span 2; }
      .feature-cell-3 { grid-column: span 1; background: var(--surface-soft); }
      .feature-cell-4 { grid-column: span 1; }
      .feature-cell-5 { grid-column: span 1; }
      .feature-cell-6 { grid-column: span 1; background: var(--surface-soft); }
      .feature-cell-7 { grid-column: span 2; background: linear-gradient(150deg, var(--accent-soft), var(--surface) 70%); }
      .feature-cell a { display: flex; height: 100%; min-height: 178px; flex-direction: column; justify-content: space-between; gap: 26px; padding: 24px; }
      .feature-cell-1 a { min-height: 368px; justify-content: flex-start; gap: 20px; padding-bottom: 0; }
      .feature-cell-1 .feature-copy { margin-top: auto; }
      /* The lead tile's screenshot bleeds off the bottom edge of the cell so
         the tallest cell reads as a product shot, not an empty box. */
      .feature-visual { display: block; margin-top: 20px; }
      .feature-visual img {
        width: 100%; height: auto;
        border: 1px solid var(--line); border-top-left-radius: 12px; border-top-right-radius: 12px;
        border-bottom: 0; box-shadow: 0 -2px 24px rgba(24, 33, 48, .08);
      }
      .feature-icon { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 11px; background: var(--accent-soft); color: var(--accent); }
      .feature-icon > span { width: 20px; height: 20px; }
      .feature-arrow { position: absolute; top: 26px; right: 24px; width: 15px; height: 15px; color: var(--muted); transition: transform .2s ease; }
      .feature-cell:hover .feature-arrow { transform: translate(2px, -2px); }
      .feature-cell h3 { margin: 0; font-size: clamp(17px, 1.6vw, 21px); letter-spacing: -.025em; }
      .feature-cell p { margin: 8px 0 0; max-width: 40ch; color: var(--body); font-size: 14px; line-height: 1.5; }

      /* ---------- App tour ---------- */
      .app-tour { background: var(--surface-sunk); }
      .tour-lead { display: grid; gap: 34px; margin-top: 44px; }
      .tour-lead-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
      .tour-lead h3 { margin: 0; font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -.03em; }
      .tour-lead p { margin: 0; max-width: 52ch; color: var(--body); font-size: 16px; line-height: 1.62; }
      .tour-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 40px; }
      .tour-card { display: flex; flex-direction: column; gap: 20px; }
      .tour-card h3 { margin: 0; font-size: 21px; letter-spacing: -.028em; }
      .tour-card p { margin: 8px 0 0; color: var(--body); font-size: 14.5px; line-height: 1.6; }
      .tour-link { display: inline-flex; align-items: center; gap: 7px; margin-top: 16px; color: var(--accent); font-size: 14px; font-weight: 650; }
      .tour-link span { width: 14px; height: 14px; transition: transform .18s ease; }
      .tour-link:hover span { transform: translateX(3px); }

      /* ---------- Privacy teaser ---------- */
      .privacy-band {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(28px, 4vw, 56px); align-items: center;
        padding: clamp(30px, 3.4vw, 46px);
        border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface);
      }
      .privacy-icon { display: block; width: 28px; height: 28px; margin-bottom: 16px; color: var(--accent); }
      .privacy-band h2 { max-width: 14ch; font-size: clamp(25px, 2.7vw, 34px); }
      .privacy-band p { max-width: 48ch; margin: 0; color: var(--body); font-size: 16.5px; line-height: 1.65; }
      .privacy-band .tour-link { margin-top: 20px; }

      /* ---------- Download band ---------- */
      .download-band { border-top: 1px solid var(--line); background: var(--surface-sunk); }
      .download-inner { display: grid; justify-items: center; gap: 22px; padding-block: clamp(64px, 7vw, 92px); text-align: center; }
      .download-inner h2 { margin: 0; max-width: 18ch; font-size: clamp(28px, 3vw, 40px); line-height: 1.08; letter-spacing: -.038em; }
      .download-inner > p { max-width: 52ch; margin: 0; color: var(--body); font-size: 17px; line-height: 1.6; }
      .download-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 6px; }
      .download-note { margin: 4px 0 0; color: var(--muted); font-size: 13px; }

      /* ---------- Subscribe ---------- */
      .subscribe { border-top: 1px solid var(--line); }
      .subscribe-inner { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 64px); align-items: center; padding-block: clamp(60px, 6vw, 82px); }
      .subscribe h2 { margin: 0; font-size: clamp(26px, 3.2vw, 40px); line-height: 1.08; letter-spacing: -.038em; }
      .subscribe-copy { max-width: 46ch; margin: 14px 0 0; color: var(--body); line-height: 1.6; }
      .subscribe-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: end; }
      .field { display: grid; gap: 8px; min-width: 0; }
      .field label { color: var(--body); font-size: 13px; font-weight: 620; }
      .field input { width: 100%; height: 48px; padding: 0 16px; border: 1px solid var(--line-strong); border-radius: var(--r-field); outline: none; background: var(--surface); color: var(--ink); }
      .field input::placeholder { color: var(--muted); }
      .field input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
      .subscribe-form .button { min-height: 48px; }
      .subscribe-status { grid-column: 1 / -1; min-height: 20px; margin: 0; color: var(--muted); font-size: 13px; }
      .subscribe-status[data-tone='error'] { color: #c0392b; }
      .subscribe-status[data-tone='success'] { color: var(--accent); }

      /* ---------- Footer ---------- */
      .site-footer { border-top: 1px solid var(--line); background: var(--surface-sunk); }
      .footer-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: start; padding-block: 44px 28px; }
      .footer-brand p { max-width: 34ch; margin: 14px 0 0; color: var(--muted); font-size: 13.5px; line-height: 1.55; }
      .footer-cols { display: grid; grid-template-columns: repeat(3, minmax(120px, auto)); gap: 40px; }
      .footer-cols h2 { margin: 0 0 12px; color: var(--ink); font-size: 12px; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
      .footer-cols ul { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
      .footer-cols a { color: var(--body); font-size: 13.5px; }
      .footer-cols a:hover { color: var(--ink); }
      .footer-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 18px 30px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }

      /* ---------- Feature detail pages ---------- */
      .feature-hero { max-width: 46rem; padding-block: clamp(60px, 7vw, 96px) 52px; }
      .feature-hero h1 { margin: 0; font-size: clamp(36px, 4vw, 54px); font-weight: 680; line-height: 1.04; letter-spacing: -.045em; }
      .feature-hero > p { max-width: 52ch; margin: 20px 0 0; color: var(--body); font-size: clamp(16px, 1.4vw, 18px); line-height: 1.6; }
      .feature-layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(32px, 6vw, 80px); padding-block: 56px 84px; border-top: 1px solid var(--line); }
      .feature-layout h2 { margin: 0 0 18px; font-size: clamp(24px, 3vw, 36px); letter-spacing: -.035em; }
      .feature-layout p { max-width: 56ch; margin: 0 0 16px; color: var(--body); font-size: 16.5px; line-height: 1.68; }
      .feature-fact { align-self: start; padding: 26px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); }
      .feature-fact strong { display: block; margin-top: 16px; font-size: 22px; letter-spacing: -.03em; }
      .feature-fact span:last-child { display: block; margin-top: 8px; color: var(--body); font-size: 14.5px; line-height: 1.55; }
      .feature-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 28px 0 96px; padding: 0; list-style: none; }
      .feature-list a { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 92px; padding: 20px 24px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); transition: border-color .2s ease, transform .2s ease; }
      .feature-list a:hover { border-color: var(--line-strong); transform: translateY(-2px); }
      .feature-list strong { font-size: 15.5px; letter-spacing: -.015em; }

      /* ---------- Use case pages ---------- */
      .usecase-list { display: grid; gap: 12px; margin: 28px 0 96px; padding: 0; list-style: none; }
      .usecase-list a {
        display: grid; grid-template-columns: 46px minmax(0, 1fr) 20px; gap: 20px; align-items: center;
        padding: 22px 24px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface);
        transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
      }
      .usecase-list a:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
      .usecase-icon { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 13px; background: var(--accent-soft); color: var(--accent); }
      .usecase-icon > span { width: 22px; height: 22px; }
      .usecase-copy strong { display: block; font-size: 17px; letter-spacing: -.022em; }
      .usecase-copy > span { display: block; margin-top: 5px; max-width: 62ch; color: var(--body); font-size: 14.5px; line-height: 1.55; }
      .usecase-arrow { width: 20px; height: 20px; color: var(--muted); transition: transform .2s ease; }
      .usecase-list a:hover .usecase-arrow { transform: translateX(3px); }

      .usecase-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 44px; }
      .usecase-tile {
        position: relative; display: block; padding: 24px;
        border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface);
        transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
      }
      .usecase-tile:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
      .usecase-tile h3 { margin: 18px 0 0; font-size: 18px; letter-spacing: -.025em; }
      .usecase-tile p { margin: 8px 0 0; max-width: 38ch; color: var(--body); font-size: 14px; line-height: 1.5; }
      .usecase-tile-all { background: linear-gradient(150deg, var(--accent-soft), var(--surface) 70%); }
      .usecase-tile-all .usecase-icon { background: var(--accent); color: var(--on-accent); }
      .usecase-tile-all .usecase-arrow { position: absolute; top: 26px; right: 24px; width: 15px; height: 15px; }

      .usecase-steps { display: grid; gap: 26px; margin: 0; padding: 0; list-style: none; counter-reset: none; }
      .usecase-steps li { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 16px; }
      .usecase-step-index { color: var(--accent); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: .04em; line-height: 1.7; }
      .usecase-steps strong { display: block; font-size: 17px; letter-spacing: -.022em; }
      .usecase-steps p { margin: 8px 0 0; max-width: 56ch; color: var(--body); font-size: 15.5px; line-height: 1.62; }

      /* Not a `.section`, so it needs the heading scale spelled out to match
         the band above it. */
      .usecase-reclaim { padding-block: 8px 84px; }
      .usecase-reclaim h2 { margin: 0; font-size: clamp(24px, 3vw, 36px); line-height: 1.1; letter-spacing: -.035em; }
      .reclaim-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 36px; }
      .reclaim-card { padding: 26px; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--surface); }
      .reclaim-card h3 { margin: 0 0 16px; font-size: 17px; letter-spacing: -.022em; }
      .reclaim-card ul { display: grid; gap: 11px; margin: 0; padding: 0; list-style: none; }
      .reclaim-card li { display: grid; grid-template-columns: 16px minmax(0, 1fr); gap: 11px; color: var(--body); font-size: 14.5px; line-height: 1.5; }
      .reclaim-tick { width: 16px; height: 16px; margin-top: 3px; color: var(--accent); }

      /* ---------- Prose (privacy page) ---------- */
      .prose { max-width: 68ch; padding-bottom: 96px; }
      .prose h2 { margin: 44px 0 12px; font-size: clamp(21px, 2.2vw, 26px); letter-spacing: -.028em; }
      .prose p, .prose li { color: var(--body); font-size: 16.5px; line-height: 1.7; }
      .prose p { margin: 0 0 14px; }
      .prose ul { margin: 0 0 14px; padding-left: 20px; display: grid; gap: 8px; }
      .prose strong { color: var(--ink); font-weight: 620; }

      /* ---------- Responsive ---------- */
      @media (max-width: 1000px) {
        .site-nav { height: 62px; }
        .desktop-nav, .nav-actions { display: none; }
        .nav-burger { display: inline-flex; }
        .mega-panel { display: none; }
        .mobile-sheet {
          display: block; overflow: hidden;
          max-height: 0; border-top: 1px solid transparent;
          background: var(--surface);
          transition: max-height .26s ease, border-color .26s ease;
        }
        /* Tall enough for every link plus both actions; scrolls rather than
           clipping the download button on short viewports. */
        .mobile-sheet[data-open='true'] { max-height: min(78vh, 620px); overflow-y: auto; border-top-color: var(--line); }
        .mobile-sheet-inner { padding-block: 18px 24px; }
        .mobile-sheet-label { margin: 0 0 10px; color: var(--muted); font-size: 12px; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
        .mobile-sheet-label-spaced { margin-top: 16px; }
        .mobile-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
        .mobile-links-wide { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
        .mobile-actions { display: grid; gap: 10px; margin-top: 18px; }
        .hero { grid-template-columns: minmax(0, 1fr); padding-block: 48px 56px; }
        .hero-copy { max-width: 640px; }
        .spec-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
        .feature-grid, .usecase-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .feature-cell, .feature-cell-1 { grid-column: span 1; grid-row: auto; }
        .feature-cell-1 { grid-column: span 2; }
        .feature-cell-1 a { min-height: 240px; }
        .tour-lead-copy, .tour-pair, .privacy-band, .subscribe-inner, .feature-layout, .feature-list, .reclaim-grid { grid-template-columns: minmax(0, 1fr); }
        .footer-inner { grid-template-columns: minmax(0, 1fr); }
      }
      @media (max-width: 640px) {
        .site-container { width: min(100% - 32px, 1180px); }
        .hero h1 { font-size: clamp(34px, 9.5vw, 46px); }
        .spec-row { grid-template-columns: minmax(0, 1fr); }
        .feature-grid, .usecase-strip { grid-template-columns: minmax(0, 1fr); }
        .feature-cell-1, .feature-cell-2, .feature-cell-7 { grid-column: span 1; }
        .feature-cell a, .feature-cell-1 a { min-height: 190px; }
        .app-window { border-radius: 14px; }
        .app-window-bar { height: 32px; }
        .subscribe-form { grid-template-columns: minmax(0, 1fr); }
        .subscribe-form .button { width: 100%; }
        .footer-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
        .footer-base { flex-direction: column; align-items: flex-start; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
      }
      @media (prefers-reduced-transparency: reduce) {
        .site-nav-wrap { background: var(--page); backdrop-filter: none; -webkit-backdrop-filter: none; }
      }

      @yield('styles')
    </style>
  </head>
  <body>
    <MarketingNav />
    <main data-stx-content>
      @yield('content')
    </main>
    <MarketingSubscribe />
    <MarketingFooter />
  </body>
</html>
