<script server>
// The app shell is a control plane for the Mac this process runs on. The same
// STX application also serves the public marketing site, where there is no
// such Mac — so off-agent the shell renders a download prompt instead of a
// dashboard built from a shared web server's disk.
const { isLocalAgent } = require('~/app/Support/Runtime/local-agent')
const localAgent = isLocalAgent()
</script>

<!DOCTYPE html>
<html lang='en'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>SystemCleaner</title>
  @appearanceBootstrap({
    storageKey: 'systemcleaner-appearance',
    appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
    colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
  })
  <style>
    :root {
      color-scheme: light;
      --app-bg: #f5f5f7;
      --surface: #ffffff;
      --surface-soft: #eeeef1;
      --surface-inset: #e9e9ed;
      --line: rgba(60, 60, 67, .14);
      --line-soft: rgba(60, 60, 67, .08);
      --ink: #1d1d1f;
      --secondary: #6e6e73;
      --tertiary: #8e8e93;
      --track: #d8d8dd;
      --hover: rgba(0, 0, 0, .035);
      --pressed: rgba(0, 0, 0, .075);
      --accent: #007aff;
      --green: #248a3d;
      --orange: #c45d00;
      --red: #d70015;
      --purple: #8944ab;
      --shadow: 0 10px 30px rgba(0, 0, 0, .12);
    }
    :root.dark {
      color-scheme: dark;
      --app-bg: #1a1a1c;
      --surface: #242426;
      --surface-soft: #2c2c2e;
      --surface-inset: #202022;
      --line: rgba(255, 255, 255, .1);
      --line-soft: rgba(255, 255, 255, .055);
      --ink: #f5f5f7;
      --secondary: #98989d;
      --tertiary: #6c6c70;
      --track: #3a3a3c;
      --hover: rgba(255, 255, 255, .045);
      --pressed: rgba(255, 255, 255, .1);
      --accent: #0a84ff;
      --green: #30d158;
      --orange: #ff9f0a;
      --red: #ff453a;
      --purple: #bf5af2;
      --shadow: 0 14px 38px rgba(0, 0, 0, .38);
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%; overflow: hidden; background: var(--app-bg); color: var(--ink);
      font-family: -apple-system, 'SF Pro Text', BlinkMacSystemFont, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .1s; }
    ::view-transition-group(root) { background: var(--app-bg); }
    [data-stx-content] { min-height: 100%; background: var(--app-bg); }
    [x-cloak] { display: none !important; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { border-radius: 3px; background: var(--line); }

    .app-chrome { display: flex; width: 100vw; height: 100vh; flex-direction: column; overflow: hidden; background: var(--app-bg); }
    .app-body { display: flex; min-width: 0; flex: 1; overflow: hidden; }

    /* ---------- Vibrant rail ---------- */
    /* Craft draws an NSVisualEffectView behind the leftmost 74px of the web
       view when the launcher asks for `--web-sidebar-material`, and stamps
       `data-craft-native-sidebar` on the root element when it has. That marker
       is the whole switch: in a Craft window the shell goes transparent so the
       material shows through under the rail, and in a browser — the marketing
       site renders this same shell — nothing changes and the rail keeps the
       page's own fill.

       Only the rail strip is uncovered. The content column paints `--app-bg`
       over itself, so the material stops where Finder's sidebar stops, with a
       hairline in the same place Finder puts one. */
    :root[data-craft-native-sidebar] body,
    :root[data-craft-native-sidebar] .app-chrome { background: transparent; }
    :root[data-craft-native-sidebar] .app-column {
      background: var(--app-bg);
      border-left: 0.5px solid var(--line-soft);
    }

    /* ---------- Inactive window ---------- */
    /* A Mac window that is not in front goes quiet. AppKit does that for the
       window buttons on its own — they grey out — but everything the page
       draws keeps shouting: a saturated blue selection pill on a sidebar the
       user is no longer looking at, next to three grey buttons that have
       already stood down. Finder does not do that; its selected row drops to
       a neutral fill and its icons desaturate, so the whole sidebar recedes
       together.

       `data-craft-window-active="false"` is stamped on the root element by the
       Craft runtime, which is the only thing that can see the window server. Colour is the only thing that changes —
       nothing moves, so returning to the window does not reflow it. */
    /* Colour, not opacity. Fading an icon that is `color: var(--accent)`
       leaves it pale blue, which reads as a disabled control rather than an
       inactive window — Finder's icons go grey at full strength. So the rail
       drops to the neutral it would have had if it had never been tinted. */
    :root[data-craft-window-active='false'] .rail-item { color: var(--secondary); }
    :root[data-craft-window-active='false'] .rail-item[data-active] {
      background: var(--surface-soft);
      color: var(--ink);
      box-shadow: none;
    }
    /* The mark is artwork rather than a tinted glyph, so `color` cannot reach
       it and it would sit there as the one saturated thing left in a sidebar
       that has otherwise stood down. */
    :root[data-craft-window-active='false'] .rail-brand img { filter: grayscale(1); opacity: .75; }
    :root[data-craft-window-active='false'] .topnav-item { color: var(--secondary); }
    :root[data-craft-window-active='false'] .topnav-item[data-active] {
      background: var(--surface-soft);
      color: var(--ink);
    }
    .rail-item, .rail-icon, .topnav-item, .rail-brand img {
      transition: background .18s ease, color .18s ease, opacity .18s ease, box-shadow .18s ease, filter .18s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .rail-item, .rail-icon, .topnav-item, .rail-brand img { transition: none; }
    }
    .app-column { display: flex; flex: 1; flex-direction: column; min-width: 0; }
    .main { min-width: 0; flex: 1; overflow-y: auto; background: var(--app-bg); }

    /* ---------- Top strip ---------- */
    /* Sits beside the traffic lights rather than below them: the lights are
       over the rail's top-left corner, and this strip fills the rest of that
       same band, which is where a Mac app with a sidebar puts its toolbar.

       The height is what puts the two on one line, and it is a centring
       problem rather than a clearance one. Craft publishes where the buttons
       start (`inset-y`) and how tall they are, so their centre is
       `inset-y + height / 2` — and a flex row centres its children on
       `height / 2`. Equate the two and the height falls out as
       `2 * inset-y + height`. What stood here was `inset-y + height + 12`,
       which is the buttons' *bottom* plus a margin: it clears them, which is a
       different question from sitting on their line.

       `max()` keeps a 52px floor for the browser, where the marketing site
       renders this same shell, there are no window controls, and both
       variables read as 0.

       That floor is the normal case here, not an edge one, which the height
       alone does not survive. Measured in the window, the lights' centre sits
       about 16pt below the top, so `2 * inset-y + height` comes to roughly 31
       — under the floor. The band is then 52 tall and a centred row lands
       about 11pt *below* the lights rather than on them.

       (The 23px quoted further down this file is not a measurement of this
       window — it is what Craft's own overlay test fixture produces, inset-y 9
       plus button height 14. It happens to give the rail a clearance that
       works, so it stays; do not "correct" this band to match it.)

       So when the floor wins, take the difference back off the bottom: the
       content box becomes exactly the lights' own band, and a centred row
       lands on their centre.

       The `min()` is what keeps that honest in a browser. The correction
       `52px - 2*inset-y - height` is 52 when both variables are absent, which
       would pad the entire strip away on the marketing site; `2*inset-y +
       height` is 0 in that same case. Taking the smaller of the two gives 0
       where there are no window controls, the real correction where the floor
       wins, and a negative that `max()` clamps to 0 where it does not. No
       attribute gate, so this does not depend on which Craft version is
       bundled. */
    .topnav {
      display: flex; align-items: center; justify-content: flex-end;
      flex: none; gap: 4px; padding: 0 20px;
      height: max(52px, calc(2 * var(--craft-window-controls-inset-y, 0px) + var(--craft-window-controls-height, 0px)));
      padding-bottom: max(0px, min(
        calc(52px - 2 * var(--craft-window-controls-inset-y, 0px) - var(--craft-window-controls-height, 0px)),
        calc(2 * var(--craft-window-controls-inset-y, 0px) + var(--craft-window-controls-height, 0px))
      ));
      background: var(--app-bg);
    }
    .topnav-items { display: flex; align-items: center; gap: 4px; }
    .topnav-item {
      display: flex; align-items: center; gap: 6px;
      padding: 5px 11px; border-radius: 8px;
      color: var(--secondary); font-size: 12px; font-weight: 550;
      text-decoration: none; white-space: nowrap;
      transition: background .12s, color .12s;
    }
    .topnav-item:hover { background: var(--hover); color: var(--ink); }
    .topnav-item[data-active] { background: var(--surface-soft); color: var(--ink); }
    .topnav-icon { width: 14px; height: 14px; flex: none; }
    /* The label is the point of putting these up here; below this the strip
       would start eating the page title, so drop to icons alone. The badge is
       not a label — it is the whole reason Updates is in this bar — so it
       stays. */
    @media (max-width: 760px) {
      .topnav-item span:not(.topnav-icon):not(.topnav-badge) { display: none; }
      .topnav-item { padding: 5px 8px; }
      .profile-text { display: none; }
    }

    /* The count on Updates. Sized to hold two digits without changing the
       row's height, so the strip does not reflow when the number arrives. */
    .topnav-badge {
      min-width: 17px; height: 17px; padding: 0 5px;
      border-radius: 9px;
      background: var(--orange); color: #fff;
      font-size: 10px; font-weight: 700; line-height: 17px;
      text-align: center; font-variant-numeric: tabular-nums;
    }
    .topnav-badge[hidden] { display: none; }

    /* ---------- Profile chip ---------- */
    /* At the trailing end, after the nav — see AppTopNav.stx for why: Craft's
       own toolbar owns the leading end of this band and draws over anything
       put there. The rule separates it from the nav so it reads as a control
       rather than as a fifth link. */
    .profile-chip {
      display: flex; align-items: center; gap: 8px;
      margin-left: 10px; padding: 4px 10px 4px 10px;
      border: 0; border-left: .5px solid var(--line); border-radius: 0;
      background: transparent; color: var(--secondary);
      font-family: inherit; text-align: left; cursor: pointer;
      transition: background .12s, color .12s;
    }
    .profile-chip[hidden] { display: none; }
    .profile-chip:hover { background: var(--hover); color: var(--ink); }
    .profile-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    .profile-avatar {
      display: grid; width: 24px; height: 24px; flex: none; place-items: center;
      border-radius: 50%; overflow: hidden;
      background: var(--surface-soft); color: var(--secondary);
      font-size: 11px; font-weight: 650;
    }
    .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .profile-text { display: flex; flex-direction: column; line-height: 1.15; }
    .profile-name { font-size: 12px; font-weight: 600; color: var(--ink); }
    .profile-host { font-size: 10px; color: var(--tertiary); }

    /* Inactive window: colour, not opacity — a faded tint reads as a disabled
       control, where grey reads as a window that has stood down. */
    :root[data-craft-window-active='false'] .profile-name { color: var(--secondary); }
    :root[data-craft-window-active='false'] .profile-avatar img { filter: grayscale(1); opacity: .8; }
    :root[data-craft-window-active='false'] .topnav-badge { background: var(--tertiary); }
    .profile-chip, .profile-avatar img, .topnav-badge {
      transition: background .18s ease, color .18s ease, filter .18s ease, opacity .18s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .profile-chip, .profile-avatar img, .topnav-badge { transition: none; }
    }

    /* ---------- Collapsed sidebar ---------- */
    /* Craft's toolbar carries a sidebar button, and it did nothing here.
       The runtime's own user script answers that click by stamping
       `data-sidebar-collapsed` on the root element and injecting
       `html[data-sidebar-collapsed] body { padding-left: 128px }` — a pad
       sized for its default 286px native sidebar, on a shell whose rail is
       74px and which lays itself out with flex rather than with body padding.
       Nothing here read the attribute, so the button moved nothing; the pad
       would have shoved the whole window sideways if anything had.

       So: honour the attribute, and neutralise the pad. The rail collapses to
       nothing and the content takes the width, which is what the button in a
       Mac toolbar means. `data-sidebar-collapsed` is Craft's, like
       `data-craft-window-active` — this rule reads it and claims nothing else
       about the root element. */
    html[data-sidebar-collapsed] body { padding-left: 0 !important; }
    :root[data-sidebar-collapsed] .rail {
      width: 0; min-width: 0;
      padding-left: 0; padding-right: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
    }
    /* The window buttons stay where AppKit drew them, so the strip has to keep
       their room clear once the rail is no longer doing it.

       `--craft-window-controls-width` is already the room to leave, measured
       from the viewport's left edge rather than from the buttons — so adding
       the inset to it counted the same gap twice. It also covers Craft's own
       toolbar row now (the sidebar toggle and the history arrows), which the
       runtime under-reported until craft#cc781de: it answered 69 for a row
       that reaches 189, and anything placed in between sat under real
       NSButtons. */
    :root[data-sidebar-collapsed] .topnav {
      padding-left: calc(var(--craft-window-controls-width, 0px) + 16px);
    }
    :root[data-sidebar-collapsed] .app-column { border-left: 0; }
    .rail { transition: width .2s ease, opacity .2s ease, padding .2s ease; }
    @media (prefers-reduced-motion: reduce) {
      .rail { transition: none; }
    }
    .main-header { position: sticky; top: 0; z-index: 10; padding: 24px 28px 12px; background: linear-gradient(to bottom, var(--app-bg) 72%, transparent); }

    /* ---------- Icon rail ---------- */
    /* No fill and no divider: the rail sits on the same surface as the
       content column so the two read as one canvas, and the only thing that
       draws a shape is the selected button. */
    /*
       The window has no titlebar, so its close/minimise/zoom buttons sit in
       this rail's top-left corner — the arrangement every Mac app with a
       sidebar uses. Two consequences, and neither of them is a number typed in
       here:

       1. The first rail button starts below them. Craft publishes the buttons'
          size *and* their inset from the corner, and the clearance needs both:
          height alone put the brand mark 5px into the buttons, because the
          inset is where they start, not where the window does. The rail adds its own
          breathing room to that. On macOS 27 the measurement is 23px, which
          puts the brand mark at 31px — where 16px would have run it under the
          buttons by seven. `max()` keeps the old 16px wherever nothing is
          published: a browser, which has no window buttons, or a Craft old
          enough not to say where its own are.
       2. This rail is part of the window's drag handle, which the script at
          the end of this file wires up. Not `-webkit-app-region: drag`: that
          property is Chromium's, WebKit does not implement it, and a WKWebView
          drops it on the floor — `style.setProperty('-webkit-app-region')`
          reads back as the empty string. Written that way, the rail looks
          draggable in the stylesheet and the window cannot be moved at all. */
    .rail {
      display: flex; width: 74px; min-width: 74px; height: 100%;
      flex-direction: column; align-items: center; gap: 22px;
      padding: max(16px, calc(var(--craft-window-controls-inset-y, 0px) + var(--craft-window-controls-height, 0px) + 8px)) 0 14px;
      background: transparent;
    }
    .rail-brand { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 13px; }
    .rail-brand img { width: 28px; height: 28px; }
    /* Groups are separated by space alone. A rule between 46px buttons reads
       as a stray underline rather than a divider. */
    .rail-groups { display: flex; flex: 1; flex-direction: column; gap: 22px; min-height: 0; overflow-y: auto; scrollbar-width: none; }
    .rail-groups::-webkit-scrollbar { width: 0; height: 0; }
    .rail-group { display: flex; flex-direction: column; gap: 8px; }
    .rail-foot { display: flex; flex-direction: column; gap: 8px; }

    .rail-item {
      position: relative; display: grid; width: 46px; height: 46px; place-items: center;
      border-radius: 14px; color: var(--accent); text-decoration: none;
      transition: background .14s ease, color .14s ease, transform .14s ease;
    }
    .rail-item:hover { background: var(--hover); }

    /* A scan keeps running after you leave its screen. The dot is the only
       thing that says so from anywhere else in the app. */
    .rail-item[data-scanning]::after {
      content: '';
      position: absolute;
      top: 5px;
      right: 5px;
      width: 6px;
      height: 6px;
      border: 1.5px solid var(--surface);
      border-radius: 50%;
      background: var(--accent);
      animation: rail-scan-pulse 1.6s ease-in-out infinite;
    }
    @keyframes rail-scan-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
    @media (prefers-reduced-motion: reduce) {
      .rail-item[data-scanning]::after { animation: none; }
    }
    .rail-item:active { transform: scale(.95); }
    .rail-item[data-active] { background: var(--accent); color: #fff; box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 34%, transparent); }
    .rail-item[data-active]:hover { background: var(--accent); }
    .rail-icon { width: 21px; height: 21px; }
    .rail-badge { color: var(--tertiary); cursor: default; }

    /* Labels moved into hover tooltips when the rail lost its text column. */
    .rail-tip {
      position: absolute; left: calc(100% + 10px); z-index: 50;
      padding: 5px 9px; border: .5px solid var(--line); border-radius: 7px;
      background: var(--surface); color: var(--ink); box-shadow: var(--shadow);
      font-size: 11px; font-weight: 500; white-space: nowrap;
      opacity: 0; pointer-events: none; transform: translateX(-4px);
      transition: opacity .14s ease, transform .14s ease;
    }
    .rail-item:hover .rail-tip, .rail-item:focus-visible .rail-tip { opacity: 1; transform: translateX(0); }
    .rail-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .main-title { font-size: 22px; font-weight: 700; letter-spacing: -.02em; }
    .main-subtitle { margin-top: 2px; color: var(--secondary); font-size: 12px; }
    .main-content { padding: 0 28px 32px; }

    .card-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .card, .tbl-wrap, .disk-card { border: .5px solid var(--line); background: var(--surface); }
    .card { padding: 18px; border-radius: 16px; transition: border-color .15s, box-shadow .15s; }
    .card:hover { border-color: color-mix(in srgb, var(--ink) 22%, transparent); box-shadow: 0 4px 18px rgba(0, 0, 0, .045); }
    .card-label { margin-bottom: 6px; color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .3px; text-transform: uppercase; }
    .card-value { font-size: 24px; font-weight: 700; letter-spacing: -.02em; }
    .card-detail { margin-top: 3px; color: var(--secondary); font-size: 11px; }
    .progress, .cpu-track, .folder-bar-track, .info-bar-track, .disk-usage-bar { overflow: hidden; border-radius: 3px; background: var(--track); }
    .progress { height: 5px; margin-top: 6px; }
    .progress-fill { height: 100%; border-radius: 3px; transition: width .6s ease; }

    .tbl-wrap { overflow: hidden; margin-bottom: 20px; border-radius: 16px; }
    .tbl-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: .5px solid var(--line); }
    .tbl-title { font-size: 14px; font-weight: 600; }
    .tbl-count, .updating-label { color: var(--secondary); font-size: 11px; }
    .tbl-count { margin-left: 8px; }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 8px 14px; border-bottom: .5px solid var(--line); background: var(--hover); color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .3px; text-align: left; text-transform: uppercase; }
    tbody td { padding: 8px 14px; border-bottom: .5px solid var(--line-soft); font-size: 12px; vertical-align: middle; }
    tbody tr { transition: background .1s; }
    tbody tr:hover { background: var(--hover); }
    tbody tr:last-child td { border-bottom: none; }

    .badge { display: inline-flex; padding: 2px 7px; border-radius: 4px; font-size: 10px; font-weight: 500; }
    .badge-green { background: color-mix(in srgb, var(--green) 12%, transparent); color: var(--green); }
    .badge-orange { background: color-mix(in srgb, var(--orange) 12%, transparent); color: var(--orange); }
    .badge-red { background: color-mix(in srgb, var(--red) 12%, transparent); color: var(--red); }
    .badge-purple { background: color-mix(in srgb, var(--purple) 12%, transparent); color: var(--purple); }
    .badge-gray { background: color-mix(in srgb, var(--tertiary) 12%, transparent); color: var(--secondary); }
    .badge-blue { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
    .action-cell { min-width: 88px; white-space: nowrap; }

    .btn { padding: 4px 12px; border: .5px solid var(--line); border-radius: 6px; background: var(--surface-soft); color: var(--ink); cursor: pointer; font-family: inherit; font-size: 11px; font-weight: 500; transition: background .1s, border-color .1s; }
    .btn:hover { background: var(--pressed); }
    .btn-danger { border-color: color-mix(in srgb, var(--red) 25%, transparent); background: color-mix(in srgb, var(--red) 10%, transparent); color: var(--red); }
    .btn-danger:hover { background: color-mix(in srgb, var(--red) 18%, transparent); }
    .btn-sm { padding: 2px 8px; font-size: 10px; }
    .btn-icon { display: inline-flex; align-items: center; gap: 5px; }
    .btn-icon > span[class*='i-f7-'] { width: 12px; height: 12px; }
    .toast-glyph { width: 14px; height: 14px; flex-shrink: 0; }
    .view-link { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); font-size: 13px; }
    .view-link > span { width: 13px; height: 13px; }
    .btn-active { border-color: color-mix(in srgb, var(--accent) 32%, transparent); background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }

    .cpu-bar { display: flex; align-items: center; gap: 6px; }
    /* Fixed, not `flex: 1` capped at 60px. A flex-basis of zero surrenders every
       pixel when the column is tight, and the CPU column is tight on any window
       narrower than the one this was designed against: the percentage label's
       36px plus the gap took the whole cell, and the bar rendered at zero width.
       A bar that vanishes as the window narrows is worse than no bar. */
    .cpu-track { flex: none; width: 60px; height: 3px; }
    .cpu-fill { height: 100%; border-radius: 2px; }
    .mono { font-family: 'SF Mono', Menlo, monospace; }
    .dim, .item-sub, .ring-label { color: var(--secondary); }
    .item-name { font-weight: 500; }
    .item-sub { font-size: 10px; }
    .item-row { display: flex; align-items: center; gap: 6px; }
    .item-glyph { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent); }
    .run-at-load { display: inline-block; width: 13px; height: 13px; color: var(--green); }
    .item-path { max-width: 220px; overflow: hidden; color: var(--tertiary); font: 10px 'SF Mono', Menlo, monospace; text-overflow: ellipsis; white-space: nowrap; }
    .check { width: 14px; height: 14px; accent-color: var(--accent); cursor: pointer; }
    .empty-state { padding: 40px 16px; color: var(--tertiary); font-size: 13px; text-align: center; }

    .tabs { display: flex; width: fit-content; overflow: hidden; gap: 1px; margin-bottom: 16px; border-radius: 7px; background: var(--track); }
    .tab { padding: 6px 16px; border: 0; background: var(--surface); color: var(--secondary); cursor: pointer; font-family: inherit; font-size: 12px; font-weight: 500; transition: background .15s, color .15s; }
    .tab:first-child { border-radius: 7px 0 0 7px; }
    .tab:last-child { border-radius: 0 7px 7px 0; }
    .tab.active { background: var(--accent); color: #fff; }
    .tab:hover:not(.active) { background: var(--hover); color: var(--ink); }
    .panel { display: none; }
    .panel.active { display: block; }

    .toast-area { position: fixed; top: 24px; right: 24px; z-index: 100; display: flex; flex-direction: column; gap: 6px; }
    .toast { display: flex; align-items: center; gap: 6px; padding: 10px 16px; border: .5px solid var(--line); border-radius: 9px; background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--shadow); backdrop-filter: blur(20px); font-size: 12px; font-weight: 500; animation: toastIn .25s ease, toastOut .25s ease 2.5s forwards; }
    @keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes toastOut { to { opacity: 0; transform: translateX(30px); } }

    .health-ring { position: relative; width: 88px; height: 88px; flex-shrink: 0; }
    .health-ring svg { width: 88px; height: 88px; transform: rotate(-90deg); }
    .ring-bg { fill: none; stroke: var(--track); stroke-width: 7; }
    .ring-fill { fill: none; stroke-width: 7; stroke-linecap: round; }
    .ring-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; }
    .ring-score { font-size: 20px; font-weight: 700; }
    .ring-label { font-size: 9px; }

    .disk-layout { display: flex; height: 100%; min-height: 520px; gap: 0; }
    .disk-sidebar, .disk-inspector { display: flex; width: 240px; min-width: 240px; flex-direction: column; overflow: hidden; }
    .disk-sidebar { border-right: .5px solid var(--line); }
    .disk-inspector { border-left: .5px solid var(--line); }
    .disk-sidebar-section { padding: 14px; }
    .disk-sidebar-section + .disk-sidebar-section { border-top: .5px solid var(--line); }
    .disk-chart { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; overflow: hidden; }
    .disk-chart::before { position: absolute; inset: 0; content: ''; pointer-events: none; background: radial-gradient(ellipse at center, var(--surface), var(--app-bg)); }
    .sunburst-svg { position: relative; z-index: 1; width: 100%; height: 100%; max-width: 640px; max-height: 640px; }
    .segment { stroke: var(--app-bg); stroke-width: .8; cursor: pointer; transition: opacity .18s, filter .18s; }
    .segment:hover { filter: brightness(1.08) saturate(1.12); }
    .sunburst-svg:has(.segment:hover) .segment:not(:hover) { opacity: .2; }
    .center-bg { fill: var(--app-bg); cursor: pointer; }
    .center-bg:hover { fill: var(--surface-soft); }
    .center-ring { fill: none; stroke: var(--line); stroke-width: .5; pointer-events: none; }
    .center-text-size { fill: var(--ink); font-size: 14px; font-weight: 600; text-anchor: middle; pointer-events: none; }
    .center-text-name { fill: var(--secondary); font-size: 10px; font-weight: 500; text-anchor: middle; pointer-events: none; }
    .center-back { fill: var(--secondary); font-size: 8px; text-anchor: middle; pointer-events: none; opacity: 0; transition: opacity .15s; }
    .center-bg:hover ~ .center-back { opacity: 1; }

    .folder-list { flex: 1; overflow-y: auto; padding: 0 14px 14px; }
    .folder-item { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 5px; cursor: default; transition: background .12s; }
    .folder-item:hover { background: var(--hover); }
    .folder-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .folder-name { flex: 1; overflow: hidden; color: var(--ink); font-size: 11px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
    .folder-size { flex-shrink: 0; color: var(--secondary); font-size: 10px; font-variant-numeric: tabular-nums; }
    .folder-bar-track { width: 40px; height: 3px; flex-shrink: 0; }
    .folder-bar-fill { height: 100%; border-radius: 2px; }

    .inspector-title { padding: 12px 14px; border-bottom: .5px solid var(--line); color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .4px; text-transform: uppercase; }
    .inspector-body { flex: 1; overflow-y: auto; padding: 14px; }
    .inspector-placeholder { display: flex; height: 100%; align-items: center; justify-content: center; color: var(--tertiary); font-size: 11px; text-align: center; }
    .info-card { animation: fadeSlide .15s ease; }
    @keyframes fadeSlide { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; } }
    .info-icon-row { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .info-type-icon { display: flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 8px; font-size: 11px; font-weight: 700; }
    .info-type-name { font-size: 13px; font-weight: 600; word-break: break-word; }
    .info-type-kind { margin-top: 1px; color: var(--secondary); font-size: 10px; }
    .info-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: .5px solid var(--line-soft); font-size: 11px; }
    .info-label { color: var(--secondary); }
    .info-value { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
    .info-path { margin-top: 10px; padding: 6px 8px; border-radius: 5px; background: var(--surface-soft); color: var(--secondary); font: 10px/1.4 'SF Mono', Menlo, monospace; word-break: break-all; }
    .info-bar { margin-top: 12px; }
    .info-bar-label { margin-bottom: 5px; color: var(--secondary); font-size: 10px; }
    .info-bar-track { height: 5px; }
    .info-bar-fill { height: 100%; border-radius: 3px; }
    .info-bar-text { margin-top: 3px; color: var(--secondary); font-size: 10px; text-align: right; }
    .info-drill { margin-top: 12px; padding: 6px 10px; border: .5px solid color-mix(in srgb, var(--accent) 18%, transparent); border-radius: 5px; background: color-mix(in srgb, var(--accent) 7%, transparent); color: var(--accent); font-size: 10px; text-align: center; }
    .disk-card { padding: 12px; border-radius: 8px; }
    /* Deliberately not a .disk-sidebar-section: those draw a divider above one
       another, which landed a rule flush on this card's own top border. */
    /* Fallback context menu, for a window with no native one to open (a
       browser tab, or a Craft build without nativeUI). Metrics copied from
       AppKit so the two do not look like different applications. */
    .ctx-menu { position: fixed; z-index: 9999; min-width: 190px; padding: 4px; border: .5px solid color-mix(in srgb, var(--ink) 16%, transparent); border-radius: 8px; background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: 0 8px 28px rgb(0 0 0 / .28); backdrop-filter: blur(24px) saturate(180%); }
    .ctx-header { padding: 5px 10px 4px; overflow: hidden; color: var(--tertiary); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
    .ctx-item { display: block; width: 100%; padding: 4px 10px; border: 0; border-radius: 4px; background: none; color: var(--ink); font: inherit; font-size: 12px; text-align: left; cursor: default; }
    .ctx-item:hover, .ctx-item:focus { background: var(--accent); color: #fff; outline: none; }
    .ctx-item.is-danger { color: var(--red); }
    .ctx-item.is-danger:hover, .ctx-item.is-danger:focus { background: var(--red); color: #fff; }
    .ctx-sep { margin: 4px 8px; border-top: .5px solid color-mix(in srgb, var(--ink) 14%, transparent); }

    .disk-notice-wrap { padding: 0 14px 14px; }
    .disk-notice { padding: 8px 10px; border: .5px solid color-mix(in srgb, var(--orange) 30%, transparent); border-radius: 6px; background: color-mix(in srgb, var(--orange) 10%, var(--surface)); color: var(--secondary); font-size: 10px; line-height: 1.45; }

    .disk-usage-bar { height: 5px; margin: 8px 0 6px; }
    /* Coloured by how full it is, not by a fixed gradient. The old bar ran
       blue to green, so a disk at 99% ended in the colour that means "fine" —
       on the one screen whose job is to say otherwise. */
    .disk-usage-fill { height: 100%; border-radius: 3px; background: var(--green); transition: background .2s ease; }
    .disk-usage-fill.is-tight { background: var(--orange); }
    .disk-usage-fill.is-critical { background: var(--red); }
    .disk-usage-text { display: flex; justify-content: space-between; color: var(--secondary); font-size: 10px; }

    .breadcrumb { display: flex; align-items: center; gap: 2px; margin-bottom: 12px; font-size: 11px; }
    .bc-item { padding: 2px 6px; border-radius: 4px; color: var(--secondary); cursor: pointer; font-weight: 500; }
    .bc-item:hover { background: var(--hover); color: var(--ink); }
    .bc-item.active { color: var(--ink); cursor: default; }
    .bc-sep { color: var(--tertiary); font-size: 9px; }
    .statusbar { display: flex; height: 26px; min-height: 26px; align-items: center; gap: 14px; padding: 0 14px; border-top: .5px solid var(--line); background: var(--surface-soft); color: var(--secondary); font-size: 10px; }
    .statusbar-dot { display: inline-block; width: 5px; height: 5px; margin-right: 4px; border-radius: 50%; }
    .statusbar-spacer { flex: 1; }

    @media (max-width: 1000px) { .disk-inspector { display: none; } }
    @media (max-width: 700px) { .disk-sidebar, .sidebar { display: none; } }

    /* Real app icons, rendered from each bundle's .icns by /api/app-icon.
       `app-icon-missing` is set by the img's onerror: a CLI-only package has
       no .app and so no icon, and an empty box reads as a broken image rather
       than as "this one has no icon". */
    /* Quick Clean: a size is dim until it is real, so a column of placeholders
       reads as pending rather than as data. Same for the headline total, which
       must not be green — the success colour — while it is still scanning. */
    .clean-total.is-scanning { color: var(--secondary); }
    .clean-total { color: var(--green); }
    .clean-size { font-weight: 600; font-variant-numeric: tabular-nums; }
    .clean-size.is-pending { color: var(--tertiary); font-weight: 400; }
    /* Category filter above the Quick Clean table. Plain buttons, because the
       list is long enough that a second control style would be noise. */
    .filter-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
    .cap { text-transform: capitalize; }

    .app-icon { width: 18px; height: 18px; flex-shrink: 0; border-radius: 4px; object-fit: contain; }
    .app-icon-missing { visibility: hidden; }

    .offsite-shell { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 40px; text-align: center; }
    .offsite-shell h1 { font-size: 19px; font-weight: 600; }
    .offsite-shell p { max-width: 46ch; color: var(--secondary); font-size: 13px; line-height: 1.5; }
    .offsite-shell .btn { margin-top: 6px; padding: 8px 20px; font-size: 13px; text-decoration: none; }

    /* ---------- Settings panel ---------- */
    /* A sheet, not a page. It is modal to the window the way an NSPanel is,
       and it sits over the whole shell rather than inside the content column,
       because ⌘, is not a navigation. */
    .settings-scrim {
      position: fixed; inset: 0; z-index: 200;
      display: grid; place-items: start center;
      padding: 56px 20px 40px;
      background: rgba(0, 0, 0, .28);
      -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
    }
    .settings-scrim[hidden] { display: none; }
    .settings-panel {
      display: flex; flex-direction: column;
      width: min(520px, 100%); max-height: 100%;
      border: .5px solid var(--line); border-radius: 14px;
      background: var(--surface); box-shadow: var(--shadow);
      overflow: hidden;
    }
    .settings-head {
      display: flex; align-items: center; justify-content: space-between;
      flex: none; gap: 12px; padding: 16px 18px 12px;
      border-bottom: .5px solid var(--line-soft);
    }
    .settings-title { font-size: 15px; font-weight: 650; letter-spacing: -.01em; }
    .settings-close {
      display: grid; width: 26px; height: 26px; place-items: center;
      border: 0; border-radius: 7px;
      background: transparent; color: var(--secondary);
      cursor: pointer; font-size: 13px;
    }
    .settings-close:hover { background: var(--hover); color: var(--ink); }
    .settings-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

    .settings-body { flex: 1; min-height: 0; overflow-y: auto; padding: 6px 18px 14px; }
    .settings-section { padding: 12px 0; }
    .settings-section + .settings-section { border-top: .5px solid var(--line-soft); }
    .settings-section-title {
      margin-bottom: 8px;
      color: var(--tertiary); font-size: 10px; font-weight: 700;
      letter-spacing: .06em; text-transform: uppercase;
    }
    .settings-section-hint { margin-top: 8px; color: var(--tertiary); font-size: 11px; }
    .settings-rows { display: flex; flex-direction: column; }
    .settings-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; padding: 9px 0; min-height: 40px;
    }
    .settings-row + .settings-row { border-top: .5px solid var(--line-soft); }
    .settings-row-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .settings-row-label { font-size: 13px; font-weight: 500; }
    .settings-row-hint { color: var(--tertiary); font-size: 11px; }

    /* Segmented control, the shape macOS uses for a small closed set. */
    .settings-segmented {
      display: flex; flex: none; gap: 2px; padding: 2px;
      border-radius: 8px; background: var(--surface-inset);
    }
    .settings-segment {
      padding: 4px 11px; border: 0; border-radius: 6px;
      background: transparent; color: var(--secondary);
      font-family: inherit; font-size: 12px; font-weight: 550;
      cursor: pointer; transition: background .12s, color .12s;
    }
    .settings-segment:hover { color: var(--ink); }
    .settings-segment[data-active] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 2px rgba(0, 0, 0, .12); }
    .settings-segment:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

    /* Switch. Sized and tinted like AppKit's, which is the control people
       expect next to a sentence that reads as an on/off. */
    .settings-switch {
      position: relative; flex: none;
      width: 38px; height: 22px; padding: 0;
      border: 0; border-radius: 11px;
      background: var(--track); cursor: pointer;
      transition: background .16s ease;
    }
    .settings-switch[data-on] { background: var(--green); }
    .settings-switch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .settings-knob {
      position: absolute; top: 2px; left: 2px;
      width: 18px; height: 18px; border-radius: 50%;
      background: #fff; box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
      transition: transform .16s ease;
    }
    .settings-switch[data-on] .settings-knob { transform: translateX(16px); }
    @media (prefers-reduced-motion: reduce) {
      .settings-switch, .settings-knob, .settings-segment { transition: none; }
    }

    .settings-link {
      display: flex; align-items: center; flex: none; gap: 3px;
      padding: 4px 8px; border-radius: 7px;
      color: var(--accent); font-size: 12px; font-weight: 550; text-decoration: none;
    }
    .settings-link:hover { background: var(--hover); }
    .settings-link-glyph { width: 11px; height: 11px; }

    .settings-foot {
      display: flex; align-items: center; justify-content: space-between;
      flex: none; gap: 12px; padding: 11px 18px;
      border-top: .5px solid var(--line-soft); background: var(--surface-soft);
      color: var(--tertiary); font-size: 11px;
    }
    .settings-local { display: flex; align-items: center; gap: 5px; }

    @yield('styles')
  </style>
</head>
<body>
<div class='app-chrome'>
  <div class='app-body'>
    @if (localAgent)
      <AppRail active="@yield('nav')" />
      <div class='app-column'>
        <AppTopNav active="@yield('nav')" />
        <main class='main' data-stx-content>
          @yield('body')
        </main>
      </div>
      <!-- Rendered once into the shell rather than per screen: it is opened by
           a menubar item and a keystroke, neither of which belongs to a route,
           and an SPA navigation only swaps `[data-stx-content]`. -->
      <SettingsPanel />
    @else
      <main class='main' data-stx-content>
        <div class='offsite-shell'>
          <img src='/images/systemcleaner-mark.svg' width='52' height='52' alt='' />
          <h1>SystemCleaner runs on your Mac</h1>
          <p>
            This screen is the app's interface. It reads disks, processes, and
            login items on the machine it is installed on, so there is nothing
            for it to show from a web server.
          </p>
          <a class='btn' href='/#download'>Download for macOS</a>
        </div>
      </main>
    @endif
  </div>
</div>

<script client>
/*
 * The window has no titlebar, so the page has to move it.
 *
 * Craft's window buttons sit over this app's chrome, which is what a Mac app
 * with a sidebar looks like — and it leaves the window with no handle of its
 * own. The usual trick, `-webkit-app-region: drag`, is Chromium's and does
 * nothing here: WebKit has never implemented it, and a WKWebView discards the
 * declaration outright. That is worse than not supporting it, because the
 * stylesheet then reads as though the window can be dragged while it cannot be
 * moved at all. Craft's own answer is `startDrag()`, which hands the press to
 * AppKit and runs a real window drag loop from it.
 *
 * The bands are the icon rail, the top strip and the sticky page header:
 * chrome by intent,
 * and between them they cover the top of the window wherever the pointer
 * lands. A press on anything interactive is left alone, and in a browser —
 * the marketing site renders this same shell — there is no `craft` to call
 * and this does nothing.
 */
interface CraftWindowDrag {
  window?: { startDrag?: () => void }
}

function moveWindowFrom(event: Event): void {
  const press = event as MouseEvent
  if (press.button !== 0)
    return

  const craft = (globalThis as { craft?: CraftWindowDrag }).craft
  const drag = craft?.window?.startDrag
  if (typeof drag !== 'function')
    return

  const target = press.target
  if (!(target instanceof Element))
    return
  if (!target.closest('.rail, .topnav, .main-header'))
    return
  if (target.closest('a, button, input, select, textarea, [role="button"], [data-rail-item]'))
    return

  drag.call(craft.window)
}

useEventListener('mousedown', moveWindowFrom, { target: document })

/*
 * Whether this window is the one in front is Craft's answer now.
 *
 * The runtime stamps `data-craft-window-active` on the root element from its
 * NSWindowDelegate, seeded at document-start and restated whenever a window is
 * attached, so the CSS above needs nothing from this file.
 *
 * What stood here was forty lines reaching the same conclusion badly. It read
 * `document.hasFocus()`, which inside a WKWebView reports whether the *web
 * view* holds first responder rather than whether the window is key — a window
 * perfectly in front with focus elsewhere painted itself grey. It then branched
 * on whether `craft.window` existed to tell a Craft window from a browser tab.
 * And it had not run at all since the edit that left `}: void {` in the middle
 * of it: one syntax error took the whole client block with it, which is why the
 * rail stayed blue behind other windows no matter what the CSS said.
 */
</script>
<!-- Loaded for every app page: `nativeConfirm` and `nativeAlert` replace the
     web dialogs on the destructive actions, and every screen has one. -->
<script src="/native-dialog.js"></script>
<!-- Replaces AppKit's default menubar with one that knows this app: every
     screen on Cmd+1..9, Rescan on Cmd+R, and Edit's roles wired so Copy and
     Paste work in the filter fields. -->
<script src="/app-menu.js"></script>
<!-- Wires the Settings panel above: Cmd+, from the menubar or the page, the
     profile chip in the top strip, and the controls inside it. -->
<script src="/settings-panel.js"></script>
</body>
</html>
