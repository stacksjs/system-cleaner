<script server>
// The app shell is a control plane for the Mac this process runs on. The same
// STX application also serves the public marketing site, where there is no
// such Mac — so off-agent the shell renders a download prompt instead of a
// dashboard built from a shared web server's disk.
const { isLocalAgent } = require('~/app/Support/Runtime/local-agent')
const localAgent = isLocalAgent()
</script>

<!DOCTYPE html>
<html lang='en'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>SystemCleaner</title>
  <link rel="icon" href="/favicon.ico">
  @appearanceBootstrap({
    storageKey: 'systemcleaner-appearance',
    appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
    colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
  })
  <link rel="stylesheet" href="/app-theme.css">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%; overflow: hidden; background: var(--sidebar-bg); color: var(--ink);
      font-family: -apple-system, 'SF Pro Text', BlinkMacSystemFont, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    /* Page changes. The router wraps every SPA swap in a view transition.
       The window itself (sidebar, toolbar, the section colour) cross-fades,
       so moving from green Cleanup to teal Storage blends one colour into
       the next, while the page content leaves quickly and the new page
       settles in from just below. The sidebar never appears to move. */
    ::view-transition-old(root), ::view-transition-new(root) {
      animation-duration: .26s; animation-timing-function: cubic-bezier(.2, .8, .2, 1);
    }
    /* Belt and braces for the router's built-in loading styles (see
       config/ui.ts): a navigation never changes the cursor or takes the
       pointer away from a link, since WebKit would not restore either until
       the mouse moved. */
    .stx-navigating { cursor: auto !important; }
    .stx-navigating a, .stx-navigating button { pointer-events: auto !important; }
    #stx-router-progress { display: none !important; }
    [data-stx-content] { view-transition-name: page; }
    ::view-transition-group(page) { animation-duration: .3s; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
    ::view-transition-old(page) { animation: page-out .14s ease-in both; }
    ::view-transition-new(page) { animation: page-in .32s cubic-bezier(.2, .8, .2, 1) both; }
    @keyframes page-out { to { opacity: 0; transform: scale(.99); } }
    @keyframes page-in { from { opacity: 0; transform: translateY(8px); } }
    @media (prefers-reduced-motion: reduce) {
      ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; }
    }
    ::view-transition-group(root) { background: var(--app-bg); }
    :root[data-craft-native-sidebar] ::view-transition-group(root) { background: transparent; }
    [data-stx-content] { min-height: 100%; background: var(--app-bg); }
    [x-cloak] { display: none !important; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { border-radius: 3px; background: var(--line); }

    .app-chrome { display: flex; width: 100vw; height: 100vh; flex-direction: column; overflow: hidden; background: var(--sidebar-bg); }
    .app-body { display: flex; min-width: 0; flex: 1; overflow: hidden; }

    /* ---------- Vibrant window ---------- */
    /* Craft draws an NSVisualEffectView behind the web view when the launcher
       asks for one, and stamps two markers on the root element:
       `data-craft-native-sidebar` whenever there is a material at all, and
       `data-craft-web-material` — "window" or "sidebar" — for how far it
       reaches. The second is newer, so the first is what the transparency
       keys on: every runtime that draws a material sets it, and a browser,
       where the marketing site renders this same shell, sets neither and
       every surface keeps its own fill.

       The window span is what this app asks for. The rail carries no fill of
       its own, so a material that stopped at 74px put the only hard edge in
       the window exactly where there was otherwise no boundary at all. One
       material behind everything, and the cards are what have edges.

       Every band between the material and the page goes transparent so the
       wash is applied exactly once. `body` is where it lands, because it is
       the one element that spans the window and sits under all of them. */
    :root[data-craft-native-sidebar] body,
    :root[data-craft-native-sidebar] .app-chrome,
    :root[data-craft-native-sidebar] [data-stx-content],
    :root[data-craft-native-sidebar] .main,
    :root[data-craft-native-sidebar] .topnav { background: transparent; }

    /* The wash. A material with nothing over it shows the desktop straight
       through and no text on it is readable; at this strength the surface
       still moves with what is behind the window, which is the whole reason
       for asking AppKit rather than painting a grey rectangle.

       A native tint would be the other way to do this, and it cannot work
       here: AppKit would have to be told light or dark, and the page owns that
       choice. `--app-bg` already flips with the colour mode, so one rule
       covers both. */
    :root[data-craft-web-material='window'] body {
      background: color-mix(in srgb, var(--sidebar-bg) var(--material-opacity), transparent);
    }

    /* A sidebar-span material — what a runtime older than the window span
       gives us — keeps the arrangement it was built for: vibrancy under the
       rail, an opaque content column beside it, and the hairline Finder puts
       in the same place. */
    :root[data-craft-native-sidebar]:not([data-craft-web-material='window']) body { background: transparent; }

    /* ---------- Inactive window ---------- */
    /* A Mac window that is not in front goes quiet. AppKit does that for the
       window buttons on its own — they grey out — but everything the page
       draws keeps shouting: a saturated blue selection pill on a sidebar the
       user is no longer looking at, next to three grey buttons that have
       already stood down. Finder does not do that; its selected row drops to
       a neutral fill and its icons desaturate, so the whole sidebar recedes
       together.

       `data-craft-window-active="false"` is stamped on the root element by the
       Craft runtime, which is the only thing that can see the window server. Colour is the only thing that changes —
       nothing moves, so returning to the window does not reflow it. */
    /* Colour, not opacity. Fading an icon that is `color: var(--accent)`
       leaves it pale blue, which reads as a disabled control rather than an
       inactive window — Finder's icons go grey at full strength. So the rail
       drops to the neutral it would have had if it had never been tinted. */
    :root[data-craft-window-active='false'] .rail-item[data-active] {
      background: var(--side-hover);
    }
    /* Paused when the window is in the background: an idle window should
       cost nothing, and nobody is watching the sphere drift. */
    :root[data-craft-window-active='false'] .hub-orb-body,
    :root[data-craft-window-active='false'] .hub-skeleton { animation-play-state: paused; }
    /* The tiles are the one saturated thing left in a sidebar that has
       otherwise stood down, and `color` cannot reach a gradient. */
    :root[data-craft-window-active='false'] .side-tile { filter: grayscale(1); opacity: .6; }
    .rail-item, .side-tile {
      transition: background .18s ease, color .18s ease, opacity .18s ease, filter .18s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .rail-item, .side-tile { transition: none; }
    }
    /* One window, one colour. The section you are in paints the whole window,
       sidebar included, so the sidebar and the page read as one surface
       rather than two panes side by side. A section page is that surface and
       nothing else. A tool page, a table you work through, sits on a light
       sheet inside the coloured frame: rows of small text need a quiet
       background, and the frame already says where you are. */
    .app-column {
      display: flex; flex: 1; flex-direction: column; min-width: 0;
      margin: 8px 8px 8px 0; overflow: hidden;
      border-radius: 14px;
      background: var(--app-bg); color: var(--ink);
      box-shadow: 0 0 0 .5px rgb(0 0 0 / .12), 0 10px 40px rgb(0 0 0 / .22);
    }
    .app-body:has(.hub) .app-column {
      margin: 0; border-radius: 0; background: transparent; box-shadow: none; color: #fff;
    }
    /* `min-height: 0`, overriding the router container's `min-height: 100%`
       above: `.main` is that container and also the scroll area under the
       toolbar, so 100% made it the window's full height on top of the
       toolbar and pushed its last 32 points below the window edge, where
       no amount of scrolling could reach them. */
    .main { min-width: 0; min-height: 0; flex: 1; overflow-y: auto; background: var(--app-bg); }

    /* AppKit publishes its window-button band; use the same centre line for
       the app toolbar, without leaving an empty second row beneath it. */
    .topnav {
      --chrome-band: calc(2 * var(--craft-window-buttons-y, 8px) + var(--craft-window-buttons-height, 16px));
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      flex: none; height: max(32px, calc(var(--chrome-band) - 16px)); padding: 0 12px 0 8px;
      background: var(--app-bg); user-select: none;
    }
    .toolbar-navigation { flex: none; }
    .toolbar-button {
      display: grid; place-items: center; width: 28px; height: 28px;
      border: 0; border-radius: 6px; background: transparent; color: var(--secondary);
      cursor: pointer; transition: background .12s, color .12s;
    }
    .toolbar-button span { display: block; width: 16px; height: 16px; }
    .toolbar-button:hover:not(:disabled) { background: var(--hover); color: var(--ink); }
    .toolbar-button:active:not(:disabled) { background: var(--pressed); }
    .toolbar-button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .toolbar-button:disabled { color: var(--tertiary); opacity: .4; cursor: default; }
    .toolbar-separator { width: .5px; height: 14px; margin: 0 5px; background: var(--line); }
    @media (max-width: 600px) { .profile-text { display: none; } }

    /* ---------- Account menu ---------- */
    /* An AppKit menu, in CSS: a translucent sheet with a blurred backdrop,
       hairline border, and rows that highlight in the accent colour. The
       blur is what makes it read as a menu rather than a dropped-in panel —
       it is the one surface in this window allowed to sit *above* the
       material rather than on it. */
    .profile { position: relative; min-width: 0; }
    .menu-heading { padding: 6px 8px 3px; color: var(--secondary); font-size: 12px; font-weight: 500; }
    .menu {
      position: absolute; top: calc(100% + 6px); right: 0; z-index: 60;
      display: flex; flex-direction: column; min-width: 208px; padding: var(--space-1);
      border: .5px solid color-mix(in srgb, var(--ink) 16%, transparent);
      border-radius: 10px;
      background: color-mix(in srgb, var(--surface) 82%, transparent);
      box-shadow: 0 12px 32px rgb(0 0 0 / .22);
      backdrop-filter: blur(28px) saturate(180%);
      -webkit-backdrop-filter: blur(28px) saturate(180%);
      animation: menu-in .12s ease;
    }
    .menu[hidden] { display: none; }
    @keyframes menu-in { from { opacity: 0; transform: translateY(-4px); } }
    @media (prefers-reduced-motion: reduce) {
      .menu { animation: none; }
    }

    .menu-item {
      display: flex; align-items: center; gap: var(--space-2); width: 100%;
      padding: var(--space-tight) var(--space-2); border: 0; border-radius: 6px;
      background: transparent; color: var(--ink);
      font-family: inherit; font-size: 13px; font-weight: 450;
      text-align: left; text-decoration: none; white-space: nowrap;
      cursor: pointer;
      transition: background .1s, color .1s;
    }
    .menu-item:hover, .menu-item:focus-visible { background: var(--accent-fill); color: #fff; outline: none; }
    .menu-item:hover .menu-shortcut, .menu-item:focus-visible .menu-shortcut { color: #fff; }
    /* The screen you are already on. A checkmark would be a claim about state;
       this is a claim about where you are, so it reads as the sidebar does. */
    .menu-item[data-active] { color: var(--accent); font-weight: 600; }
    .menu-item[data-active]:hover, .menu-item[data-active]:focus-visible { color: #fff; }
    .menu-icon { width: 15px; height: 15px; flex: none; }
    .menu-label { flex: 1; }
    .menu-shortcut { color: var(--tertiary); font-size: 12px; }
    .menu-rule { height: .5px; margin: var(--space-1) var(--space-2); background: var(--line); }

    /* A single-line account control belongs on the window-button line.
       The machine name is context inside its menu rather than a second title. */
    .profile-chip {
      display: flex; align-items: center; gap: 7px; max-width: 240px; height: 28px;
      padding: 0 6px; border: 0; border-radius: 6px;
      background: transparent; color: var(--secondary);
      font-family: inherit; text-align: left; cursor: pointer;
    }
    .profile-chip:hover { background: var(--hover); color: var(--ink); }
    .profile-chip[aria-expanded='true'] { background: var(--pressed); color: var(--ink); }
    .profile-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .profile-caret { width: 9px; height: 9px; flex: none; color: var(--secondary); margin-left: 2px; }
    .profile-avatar { position: relative; display: grid; width: 20px; height: 20px; flex: none; }
    .profile-picture {
      display: grid; place-items: center; width: 100%; height: 100%; overflow: hidden;
      border-radius: 50%; background: var(--surface-soft); color: var(--secondary);
      font-size: 10px; font-weight: 600;
    }
    .profile-picture > span { width: 12px; height: 12px; }
    .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .profile-text { min-width: 0; }
    .profile-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; font-weight: 500; color: var(--secondary); }

    /* Inactive window: colour, not opacity — a faded tint reads as a disabled
       control, where grey reads as a window that has stood down. */
    :root[data-craft-window-active='false'] .profile-name { color: var(--secondary); }
    :root[data-craft-window-active='false'] .profile-avatar img { filter: grayscale(1); opacity: .8; }
    .profile-chip, .profile-avatar img {
      transition: background .18s ease, color .18s ease, filter .18s ease, opacity .18s ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .profile-chip, .profile-avatar img { transition: none; }
    }

    /* ---------- Collapsed sidebar ---------- */
    /* The app toolbar and View menu both control this same rail. */
    html[data-sidebar-collapsed] body { padding-left: 0 !important; }
    :root[data-sidebar-collapsed] .rail {
      width: 0; min-width: 0;
      padding-left: 0; padding-right: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
    }
    /* Collapsing the rail does not move AppKit's window buttons. */
    :root[data-sidebar-collapsed] .topnav {
      padding-left: calc(var(--craft-window-controls-width, 0px) + 16px);
    }
    /* With the sidebar gone there is no frame left to inset the sheet into,
       and an inset sheet puts the window buttons astride its rounded corner.
       So the sheet fills the window and its toolbar takes the buttons' line,
       the way every Mac window without a sidebar looks. */
    :root[data-sidebar-collapsed] .app-column { margin: 0; border-radius: 0; box-shadow: none; }
    :root[data-sidebar-collapsed] .topnav,
    .app-body:has(.hub) .topnav { height: max(32px, var(--chrome-band)); }
    .rail { transition: width .2s ease, min-width .2s ease, opacity .2s ease, padding .2s ease; }
    .app-column { transition: margin .2s ease; }
    @media (prefers-reduced-motion: reduce) {
      .rail { transition: none; }
    }
    .main-header { position: sticky; top: 0; z-index: 10; padding: var(--space-4) var(--space-6) var(--space-3); background: linear-gradient(to bottom, var(--app-bg) 72%, transparent); }

    /* Over a material the header cannot paint `--app-bg`: that is a second
       wash on top of the one `body` already applies, and the band it makes is
       visible before a single pixel has scrolled.

       So the fill moves to a layer of its own, behind the text, that can be
       masked to nothing at the bottom edge — a blur with a hard edge is worse
       than no blur, and masking the element itself would fade the subtitle
       sitting in that same bottom band. The blur is what actually hides
       scrolled content; the wash is only enough to keep contrast up. */
    :root[data-craft-web-material='window'] .main-header { background: transparent; isolation: isolate; }
    :root[data-craft-web-material='window'] .main-header::before {
      position: absolute; inset: 0; z-index: -1; content: '';
      background: color-mix(in srgb, var(--app-bg) var(--material-opacity), transparent);
      backdrop-filter: blur(18px) saturate(180%);
      -webkit-backdrop-filter: blur(18px) saturate(180%);
      mask-image: linear-gradient(to bottom, #000 74%, transparent);
      -webkit-mask-image: linear-gradient(to bottom, #000 74%, transparent);
    }

    /* ---------- Sidebar ---------- */
    /* Six rows, one per section. Tools live on each section's own page, so
       the sidebar is a list of places rather than an index of every screen.

       The window has no titlebar, so its close/minimise/zoom buttons sit in
       this sidebar's top-left corner — the arrangement every Mac app with a
       sidebar uses. Two consequences, and neither of them is a number typed in
       here:

       1. The first row starts below them. Craft publishes the traffic lights'
          own rectangle as `--craft-window-buttons-*`, and their bottom
          (`y + height`, because the inset is where they start rather than
          where the window does) plus some breathing room is the clearance.
          The fallbacks chain to the older reserve, then to 16px where neither
          is published — a browser, which has no window buttons at all.
       2. This sidebar is part of the window's drag handle, which the script at
          the end of this file wires up. Not `-webkit-app-region: drag`: that
          property is Chromium's, and a WKWebView drops it on the floor. */
    .rail {
      display: flex; width: 214px; min-width: 214px; height: 100%;
      flex-direction: column; gap: var(--space-2);
      padding: max(16px, calc(
        var(--craft-window-buttons-y, var(--craft-window-controls-inset-y, 0px))
        + var(--craft-window-buttons-height, var(--craft-window-controls-height, 0px))
        + 14px
      )) 10px 10px;
      background: transparent;
      user-select: none;
    }
    .rail-groups {
      display: flex; flex: 1; flex-direction: column; gap: var(--space-4);
      min-height: 0; overflow-y: auto; scrollbar-width: none;
    }
    .rail-groups::-webkit-scrollbar { width: 0; height: 0; }
    .side-group { display: flex; flex-direction: column; gap: 3px; }
    .side-group + .side-group { padding-top: var(--space-4); border-top: 1px solid var(--side-line); }

    /* Section colours. One pair for tiles and artwork, and a deep three-stop
       ramp plus a glow for the window behind them. The window takes them from
       the toolbar's `data-tone`, which names the section of whatever page is
       showing. */
    [data-tone='overview'], .app-body:has(.topnav[data-tone='overview']) {
      --tone-a: #d27bff; --tone-b: #7a2fe0; --tone-glow: #c04dff;
      --tone-bg1: #6a2fb8; --tone-bg2: #3a1677; --tone-bg3: #1a0837;
    }
    [data-tone='cleanup'], .app-body:has(.topnav[data-tone='cleanup']) {
      --tone-a: #5ee38b; --tone-b: #109a4b; --tone-glow: #36d873;
      --tone-bg1: #22975a; --tone-bg2: #0e5631; --tone-bg3: #052817;
    }
    [data-tone='storage'], .app-body:has(.topnav[data-tone='storage']) {
      --tone-a: #63e6d6; --tone-b: #0b8f99; --tone-glow: #2fd6c8;
      --tone-bg1: #138a94; --tone-bg2: #0a4a54; --tone-bg3: #032328;
    }
    [data-tone='performance'], .app-body:has(.topnav[data-tone='performance']) {
      --tone-a: #ff9a7a; --tone-b: #e2482a; --tone-glow: #ff7348;
      --tone-bg1: #c8431f; --tone-bg2: #7a1f0d; --tone-bg3: #3a0c04;
    }
    [data-tone='apps'], .app-body:has(.topnav[data-tone='apps']) {
      --tone-a: #6cb2ff; --tone-b: #1c5ce0; --tone-glow: #3f9bff;
      --tone-bg1: #2a62d6; --tone-bg2: #12327f; --tone-bg3: #071842;
    }
    [data-tone='protection'], .app-body:has(.topnav[data-tone='protection']) {
      --tone-a: #ff86c8; --tone-b: #c42a86; --tone-glow: #ff5cb4;
      --tone-bg1: #a8337a; --tone-bg2: #621348; --tone-bg3: #2e0722;
    }

    /* The window itself. Untoned (Settings, a page outside every section) it
       stays transparent so the material shows through; toned, it is the
       section's colour edge to edge. */
    .app-body {
      --side-ink: var(--ink); --side-dim: var(--tertiary); --side-line: var(--line);
      --side-hover: var(--hover); --side-active: color-mix(in srgb, var(--accent) 14%, transparent);
    }
    .app-body:has(.topnav[data-tone]:not([data-tone=''])) {
      --side-ink: #fff; --side-dim: rgb(255 255 255 / .62); --side-line: rgb(255 255 255 / .12);
      --side-hover: rgb(255 255 255 / .1); --side-active: rgb(255 255 255 / .2);
      background:
        /* Fine grain over the colour: large dark gradients band visibly on a
           Mac display, and noise at this strength dithers them. */
        url('/images/grain.svg'),
        radial-gradient(70% 60% at 82% -8%, color-mix(in srgb, var(--tone-glow) 50%, transparent), transparent 62%),
        radial-gradient(60% 55% at -6% 108%, color-mix(in srgb, var(--tone-glow) 26%, transparent), transparent 70%),
        linear-gradient(155deg, var(--tone-bg1), var(--tone-bg2) 55%, var(--tone-bg3));
      color: #fff;
    }

    .side-row {
      position: relative; display: flex; align-items: center; gap: 10px;
      width: 100%; min-height: 40px; padding: 0 var(--space-2);
      border: 0; border-radius: 10px; background: transparent; color: var(--side-ink);
      font-family: inherit; font-size: 13px; font-weight: 500; line-height: 1.2;
      text-align: left; text-decoration: none; cursor: default;
    }
    .side-row:hover { background: var(--side-hover); }
    .side-row:focus-visible { outline: 2px solid var(--side-ink); outline-offset: -2px; }
    .side-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .side-tile {
      display: grid; width: 28px; height: 28px; flex: none; place-items: center;
      border-radius: 8px; color: #fff;
      background: linear-gradient(160deg, var(--tone-a), var(--tone-b));
      box-shadow: inset 0 1px 0 rgb(255 255 255 / .3), 0 2px 6px rgb(0 0 0 / .22);
    }
    .side-tile > span { width: 15px; height: 15px; }

    .rail-item:active { background: var(--side-active); }
    .rail-item[data-active] {
      background: var(--side-active); font-weight: 600;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / .08);
    }

    /* A scan keeps running after you leave its screen. The dot says so from
       anywhere in the app. */
    .rail-item[data-scanning]::after {
      width: 7px; height: 7px; flex: none; content: '';
      border-radius: 50%; background: var(--side-ink);
      animation: rail-scan-pulse 1.6s ease-in-out infinite;
    }
    @keyframes rail-scan-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
    @media (prefers-reduced-motion: reduce) {
      .rail-item[data-scanning]::after { animation: none; }
    }

    /* The count on Applications. Sized to hold two digits without changing
       the row's height, so nothing reflows when the number arrives. */
    .side-badge {
      min-width: 18px; height: 18px; padding: 0 5px; flex: none;
      border-radius: 9px; background: #ff9f0a; color: #1d1d1f;
      font-size: 10.5px; font-weight: 700; line-height: 18px;
      text-align: center; font-variant-numeric: tabular-nums;
    }
    .side-badge[hidden] { display: none; }
    /* A newer SystemCleaner is waiting: a dot on the Settings row, which
       then opens at Software Update. Drawn by auto-update.ts. */
    .side-update-dot { width: 8px; height: 8px; margin-left: auto; flex: none; border-radius: 50%; background: #ff9f0a; box-shadow: 0 0 0 2px color-mix(in srgb, #ff9f0a 30%, transparent); }
    .side-update-dot[hidden] { display: none; }

    .rail-foot { display: flex; flex-direction: column; gap: 3px; padding-top: var(--space-3); border-top: 1px solid var(--side-line); }
    .side-disk {
      display: block; margin-bottom: var(--space-1); padding: 10px 10px 11px;
      border-radius: 12px; background: var(--side-hover); color: var(--side-ink);
      text-decoration: none; cursor: default;
    }
    .side-disk:hover { background: var(--side-active); }
    .side-disk-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); font-size: 11.5px; }
    .side-disk-name { font-weight: 600; }
    .side-disk-free { color: var(--side-dim); font-variant-numeric: tabular-nums; }
    .side-disk-bar { display: block; height: 5px; margin-top: var(--space-2); overflow: hidden; border-radius: 3px; background: var(--side-line); }
    .side-disk-bar > span { display: block; width: var(--pct, 0%); height: 100%; border-radius: 3px; background: var(--side-ink); transition: width .9s cubic-bezier(.2, .8, .2, 1); }
    .side-utility { min-height: 34px; color: var(--side-dim); }
    .side-utility:hover { color: var(--side-ink); }
    .side-utility-icon { display: grid; width: 28px; flex: none; place-items: center; }
    .side-utility-icon > span { width: 15px; height: 15px; }
    .side-local {
      display: flex; align-items: center; gap: var(--space-tight);
      padding: var(--space-1) var(--space-2) 0;
      color: var(--side-dim); font-size: 11px; font-weight: 500;
    }
    .side-local > span:first-child { width: 11px; height: 11px; flex: none; }

    /* ---------- Section pages ---------- */
    /* White on glass over the section's colour, in light and dark mode alike:
       the colour is the point, and a pale wash of it would just be a tinted
       settings screen. */
    .app-body:has(.hub) .main,
    .app-body:has(.hub) [data-stx-content],
    .app-body:has(.hub) .topnav { background: transparent; }
    .app-body:has(.hub) .toolbar-button,
    .app-body:has(.hub) .profile-chip,
    .app-body:has(.hub) .profile-name,
    .app-body:has(.hub) .profile-caret,
    .app-body:has(.hub) .toolbar-title { color: rgb(255 255 255 / .82); }
    .app-body:has(.hub) .toolbar-button:hover:not(:disabled),
    .app-body:has(.hub) .profile-chip:hover { background: rgb(255 255 255 / .14); color: #fff; }
    .app-body:has(.hub) .toolbar-button:disabled { color: rgb(255 255 255 / .45); }
    .app-body:has(.hub) .toolbar-separator { background: rgb(255 255 255 / .2); }

    @property --score { syntax: '<number>'; inherits: true; initial-value: 0; }

    /* A section page is three bands (what it is, the tools or cards, the
       round button and panels) and they share the window's height rather
       than stacking at the top: the composition sits in the middle and the
       gaps between bands grow with the window, so a tall window gives the
       round button room to stand on its own instead of leaving a blank
       strip under it. Content taller than the window keeps the smallest gap
       and scrolls. */
    .hub {
      container-type: inline-size;
      display: flex; min-height: 100%; flex-direction: column; justify-content: center;
      gap: clamp(28px, 6vh, 72px);
      max-width: 1080px; margin: 0 auto; padding: var(--space-4) var(--space-8) var(--space-10);
      color: #fff;
    }

    /* The stage: artwork on the left, what the section is and its tools on
       the right. */
    .hub-stage {
      display: grid; grid-template-columns: minmax(240px, 1fr) minmax(320px, 1.15fr);
      gap: var(--space-8); align-items: center; padding-top: var(--space-4);
    }
    .hub-art { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); }
    
    /* The artwork: a glossy sphere in the section's colours with its glyph
       inside, drawn entirely in CSS so it follows the tone. */
    .hub-orb { position: relative; display: grid; width: 260px; height: 260px; place-items: center; }
    .hub-orb-glow {
      position: absolute; inset: 12%; border-radius: 50%;
      background: var(--tone-glow); filter: blur(52px); opacity: .42;
    }
    .hub-orb-body, .hub-module-orb {
      position: relative; display: grid; place-items: center; border-radius: 50%;
      background:
        radial-gradient(circle at 32% 24%, rgb(255 255 255 / .9) 0 5%, rgb(255 255 255 / 0) 24%),
        radial-gradient(circle at 50% 118%, rgb(255 255 255 / .38), transparent 52%),
        linear-gradient(155deg, var(--tone-a), var(--tone-b));
      box-shadow:
        inset 0 -18px 36px rgb(0 0 0 / .28),
        inset 0 12px 28px rgb(255 255 255 / .3),
        0 30px 50px rgb(0 0 0 / .32);
    }
    .hub-orb-body { width: 214px; height: 214px; animation: hub-float 6s ease-in-out infinite; will-change: transform; }
    .hub-orb-icon { width: 88px; height: 88px; color: #fff; filter: drop-shadow(0 8px 14px rgb(0 0 0 / .25)); }
    @keyframes hub-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

    .hub-name { text-wrap: balance; font-size: 34px; font-weight: 600; letter-spacing: -.025em; line-height: 1.1; }
    .hub-headline { text-wrap: balance; margin-top: var(--space-2); font-size: 17px; font-weight: 600; line-height: 1.3; }
    .hub-lede { text-wrap: pretty; max-width: 50ch; margin-top: var(--space-2); color: rgb(255 255 255 / .8); font-size: 13.5px; line-height: 1.5; }

    .hub-features { display: flex; flex-direction: column; gap: 2px; margin-top: var(--space-5); }
    .hub-feature {
      display: flex; align-items: center; gap: var(--space-3); padding: 9px 10px;
      border-radius: 12px; color: #fff; text-decoration: none;
      transition: background .15s ease;
    }
    .hub-feature:hover { background: rgb(255 255 255 / .1); }
    .hub-feature:focus-visible { outline: 2px solid #fff; outline-offset: -2px; }
    .hub-feature-icon {
      display: grid; width: 32px; height: 32px; flex: none; place-items: center;
      border-radius: 50%; background: rgb(255 255 255 / .16);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / .25);
    }
    .hub-feature-icon > span { width: 15px; height: 15px; }
    .hub-feature-text { display: flex; flex: 1; flex-direction: column; gap: 1px; min-width: 0; }
    .hub-feature-name { font-size: 13.5px; font-weight: 600; }
    .hub-feature-desc { overflow: hidden; color: rgb(255 255 255 / .76); font-size: 11.5px; text-overflow: ellipsis; white-space: nowrap; }
    .hub-feature-metric { flex: none; color: rgb(255 255 255 / .88); font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .hub-feature-chevron { width: 9px; height: 9px; flex: none; opacity: .5; }

    .hub-title { text-wrap: balance; margin-top: var(--space-tight); font-size: 32px; font-weight: 700; letter-spacing: -.025em; line-height: 1.12; }
    .hub-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); }
    .hub-cta {
      display: inline-flex; align-items: center; gap: var(--space-2); height: 34px; padding: 0 16px;
      border: 1px solid rgb(255 255 255 / .24); border-radius: 999px;
      background: rgb(255 255 255 / .12); color: #fff;
      font-size: 13px; font-weight: 600; text-decoration: none;
      transition: background .15s ease;
    }
    .hub-cta:hover { background: rgb(255 255 255 / .2); }
    .hub-cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .hub-cta > span { width: 13px; height: 13px; }

    /* The round button: the one action most people came for. */
    .hub-run { display: flex; flex-direction: column; align-items: center; gap: var(--space-3); }
    .hub-run-button {
      display: grid; width: 92px; height: 92px; place-content: center; justify-items: center; gap: 3px;
      border-radius: 50%; color: #fff; text-decoration: none;
      font-size: 13.5px; font-weight: 700;
      background:
        radial-gradient(circle at 35% 26%, rgb(255 255 255 / .55), transparent 46%),
        linear-gradient(155deg, var(--tone-a), var(--tone-b));
      box-shadow:
        0 0 0 7px rgb(255 255 255 / .1),
        0 0 0 15px rgb(255 255 255 / .05),
        0 16px 36px color-mix(in srgb, var(--tone-bg3) 60%, transparent);
      transition: transform .16s ease;
    }
    .hub-run-button:hover { transform: scale(1.05); }
    .hub-run-button:active { transform: scale(.97); }
    .hub-feature:active, .hub-row-link:active { background: rgb(255 255 255 / .16); }
    .hub-module:active { transform: translateY(0) scale(.99); }
    .hub-cta:active, .hub-panel-link:active, .hub-panel-button:active { transform: scale(.97); }
    .side-disk:active { transform: scale(.99); }
    .hub-run-button:focus-visible { outline: 2px solid #fff; outline-offset: 8px; }
    .hub-run-button > span:first-child { width: 18px; height: 18px; }
    .hub-run-caption { color: rgb(255 255 255 / .78); font-size: 12px; }

    /* Live panels under the stage. */
    .hub-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-4); }
    .hub-panel, .hub-module {
      position: relative; display: flex; flex-direction: column; overflow: hidden;
      border: 1px solid rgb(255 255 255 / .13); border-radius: 20px;
      background: rgb(255 255 255 / .08); color: #fff; text-decoration: none;
      box-shadow: inset 0 1px 0 rgb(255 255 255 / .08);
      /* No backdrop blur: what sits behind these is a smooth gradient, which
         blurs to itself, and a live blur is re-rendered on every paint and
         every scroll for no visible difference. */
    }
    .hub-panel { min-height: 220px; padding: 16px 18px 14px; }
    .hub-panel-head { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2); }
    .hub-panel-title { font-size: 14px; font-weight: 650; }
    .hub-panel-aside { flex: 1; min-width: 0; overflow: hidden; color: rgb(255 255 255 / .76); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
    .hub-panel-link {
      flex: none; padding: 3px 11px; border-radius: 999px;
      background: rgb(255 255 255 / .14); color: #fff;
      font-size: 11.5px; font-weight: 600; text-decoration: none;
    }
    .hub-panel-link:hover { background: rgb(255 255 255 / .22); }
    .hub-panel-link, .hub-panel-button, .hub-cta { transition: background .15s ease, transform .12s ease; }
    .hub-panel-link:focus-visible, .hub-panel-button:focus-visible, .hub-row-link:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .hub-panel-body { display: flex; flex: 1; flex-direction: column; }
    /* A panel with nothing to list says so as a small composition rather
       than a stray sentence: a mark, a title, one line, and the next step
       when there is one. Good news ("nothing to clear") wears the section's
       colour; a failure offers to try again. */
    .hub-empty { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: var(--space-4) var(--space-3); text-align: center; }
    .hub-empty-mark {
      display: grid; width: 46px; height: 46px; margin-bottom: var(--space-2); place-items: center; border-radius: 50%;
      background: rgb(255 255 255 / .14); box-shadow: inset 0 1px 0 rgb(255 255 255 / .22);
    }
    .hub-empty-mark > span { width: 21px; height: 21px; color: #fff; }
    .hub-empty-mark[data-kind='clear'] { background: linear-gradient(160deg, var(--tone-a), var(--tone-b)); box-shadow: inset 0 1px 0 rgb(255 255 255 / .3), 0 8px 18px rgb(0 0 0 / .18); }
    .hub-empty-mark[data-kind='error'] { background: rgb(0 0 0 / .18); }
    .hub-empty-title { font-size: 14.5px; font-weight: 650; letter-spacing: -.01em; }
    .hub-empty-body { text-wrap: pretty; max-width: 38ch; margin: 0; color: rgb(255 255 255 / .8); font-size: 12.5px; line-height: 1.5; }
    .hub-empty .hub-panel-button { align-self: center; margin-top: var(--space-3); text-decoration: none; }
    .hub-panel-note { color: rgb(255 255 255 / .76); font-size: 13px; line-height: 1.5; }
    .hub-panel-button {
      align-self: flex-start; margin-top: var(--space-3); padding: 7px 14px;
      border: 0; border-radius: 999px; background: #fff; color: var(--tone-bg2);
      font-family: inherit; font-size: 12.5px; font-weight: 650; cursor: pointer;
    }

    .hub-row {
      display: flex; align-items: center; gap: var(--space-3); padding: 8px 6px;
      border-radius: 10px; color: #fff; text-decoration: none;
    }
    .hub-row + .hub-row { border-top: 1px solid rgb(255 255 255 / .08); }
    .hub-row-link:hover { background: rgb(255 255 255 / .08); }
    .hub-row-icon {
      display: grid; width: 30px; height: 30px; flex: none; place-items: center;
      border-radius: 50%; background: rgb(255 255 255 / .14);
    }
    .hub-row-icon > span { width: 14px; height: 14px; }
    .hub-row-main { display: flex; flex: 1; flex-direction: column; gap: 2px; min-width: 0; }
    .hub-row-title, .hub-row-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hub-row-title { font-size: 13px; font-weight: 600; }
    .hub-row-sub { color: rgb(255 255 255 / .76); font-size: 11.5px; }
    .hub-row-value { flex: none; font-size: 12.5px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .hub-row-chevron { width: 9px; height: 9px; flex: none; opacity: .5; }
    .hub-row-bar { display: block; height: 4px; margin-top: 3px; overflow: hidden; border-radius: 2px; background: rgb(255 255 255 / .14); }
    .hub-row-bar > span { display: block; height: 100%; border-radius: 2px; background: #fff; }

    .hub-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-3); }
    .hub-stat { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border-radius: 12px; background: rgb(255 255 255 / .08); }
    .hub-stat-value { overflow: hidden; font-size: 15px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .hub-stat-label { color: rgb(255 255 255 / .76); font-size: 11px; }
    .hub-meter { height: 14px; margin-top: var(--space-2); overflow: hidden; border-radius: 7px; background: rgb(255 255 255 / .14); }
    .hub-meter-fill { display: block; height: 100%; border-radius: 7px; background: linear-gradient(90deg, rgb(255 255 255 / .75), #fff); }
    .hub-gauges { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); justify-items: center; padding: var(--space-1) 0; }
    .hub-gauge { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); }
    .hub-gauge-ring {
      display: grid; width: 84px; height: 84px; place-items: center; border-radius: 50%;
      background:
        radial-gradient(closest-side, color-mix(in srgb, var(--tone-bg2) 85%, #000) 78%, transparent 79% 100%),
        conic-gradient(#fff calc(var(--score) * 1%), rgb(255 255 255 / .16) 0);
    }
    .hub-gauge-value { font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .hub-gauge-label { color: rgb(255 255 255 / .8); font-size: 11.5px; font-weight: 600; }
    .hub-status { display: flex; align-items: center; gap: var(--space-3); padding: 6px 6px 10px; }
    .hub-pill { flex: none; padding: 3px 10px; border-radius: 999px; background: rgb(255 255 255 / .16); font-size: 11.5px; font-weight: 700; }
    .hub-pill-on { background: #fff; color: var(--tone-bg2); }
    .hub-status-text { color: rgb(255 255 255 / .84); font-size: 13px; line-height: 1.4; }
    .hub-skeleton {
      display: block; height: 38px; margin-top: var(--space-2); border-radius: 10px;
      background: linear-gradient(90deg, rgb(255 255 255 / .05), rgb(255 255 255 / .12), rgb(255 255 255 / .05));
      background-size: 200% 100%;
      animation: hub-shimmer 1.4s linear infinite;
    }
    @keyframes hub-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

    /* Overview: a health ring in place of the artwork, and one card per
       section in that section's own colour. */
    .hub-hero {
      display: grid; grid-template-columns: auto 1fr; gap: var(--space-8); align-items: center;
      padding: var(--space-4) var(--space-2) 0;
    }
    .hub-ring {
      --score: 0;
      display: grid; width: 176px; height: 176px; place-content: center; justify-items: center;
      border-radius: 50%;
      background:
        radial-gradient(closest-side, color-mix(in srgb, var(--tone-bg2) 88%, #000) 80%, transparent 81% 100%),
        conic-gradient(#fff calc(var(--score) * 1%), rgb(255 255 255 / .16) 0);
      box-shadow: 0 0 60px color-mix(in srgb, var(--tone-glow) 32%, transparent);
      transition: --score 1.1s cubic-bezier(.2, .8, .2, 1);
    }
    .hub-ring-value { font-size: 48px; font-weight: 750; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
    .hub-ring-label { margin-top: var(--space-1); color: rgb(255 255 255 / .8); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
    .hub-facts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); list-style: none; }
    .hub-facts li {
      display: inline-flex; align-items: center; gap: var(--space-tight); padding: 5px 11px;
      border-radius: 999px; background: rgb(255 255 255 / .1);
      color: rgb(255 255 255 / .86); font-size: 12px; font-weight: 500;
    }
    .hub-facts li > span:first-child { width: 12px; height: 12px; opacity: .8; }

    .hub-summary { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
    .hub-module { grid-column: span 2; min-height: 172px; padding: 16px 18px; transition: background .18s ease, border-color .18s ease, transform .18s ease; }
    .hub-module:nth-child(n + 4) { grid-column: span 3; }
    .hub-module:hover { border-color: rgb(255 255 255 / .24); background: rgb(255 255 255 / .13); transform: translateY(-2px); }
    .hub-module:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .hub-module::before {
      position: absolute; inset: 0; z-index: -1; content: '';
      background: radial-gradient(70% 90% at 100% 0%, color-mix(in srgb, var(--tone-glow) 34%, transparent), transparent 65%);
    }
    .hub-module-head { display: flex; align-items: center; gap: var(--space-2); color: rgb(255 255 255 / .88); font-size: 12.5px; font-weight: 600; }
    .hub-module-tile { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 6px; background: linear-gradient(155deg, var(--tone-a), var(--tone-b)); }
    .hub-module-tile > span { width: 12px; height: 12px; }
    .hub-module-orb { position: absolute; top: -20px; right: -16px; width: 116px; height: 116px; transform: rotate(-10deg); }
    .hub-module-orb > span { width: 46px; height: 46px; color: #fff; filter: drop-shadow(0 4px 10px rgb(0 0 0 / .25)); }
    .hub-module-value { margin-top: auto; font-size: 27px; font-weight: 700; letter-spacing: -.02em; }
    .hub-module-caption { color: rgb(255 255 255 / .78); font-size: 12px; }
    .hub-module-go {
      position: absolute; right: 14px; bottom: 14px; padding: 4px 11px;
      border-radius: 999px; background: rgb(255 255 255 / .16);
      font-size: 11.5px; font-weight: 600;
    }
    .hub-module-value:not([data-metric-ready]), .hub-ring-value:not([data-metric-ready]) { opacity: .45; }

    /* Fit the window. A section page opens whole, with nothing below the
       fold: the window is at least 650 points tall, and everything on these
       pages takes its size from the height it is given (`cqh`, against the
       scroll area) as well as the width (`cqw`, against the page). The
       stage and the overview's cards keep their natural size; the panels
       are the one band that gives way, and they give up whole rows (see
       `fitRows` in hub-metrics.ts) rather than cutting one in half. */
    .app-body:has(.hub) .main { container: page / size; }
    .hub {
      height: 100%; min-height: 0; justify-content: safe center;
      gap: clamp(14px, 5cqh, 64px);
      padding-block: clamp(6px, 1.6cqh, 16px) clamp(14px, 3.6cqh, 40px);
    }
    .hub-stage, .hub-hero, .hub-summary, .hub > .hub-run { flex: none; }
    .hub-stage { grid-template-columns: auto minmax(0, 1fr); gap: clamp(20px, 5cqw, 56px); padding-top: 0; }
    /* The artwork and its action are one unit: the orb, and under it the
       round button that does what the section is for. */
    .hub-art { --orb: clamp(118px, min(29cqh, 30cqw), 250px); gap: clamp(6px, 1.8cqh, 16px); }
    .hub-orb { width: var(--orb); height: var(--orb); }
    .hub-orb-body { width: 82%; height: 82%; }
    .hub-orb-icon { width: 41%; height: 41%; }
    .hub-run-button { width: clamp(64px, 10cqh, 88px); height: clamp(64px, 10cqh, 88px); font-size: clamp(12px, 1.6cqh, 13.5px); }
    /* The button wears two halo rings (7 and 15 points out); the caption
       sits clear of both rather than inside the outer one. */
    .hub-run { gap: clamp(20px, 2.8cqh, 26px); }
    .hub-name { font-size: clamp(26px, 4.4cqh, 34px); }
    .hub-headline { margin-top: clamp(2px, .8cqh, 8px); font-size: clamp(15px, 2.2cqh, 17px); }
    .hub-lede { margin-top: clamp(4px, .8cqh, 8px); font-size: clamp(12.5px, 1.8cqh, 13.5px); }
    .hub-features { margin-top: clamp(8px, 2cqh, 20px); }
    .hub-feature { padding-block: clamp(5px, 1.1cqh, 10px); }

    /* The panel band's height comes from the window, never from what the
       panels hold: it takes the room below the stage up to a cap, and the
       rows fit inside (fitRows). Sized by content, the band grew as data
       arrived and, the page being centred, pushed everything above it up
       by forty points mid-load, under the pointer. */
    .hub-panels { flex: 1 1 0; min-height: clamp(112px, 20cqh, 220px); max-height: clamp(220px, 40cqh, 380px); grid-auto-rows: minmax(0, 1fr); }
    .hub-panel { min-height: clamp(112px, 20cqh, 220px); }
    .hub-panel-body { min-height: 0; overflow: hidden; }
    .hub-panel-body > [hidden] { display: none !important; }

    .hub-hero { gap: clamp(20px, 4cqw, 32px); padding-top: 0; }
    .hub-ring { width: clamp(116px, 23cqh, 176px); height: clamp(116px, 23cqh, 176px); }
    .hub-ring-value { font-size: clamp(32px, 6cqh, 48px); }
    .hub-title { font-size: clamp(24px, 4.2cqh, 32px); }
    .hub-facts { margin-top: clamp(8px, 1.8cqh, 16px); }
    .hub-actions { margin-top: clamp(10px, 2.2cqh, 20px); }
    .hub-module { min-height: clamp(104px, 19cqh, 172px); }
    .hub-module-orb { width: clamp(78px, 13cqh, 116px); height: clamp(78px, 13cqh, 116px); }
    .hub-module-orb > span { width: 40%; height: 40%; }
    .hub-module-value { font-size: clamp(22px, 3.6cqh, 27px); }

    /* Only a genuinely narrow page (not one the app's minimum window can
       reach) stacks the stage and wraps the cards. */
    @container (max-width: 540px) {
      .hub-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .hub-module, .hub-module:nth-child(n + 4) { grid-column: span 1; }
      .hub-module:last-child:nth-child(odd) { grid-column: span 2; }
    }
    @container (max-width: 460px) {
      .hub-stage, .hub-hero { grid-template-columns: 1fr; justify-items: center; }
      .hub-intro { width: 100%; }
    }
    @media (max-width: 1100px) {
      .hub { padding-inline: var(--space-5); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hub-orb-body, .hub-skeleton { animation: none; }
      .hub-ring { transition: none; }
      .hub-feature, .hub-module, .hub-cta, .hub-run-button, .hub-panel-link, .hub-panel-button { transition: none; }
    }

    /* ---------- Motion ---------- */
    /* A section page assembles itself on arrival: the artwork rises into
       place, the copy follows, the tools cascade in one after another, then
       the round button and the panels. Short, transform and opacity only, so
       it is all compositor work, and none of it under Reduce Motion. The fill
       is `backwards`, never `both`: a held end state would override the hover
       lift on the same elements. */
    @keyframes hub-rise { from { opacity: 0; transform: translateY(12px); } }
    @keyframes hub-pop { from { opacity: 0; transform: scale(.92); } }
    @keyframes hub-orb-in { from { opacity: 0; transform: translateY(18px) scale(.9); } }
    /* Increase Contrast (and Reduce Transparency, which asks for the same
       thing from a different direction). The section pages set white text on
       colour, softened for hierarchy; here every line of it goes fully
       opaque, the glass cards gain a dark backing so the text sits on a
       known surface rather than wherever the gradient happens to be, and
       every edge gets a border you can see. */
    @media (prefers-contrast: more), (prefers-reduced-transparency: reduce) {
      .hub-lede, .hub-feature-desc, .hub-feature-metric, .hub-run-caption, .hub-panel-aside,
      .hub-panel-empty, .hub-panel-note, .hub-row-sub, .hub-stat-label, .hub-gauge-label,
      .hub-status-text, .hub-ring-label, .hub-module-head, .hub-module-caption, .hub-empty-body,
      .app-body:has(.hub) .toolbar-title { color: #fff; }
      .hub-panel, .hub-module { border-color: rgb(255 255 255 / .6); background: rgb(0 0 0 / .34); box-shadow: none; }
      .hub-module:hover { border-color: #fff; background: rgb(0 0 0 / .44); }
      .hub-feature { border: 1px solid rgb(255 255 255 / .45); background: rgb(0 0 0 / .24); }
      .hub-feature:hover { background: rgb(0 0 0 / .34); }
      .hub-feature + .hub-feature { margin-top: 4px; }
      .hub-stat { border: 1px solid rgb(255 255 255 / .4); background: rgb(0 0 0 / .26); }
      .hub-panel-link { border: 1px solid #fff; background: rgb(0 0 0 / .3); }
      .hub-panel-button { box-shadow: 0 0 0 2px #fff; }
      .hub-feature:focus-visible, .hub-module:focus-visible, .hub-panel-link:focus-visible { outline-width: 3px; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .hub-orb, .hub-ring { animation: hub-orb-in .7s cubic-bezier(.2, .8, .2, 1) backwards; }
      .hub-intro > *, .hub-hero-text > * { animation: hub-rise .5s cubic-bezier(.2, .8, .2, 1) backwards; }
      .hub-intro > :nth-child(2), .hub-hero-text > :nth-child(2) { animation-delay: .04s; }
      .hub-intro > :nth-child(3), .hub-hero-text > :nth-child(3) { animation-delay: .08s; }
      .hub-intro > :nth-child(4), .hub-hero-text > :nth-child(4) { animation-delay: .12s; }
      .hub-feature { animation: hub-rise .45s cubic-bezier(.2, .8, .2, 1) backwards; animation-delay: .14s; }
      .hub-feature:nth-child(2) { animation-delay: .19s; }
      .hub-feature:nth-child(3) { animation-delay: .24s; }
      .hub-feature:nth-child(4) { animation-delay: .29s; }
      .hub-feature:nth-child(5) { animation-delay: .34s; }
      .hub-run { animation: hub-pop .5s .3s cubic-bezier(.2, .8, .2, 1) backwards; }
      .hub-panel { animation: hub-rise .55s .34s cubic-bezier(.2, .8, .2, 1) backwards; }
      .hub-panel + .hub-panel { animation-delay: .4s; }
      .hub-module { animation: hub-rise .5s cubic-bezier(.2, .8, .2, 1) backwards; animation-delay: .12s; }
      .hub-module:nth-child(2) { animation-delay: .17s; }
      .hub-module:nth-child(3) { animation-delay: .22s; }
      .hub-module:nth-child(4) { animation-delay: .27s; }
      .hub-module:nth-child(5) { animation-delay: .32s; }

      /* Hover: things lean toward the pointer a little. */
      .hub-feature-chevron { transition: transform .2s ease, opacity .2s ease; }
      .hub-feature:hover .hub-feature-chevron { transform: translateX(3px); opacity: .9; }
      .hub-feature-icon { transition: transform .25s cubic-bezier(.2, .8, .2, 1), background .2s ease; }
      .hub-feature:hover .hub-feature-icon { transform: scale(1.08); background: rgb(255 255 255 / .24); }
      .hub-module-orb { transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
      .hub-module:hover .hub-module-orb { transform: rotate(-2deg) scale(1.06) translateY(3px); }
      .hub-row-chevron { transition: transform .2s ease; }
      .hub-row-link:hover .hub-row-chevron { transform: translateX(3px); }
      .side-tile { transition: transform .25s cubic-bezier(.2, .8, .2, 1), filter .18s ease, opacity .18s ease; }
      .side-row:hover .side-tile { transform: scale(1.06); }
      .rail-item[data-active] .side-tile { transform: scale(1.04); }

      /* The page's scroll, inside its own container, glides. */
      .main { scroll-behavior: smooth; }
    }
    .hub-row-bar > span, .hub-meter-fill { transform-origin: left center; }

    /* ---------- Toolbar breadcrumb ---------- */
    /* Where you are, centred like a window title: the section, and the tool
       inside it when there is one. The section is a link back to its page. */
    .topnav { position: relative; }
    .toolbar-title {
      position: absolute; left: 50%; display: flex; align-items: center; gap: var(--space-1);
      max-width: 46%; transform: translateX(-50%);
      color: var(--secondary); font-size: 12.5px; font-weight: 600; white-space: nowrap;
    }
    .toolbar-crumb { padding: 2px 4px; border-radius: 5px; color: inherit; opacity: .8; text-decoration: none; }
    .toolbar-crumb:hover { background: var(--hover); opacity: 1; }
    .toolbar-crumb-sep { width: 8px; height: 8px; opacity: .55; }
    .toolbar-crumb-current { overflow: hidden; color: var(--ink); text-overflow: ellipsis; }
    .app-body:has(.hub) .toolbar-crumb-current { color: #fff; }
    @media (max-width: 720px) { .toolbar-title { display: none; } }
    .main-title { text-wrap: balance; font-size: 24px; font-weight: 700; letter-spacing: -.025em; }
    .main-subtitle { text-wrap: pretty; margin-top: var(--space-half); color: var(--secondary); font-size: 13px; }
    .main-content { padding: 0 var(--space-6) var(--space-8); }

    /* Stat cards. They fill their row (two cards share it, five split it)
       instead of leaving empty tracks at the end, and each carries a faint
       wash of the section's colour so a tool page still reads as part of its
       section. The label is a sentence, not shouted capitals; the figure is
       the loudest thing on the card and lines up digit for digit. */
    .card-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-5); }
    .card, .tbl-wrap, .disk-card { border: .5px solid var(--line); background: var(--surface); }
    .card {
      position: relative; overflow: hidden; display: flex; flex-direction: column;
      padding: var(--space-4) var(--space-4) calc(var(--space-4) - 2px); border-radius: 14px;
      background: linear-gradient(165deg, color-mix(in srgb, var(--accent) 6%, var(--surface)), var(--surface) 58%);
      box-shadow: 0 1px 2px rgb(0 0 0 / .03); transition: border-color .15s, box-shadow .15s, transform .15s;
    }
    .card:hover { border-color: color-mix(in srgb, var(--ink) 22%, transparent); box-shadow: 0 4px 18px rgba(0, 0, 0, .045); }
    .card-label { display: flex; align-items: center; gap: 7px; margin-bottom: var(--space-2); color: var(--secondary); font-size: 12px; font-weight: 600; }
    .card-label::before { width: 6px; height: 6px; flex: none; content: ''; border-radius: 50%; background: var(--accent); opacity: .85; }
    .card-value { font-size: 26px; font-weight: 700; letter-spacing: -.025em; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .card-detail { margin-top: auto; padding-top: var(--space-1); color: var(--secondary); font-size: 12px; line-height: 1.4; }
    .progress, .cpu-track, .folder-bar-track, .info-bar-track, .disk-usage-bar { overflow: hidden; border-radius: 3px; background: var(--track); }
    .progress { height: 5px; margin-top: var(--space-tight); }
    .progress-fill { height: 100%; border-radius: 3px; transition: width .6s ease; }

    .tbl-wrap { overflow: hidden; margin-bottom: var(--space-5); border-radius: 14px; box-shadow: 0 1px 2px rgb(0 0 0 / .03); }
    td.clean-size { white-space: nowrap; }
    .tbl-bar { display: flex; align-items: center; justify-content: space-between; padding: var(--space-3) var(--space-4); border-bottom: .5px solid var(--line); }
    .tbl-title { font-size: 14px; font-weight: 600; }
    .tbl-count, .updating-label { color: var(--secondary); font-size: 11px; }
    .tbl-count { margin-left: var(--space-2); }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: var(--space-2) var(--space-4); border-bottom: .5px solid var(--line); background: var(--hover); color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .3px; text-align: left; text-transform: uppercase; }
    tbody td { padding: var(--space-2) var(--space-4); border-bottom: .5px solid var(--line-soft); font-size: 12px; vertical-align: middle; }
    tbody tr { transition: background .1s; }
    tbody tr:hover { background: var(--hover); }
    tbody tr:last-child td { border-bottom: none; }

    .badge { display: inline-flex; padding: var(--space-half) var(--space-2); border-radius: 4px; font-size: 10px; font-weight: 500; }
    .badge-green { background: color-mix(in srgb, var(--green) 12%, transparent); color: var(--green); }
    .badge-orange { background: color-mix(in srgb, var(--orange) 12%, transparent); color: var(--orange); }
    .badge-red { background: color-mix(in srgb, var(--red) 12%, transparent); color: var(--red); }
    .badge-purple { background: color-mix(in srgb, var(--purple) 12%, transparent); color: var(--purple); }
    .badge-gray { background: color-mix(in srgb, var(--tertiary) 12%, transparent); color: var(--secondary); }
    .badge-blue { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
    .action-cell { min-width: 88px; white-space: nowrap; }

    .btn { padding: 5px var(--space-3); border: .5px solid var(--line); border-radius: 7px; background: var(--surface-soft); color: var(--ink); cursor: pointer; font-family: inherit; font-size: 12px; font-weight: 500; box-shadow: 0 .5px 1px rgb(0 0 0 / .05); transition: background .1s, border-color .1s; }
    .btn:hover { background: var(--pressed); }
    .btn-danger { border-color: color-mix(in srgb, var(--red) 25%, transparent); background: color-mix(in srgb, var(--red) 10%, transparent); color: var(--red); }
    .btn-danger:hover { background: color-mix(in srgb, var(--red) 18%, transparent); }
    .btn-sm { padding: 3px 9px; font-size: 11px; }
    .btn-icon { display: inline-flex; align-items: center; gap: var(--space-1); }
    .btn-icon > span[class*='i-f7-'] { width: 12px; height: 12px; }
    .toast-glyph { width: 14px; height: 14px; flex-shrink: 0; }
    .view-link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--accent); font-size: 13px; }
    .view-link > span { width: 13px; height: 13px; }
    .btn-active { border-color: color-mix(in srgb, var(--accent) 32%, transparent); background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }

    .cpu-bar { display: flex; align-items: center; gap: var(--space-tight); }
    /* Fixed, not `flex: 1` capped at 60px. A flex-basis of zero surrenders every
       pixel when the column is tight, and the CPU column is tight on any window
       narrower than the one this was designed against: the percentage label's
       36px plus the gap took the whole cell, and the bar rendered at zero width.
       A bar that vanishes as the window narrows is worse than no bar. */
    .cpu-track { flex: none; width: 60px; height: 3px; }
    .cpu-fill { height: 100%; border-radius: 2px; }
    .mono { font-family: 'SF Mono', Menlo, monospace; }
    .dim, .item-sub, .ring-label { color: var(--secondary); }
    .item-name { font-weight: 500; }
    .item-sub { font-size: 10px; }
    /* The path a dead startup entry cannot find. Monospaced because it is a
       path, and wrapped mid-token because it is long and the column is not. */
    .item-sub-dead { font-family: 'SF Mono', Menlo, monospace; word-break: break-all; max-width: 42ch; }
    .item-row { display: flex; align-items: center; gap: var(--space-tight); }
    .item-glyph { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent); }
    /* A row with a glyph indents its second line to the name, not the glyph. */
    .item-row:has(> .item-glyph) ~ .item-sub { padding-left: calc(14px + var(--space-tight)); }

    /* Each section's colour, as the accent on its tool pages: selected tabs,
       checkboxes, row glyphs, links and the dots on stat cards follow the
       section the sidebar shows, instead of one blue on every page. Darker
       in light mode and lighter in dark mode, so text in the accent stays
       readable on either sheet; the fill behind white text is mid-tone. */
    .app-body:has(.topnav[data-tone='overview']) { --accent: #6d28d9; --accent-fill: #7a2fe0; }
    .app-body:has(.topnav[data-tone='cleanup']) { --accent: #0f7a3c; --accent-fill: #138a45; }
    .app-body:has(.topnav[data-tone='storage']) { --accent: #0b737b; --accent-fill: #0c7f88; }
    .app-body:has(.topnav[data-tone='performance']) { --accent: #b9381a; --accent-fill: #c9401f; }
    .app-body:has(.topnav[data-tone='apps']) { --accent: #1d5bd6; --accent-fill: #1d5bd6; }
    .app-body:has(.topnav[data-tone='protection']) { --accent: #a8226f; --accent-fill: #b0287c; }
    :root.dark .app-body:has(.topnav[data-tone='overview']) { --accent: #c48bff; --accent-fill: #7a2fe0; }
    :root.dark .app-body:has(.topnav[data-tone='cleanup']) { --accent: #5bd98a; --accent-fill: #12804a; }
    :root.dark .app-body:has(.topnav[data-tone='storage']) { --accent: #5fd9cb; --accent-fill: #0b7a83; }
    :root.dark .app-body:has(.topnav[data-tone='performance']) { --accent: #ff9478; --accent-fill: #c4401f; }
    :root.dark .app-body:has(.topnav[data-tone='apps']) { --accent: #6cb2ff; --accent-fill: #1c5ce0; }
    :root.dark .app-body:has(.topnav[data-tone='protection']) { --accent: #ff86c8; --accent-fill: #b0287c; }
    .run-at-load { display: inline-block; width: 13px; height: 13px; color: var(--green); }
    .item-path { max-width: 220px; overflow: hidden; color: var(--tertiary); font: 10px 'SF Mono', Menlo, monospace; text-overflow: ellipsis; white-space: nowrap; }
    .check { width: 14px; height: 14px; accent-color: var(--accent); cursor: pointer; }
    /* Empty and loading states on the tool pages. A bare sentence still
       works; the full form is a mark, a title and one line, the same shape
       the section pages use. A loading state shows a small spinner, so a
       slow scan reads as working rather than empty. */
    .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: var(--space-10) var(--space-4); color: var(--secondary); font-size: 13px; line-height: 1.5; text-align: center; text-wrap: pretty; }
    td.empty-state { display: table-cell; }
    .empty-mark { display: grid; width: 44px; height: 44px; margin-bottom: var(--space-2); place-items: center; border-radius: 50%; background: var(--surface-inset); color: var(--secondary); }
    .empty-mark > span { width: 21px; height: 21px; }
    .empty-mark[data-kind='clear'] { background: color-mix(in srgb, var(--green) 14%, transparent); color: var(--green); }
    .empty-title { color: var(--ink); font-size: 14px; font-weight: 600; letter-spacing: -.01em; }
    .empty-body { max-width: 50ch; margin: 0; color: var(--secondary); font-size: 12.5px; }
    .empty-state.is-loading::before {
      width: 18px; height: 18px; margin-bottom: var(--space-2); content: '';
      border: 2px solid var(--line); border-top-color: var(--accent); border-radius: 50%;
    }
    td.empty-state.is-loading::before { display: block; margin-inline: auto; }
    @media (prefers-reduced-motion: no-preference) {
      .empty-state.is-loading::before { animation: empty-spin .8s linear infinite; }
      @keyframes empty-spin { to { transform: rotate(1turn); } }
    }

    .tabs { display: flex; width: fit-content; overflow: hidden; gap: 1px; margin-bottom: var(--space-4); border-radius: 7px; background: var(--track); }
    .tab { padding: var(--space-tight) var(--space-4); border: 0; background: var(--surface); color: var(--secondary); cursor: pointer; font-family: inherit; font-size: 12px; font-weight: 500; transition: background .15s, color .15s; }
    .tab:first-child { border-radius: 7px 0 0 7px; }
    .tab:last-child { border-radius: 0 7px 7px 0; }
    .tab.active { background: var(--accent-fill); color: #fff; }
    .tab:hover:not(.active) { background: var(--hover); color: var(--ink); }
    .panel { display: none; }
    .panel.active { display: block; }

    .toast-area { position: fixed; top: 24px; right: 24px; z-index: 100; display: flex; flex-direction: column; gap: var(--space-tight); }
    .toast { display: flex; align-items: center; gap: var(--space-tight); padding: var(--space-3) var(--space-4); border: .5px solid var(--line); border-radius: 9px; background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--shadow); backdrop-filter: blur(20px); font-size: 12px; font-weight: 500; animation: toastIn .25s ease, toastOut .25s ease 2.5s forwards; }
    @keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes toastOut { to { opacity: 0; transform: translateX(30px); } }

    .health-ring { position: relative; width: 88px; height: 88px; flex-shrink: 0; }
    .health-ring svg { width: 88px; height: 88px; transform: rotate(-90deg); }
    .ring-bg { fill: none; stroke: var(--track); stroke-width: 7; }
    .ring-fill { fill: none; stroke-width: 7; stroke-linecap: round; }
    .ring-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; }
    .ring-score { font-size: 20px; font-weight: 700; }
    .ring-label { font-size: 9px; }

    .disk-layout { display: flex; height: 100%; min-height: 520px; gap: 0; }
    .disk-sidebar, .disk-inspector { display: flex; width: 240px; min-width: 240px; flex-direction: column; overflow: hidden; }
    .disk-sidebar { border-right: .5px solid var(--line); }
    .disk-inspector { border-left: .5px solid var(--line); }
    .disk-sidebar-section { padding: var(--space-3); }
    .disk-sidebar-section + .disk-sidebar-section { border-top: .5px solid var(--line); }
    .disk-chart { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; overflow: hidden; }
    .disk-live-status {
      position: absolute; z-index: 2; inset: 12px 16px auto; padding: 10px 12px;
      border: .5px solid var(--line-soft); border-radius: 8px;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
      color: var(--secondary); font-size: 11px; line-height: 1.5;
    }
    .disk-live-heading { color: var(--ink); font-weight: 600; }
    .disk-live-indicator { flex: none; width: 13px; height: 13px; color: var(--accent); animation: disk-live-spin 1.6s linear infinite; }
    .disk-live-metrics { margin-left: auto; color: var(--secondary); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .disk-live-path { overflow: hidden; margin: 4px 0 0 21px; color: var(--secondary); font: 10px/1.5 'SF Mono', Menlo, monospace; text-align: left; text-overflow: ellipsis; white-space: nowrap; }
    @keyframes disk-live-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .disk-live-indicator { animation: none; } .sunburst-svg .segment { transition: none; } }
    @media (max-width: 1000px) { .disk-live-metrics { font-size: 10px; } .disk-live-status { inset: 8px; padding: 8px 10px; } }
    .disk-chart::before { position: absolute; inset: 0; content: ''; pointer-events: none; background: radial-gradient(ellipse at center, var(--surface), var(--app-bg)); }
    .sunburst-svg { position: relative; z-index: 1; width: 100%; height: 100%; max-width: 640px; max-height: 640px; }
    .segment { stroke: var(--app-bg); stroke-width: .8; cursor: pointer; transition: opacity .18s, filter .18s; }
    .segment.is-exiting { pointer-events: none; }
    .segment:hover { filter: brightness(1.08) saturate(1.12); }
    .sunburst-svg:has(.segment:hover) .segment:not(:hover) { opacity: .2; }
    .center-bg { fill: var(--app-bg); cursor: pointer; }
    .center-bg:hover { fill: var(--surface-soft); }
    .center-ring { fill: none; stroke: var(--line); stroke-width: .5; pointer-events: none; }
    .center-text-size { fill: var(--ink); font-size: 16px; font-weight: 700; text-anchor: middle; pointer-events: none; }
    .center-text-name { fill: var(--secondary); font-size: 10.5px; font-weight: 500; text-anchor: middle; pointer-events: none; }
    .center-back { fill: var(--secondary); font-size: 8px; text-anchor: middle; pointer-events: none; opacity: 0; transition: opacity .15s; }
    .center-bg:hover ~ .center-back { opacity: 1; }

    .folder-list { flex: 1; overflow-y: auto; padding: 0 var(--space-3) var(--space-3); }
    .folder-item { display: flex; width: 100%; align-items: center; gap: var(--space-tight); padding: var(--space-1) var(--space-tight); border: 0; border-radius: 6px; background: none; color: inherit; cursor: pointer; font: inherit; text-align: left; transition: background .12s; }
    .folder-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .folder-item:hover { background: var(--hover); }
    .folder-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .folder-name { flex: 1; overflow: hidden; color: var(--ink); font-size: 12px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
    .folder-size { flex-shrink: 0; color: var(--secondary); font-size: 11px; font-variant-numeric: tabular-nums; }
    .folder-bar-track { display: block; width: 40px; height: 4px; flex-shrink: 0; border-radius: 2px; background: var(--track); }
    .folder-bar-fill { display: block; height: 100%; border-radius: 2px; }

    .inspector-title { padding: var(--space-3); border-bottom: .5px solid var(--line); color: var(--ink); font-size: 13px; font-weight: 600; }
    .inspector-body { flex: 1; overflow-y: auto; padding: var(--space-3); }
    .inspector-placeholder { display: flex; height: 100%; align-items: center; justify-content: center; color: var(--tertiary); font-size: 11px; text-align: center; }
    .info-card { animation: fadeSlide .15s ease; }
    @keyframes fadeSlide { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; } }
    .info-icon-row { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
    .info-type-icon { display: flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 8px; font-size: 11px; font-weight: 700; }
    .info-type-name { font-size: 13px; font-weight: 600; word-break: break-word; }
    .info-type-kind { overflow: hidden; margin-top: 1px; color: var(--secondary); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
    .info-row { display: flex; justify-content: space-between; gap: var(--space-2); padding: 6px 0; border-bottom: .5px solid var(--line-soft); font-size: 12px; }
    .info-label { color: var(--secondary); }
    .info-value { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
    .info-path { margin-top: var(--space-3); padding: var(--space-tight) var(--space-2); border-radius: 5px; background: var(--surface-soft); color: var(--secondary); font: 10px/1.4 'SF Mono', Menlo, monospace; word-break: break-all; }
    .info-bar { margin-top: var(--space-3); }
    .info-bar-label { margin-bottom: var(--space-1); color: var(--secondary); font-size: 10px; }
    .info-bar-track { height: 5px; border-radius: 3px; background: var(--track); }
    .info-bar-fill { height: 100%; border-radius: 3px; }
    .info-bar-text { margin-top: var(--space-1); color: var(--secondary); font-size: 10px; text-align: right; }
    .info-drill { margin-top: var(--space-3); padding: var(--space-tight) var(--space-3); border: .5px solid color-mix(in srgb, var(--accent) 18%, transparent); border-radius: 5px; background: color-mix(in srgb, var(--accent) 7%, transparent); color: var(--accent); font-size: 10px; text-align: center; }
    .disk-card { padding: var(--space-3); border-radius: 8px; }
    .disk-card-head { display: flex; align-items: center; gap: var(--space-2); }
    .disk-card-icon { display: grid; width: 30px; height: 30px; flex: none; place-items: center; border-radius: 8px; background: color-mix(in srgb, var(--accent) 14%, var(--surface)); color: var(--accent); }
    .disk-card-icon > span { width: 16px; height: 16px; }
    .disk-card-name { font-size: 12.5px; font-weight: 600; }
    .disk-card-sub { color: var(--tertiary); font-size: 11px; }
    .disk-section-label { overflow: hidden; margin-bottom: var(--space-1); color: var(--secondary); font-size: 12px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
    .disk-total { font-size: 22px; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
    .disk-meta { margin-top: 2px; color: var(--tertiary); font-size: 11px; line-height: 1.45; }
    .disk-list-head { padding-bottom: var(--space-1); }
    .disk-notice:has(.disk-notice-action) { display: flex; flex-direction: column; align-items: flex-start; }
    .disk-notice-action { margin-top: var(--space-2); }
    /* Path bar under the chart, where Finder keeps its own: where you are,
       and every level above it one click away. The current folder is plain
       text. Escape also goes up a level. */
    .disk-crumbs {
      position: absolute; bottom: var(--space-3); left: 50%; z-index: 2; display: flex; max-width: calc(100% - 2 * var(--space-4));
      flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px; padding: 3px 6px;
      border: .5px solid var(--line); border-radius: 999px; background: var(--surface); box-shadow: 0 2px 10px rgb(0 0 0 / .06);
      transform: translateX(-50%);
    }
    .disk-crumb { display: inline-flex; align-items: center; gap: 2px; }
    .disk-crumb-link { padding: 3px 8px; border: 0; border-radius: 999px; background: none; color: var(--accent); cursor: pointer; font-family: inherit; font-size: 12px; font-weight: 500; line-height: 1.4; }
    .disk-crumb-link:hover:not(:disabled) { background: color-mix(in srgb, var(--accent) 10%, transparent); }
    .disk-crumb-link:disabled { color: var(--ink); cursor: default; font-weight: 600; }
    .disk-crumb-sep { width: 9px; height: 9px; color: var(--tertiary); }
    .inspector-placeholder { flex-direction: column; gap: var(--space-3); padding: 0 var(--space-3); line-height: 1.5; }
    .inspector-placeholder-mark { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 50%; background: var(--surface-inset); color: var(--tertiary); }
    .inspector-placeholder-mark > span { width: 19px; height: 19px; }
    .info-type-icon > span { width: 18px; height: 18px; }
    .info-actions { display: flex; flex-wrap: wrap; gap: var(--space-tight); margin-top: var(--space-3); }
    .info-danger { margin-top: var(--space-4); padding-top: var(--space-3); border-top: .5px solid var(--line-soft); }
    .btn-accent { border-color: transparent; background: var(--accent-fill); color: #fff; }
    .btn-accent:hover { background: color-mix(in srgb, var(--accent-fill) 88%, #000); }
    /* Deliberately not a .disk-sidebar-section: those draw a divider above one
       another, which landed a rule flush on this card's own top border. */
    /* Fallback context menu, for a window with no native one to open (a
       browser tab, or a Craft build without nativeUI). Metrics copied from
       AppKit so the two do not look like different applications. */
    .ctx-menu { position: fixed; z-index: 9999; min-width: 190px; padding: var(--space-1); border: .5px solid color-mix(in srgb, var(--ink) 16%, transparent); border-radius: 8px; background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: 0 8px 28px rgb(0 0 0 / .28); backdrop-filter: blur(24px) saturate(180%); }
    .ctx-header { padding: var(--space-1) var(--space-3); overflow: hidden; color: var(--tertiary); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
    .ctx-item { display: block; width: 100%; padding: var(--space-1) var(--space-3); border: 0; border-radius: 4px; background: none; color: var(--ink); font: inherit; font-size: 12px; text-align: left; cursor: default; }
    .ctx-item:hover, .ctx-item:focus { background: var(--accent-fill); color: #fff; outline: none; }
    .ctx-item.is-danger { color: var(--red); }
    .ctx-item.is-danger:hover, .ctx-item.is-danger:focus { background: var(--danger-fill); color: #fff; }
    .ctx-sep { margin: var(--space-1) var(--space-2); border-top: .5px solid color-mix(in srgb, var(--ink) 14%, transparent); }

    .disk-notice-wrap { padding: 0 var(--space-3) var(--space-3); }
    .disk-notice { padding: var(--space-2) var(--space-3); border: .5px solid color-mix(in srgb, var(--orange) 30%, transparent); border-radius: 6px; background: color-mix(in srgb, var(--orange) 10%, var(--surface)); color: var(--secondary); font-size: 10px; line-height: 1.45; }

    .disk-usage-bar { height: 5px; margin: var(--space-2) 0 var(--space-tight); }
    /* Coloured by how full it is, not by a fixed gradient. The old bar ran
       blue to green, so a disk at 99% ended in the colour that means "fine" —
       on the one screen whose job is to say otherwise. */
    .disk-usage-fill { height: 100%; border-radius: 3px; background: var(--green); transition: background .2s ease; }
    .disk-usage-fill.is-tight { background: var(--orange); }
    .disk-usage-fill.is-critical { background: var(--red); }
    .disk-usage-text { display: flex; justify-content: space-between; color: var(--secondary); font-size: 10px; }

    .breadcrumb { display: flex; align-items: center; gap: var(--space-half); margin-bottom: var(--space-3); font-size: 11px; }
    .bc-item { padding: var(--space-half) var(--space-tight); border-radius: 4px; color: var(--secondary); cursor: pointer; font-weight: 500; }
    .bc-item:hover { background: var(--hover); color: var(--ink); }
    .bc-item.active { color: var(--ink); cursor: default; }
    .bc-sep { color: var(--tertiary); font-size: 9px; }
    .statusbar { display: flex; height: 26px; min-height: 26px; align-items: center; gap: var(--space-4); padding: 0 var(--space-4); border-top: .5px solid var(--line); background: var(--surface-soft); color: var(--secondary); font-size: 10px; }
    .statusbar-dot { display: inline-block; width: 5px; height: 5px; margin-right: var(--space-1); border-radius: 50%; }
    .statusbar-spacer { flex: 1; }

    @media (max-width: 1000px) { .disk-inspector { display: none; } }
    @media (max-width: 700px) { .disk-sidebar, .sidebar { display: none; } }

    /* Real app icons, rendered from each bundle's .icns by /api/app-icon.
       `app-icon-missing` is set by the img's onerror: a CLI-only package has
       no .app and so no icon, and an empty box reads as a broken image rather
       than as "this one has no icon". */
    /* Quick Clean: a size is dim until it is real, so a column of placeholders
       reads as pending rather than as data. Same for the headline total, which
       must not be green — the success colour — while it is still scanning. */
    /* The scanning state, which is on screen for up to fifteen seconds while
       ~76 directories are measured. One static word for that long reads as a
       stall, so: a ring that turns, the label at label weight rather than as a
       24px figure it is not yet, and an indeterminate bar underneath.

       The ring is a pseudo-element because `scanCleanupSizes` owns this slot's
       textContent - it swaps between "Scanning", a figure and an em dash - and
       a child element would be wiped on the first write. The bar is a sibling
       for the same reason, shown by the `~` combinator so no JS has to know
       about it.

       `min-height` is on the base class, not the scanning one, so the card
       does not resize when the figure lands. */
    .clean-total { display: flex; min-height: 29px; align-items: center; color: var(--green); }
    .clean-total.is-scanning { gap: var(--space-2); color: var(--secondary); font-size: 15px; font-weight: 500; letter-spacing: 0; }
    .clean-total.is-scanning::before {
      content: '';
      width: 13px;
      height: 13px;
      flex-shrink: 0;
      border: 2px solid color-mix(in srgb, var(--accent) 22%, transparent);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: clean-scan-spin .7s linear infinite;
    }
    @keyframes clean-scan-spin { to { transform: rotate(360deg); } }
    .clean-scanbar { display: none; }
    .clean-total.is-scanning ~ .clean-scanbar {
      display: block;
      position: relative;
      height: 2px;
      margin: var(--space-1) 0 var(--space-tight);
      overflow: hidden;
      border-radius: 1px;
      background: var(--line);
    }
    .clean-total.is-scanning ~ .clean-scanbar::after {
      content: '';
      position: absolute;
      inset: 0 auto 0 0;
      width: 38%;
      border-radius: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      animation: clean-scanbar-slide 1.25s ease-in-out infinite;
    }
    @keyframes clean-scanbar-slide { from { transform: translateX(-100%); } to { transform: translateX(363%); } }
    @media (prefers-reduced-motion: reduce) {
      .clean-total.is-scanning::before { animation: none; border-top-color: color-mix(in srgb, var(--accent) 22%, transparent); }
      .clean-total.is-scanning ~ .clean-scanbar::after { width: 100%; background: color-mix(in srgb, var(--accent) 40%, transparent); animation: none; }
    }
    .clean-size { font-weight: 600; font-variant-numeric: tabular-nums; }
    .clean-size.is-pending { color: var(--tertiary); font-weight: 400; }
    /* Category filter above the Quick Clean table. Plain buttons, because the
       list is long enough that a second control style would be noise. */
    .filter-row { display: flex; flex-wrap: wrap; gap: var(--space-tight); margin-bottom: var(--space-3); }
    .cap { text-transform: capitalize; }

    .app-icon { width: 18px; height: 18px; flex-shrink: 0; border-radius: 4px; object-fit: contain; }
    /* An app with no icon the agent can read (a helper, a URL handler) gets a
       plain tile the size of the others, so its name lines up with the rest
       of the column instead of starting at a gap. `content` swaps what the
       image draws, broken-image glyph included. */
    .app-icon-missing { content: linear-gradient(150deg, var(--track), var(--line)); box-shadow: inset 0 0 0 1px var(--line-soft); }

    .offsite-shell { display: flex; height: 100%; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); padding: var(--space-10); text-align: center; }
    .offsite-shell h1 { font-size: 19px; font-weight: 600; }
    .offsite-shell p { max-width: 46ch; color: var(--secondary); font-size: 13px; line-height: 1.5; }
    .offsite-shell .btn { margin-top: var(--space-tight); padding: var(--space-2) var(--space-5); font-size: 13px; text-decoration: none; }
    /* The App Store edition: controls the sandbox rules out, the reason in
       their place, and the Overview's home folder banner. platform-gate.ts
       sets these; the direct build never matches them. */
    [data-sandbox-hidden] { display: none !important; }
    .sandbox-note { margin: var(--space-2) 0; color: var(--secondary); font-size: 12px; line-height: 1.5; }
    .sandbox-note[hidden] { display: none; }
    .sandbox-banner { display: flex; align-items: center; gap: var(--space-3); margin: 0 0 var(--space-4); padding: var(--space-3) var(--space-4); border: .5px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius: 10px; background: color-mix(in srgb, var(--accent) 8%, transparent); font-size: 12px; line-height: 1.5; }
    .sandbox-banner > [class^='i-'] { flex: none; color: var(--accent); font-size: 22px; }
    .sandbox-banner-text { flex: 1; color: var(--secondary); }
    .sandbox-banner-text strong { display: block; color: var(--ink); font-weight: 600; }
    .sandbox-banner .btn { flex: none; }
    @yield('styles')
  </style>
</head>
<body>
<div class='app-chrome'>
  <div class='app-body'>
    @if (localAgent)
      <AppRail active="@yield('nav')" />
      <div class='app-column'>
        <AppTopNav active="@yield('nav')" />
        <main class='main' data-stx-content>
          @yield('body')
        </main>
      </div>
    @else
      <main class='main' data-stx-content>
        <div class='offsite-shell'>
          <BrandMark :size="52" />
          <h1>SystemCleaner runs on your Mac</h1>
          <p>
            This screen is the app's interface. It reads disks, processes, and
            login items on the machine it is installed on, so there is nothing
            for it to show from a web server.
          </p>
          <a class='btn' href='/#download'>Download for macOS</a>
        </div>
      </main>
    @endif
  </div>
</div>

<script client>
/*
 * The window has no titlebar, so the page has to move it.
 *
 * Craft's window buttons sit over this app's chrome, which is what a Mac app
 * with a sidebar looks like — and it leaves the window with no handle of its
 * own. The usual trick, `-webkit-app-region: drag`, is Chromium's and does
 * nothing here: WebKit has never implemented it, and a WKWebView discards the
 * declaration outright. That is worse than not supporting it, because the
 * stylesheet then reads as though the window can be dragged while it cannot be
 * moved at all. Craft's own answer is `startDrag()`, which hands the press to
 * AppKit and runs a real window drag loop from it.
 *
 * The bands are the sidebar, the top strip and the sticky page header:
 * chrome by intent,
 * and between them they cover the top of the window wherever the pointer
 * lands. A press on anything interactive is left alone, and in a browser —
 * the marketing site renders this same shell — there is no `craft` to call
 * and this does nothing.
 */
interface CraftWindowDrag {
  window?: { startDrag?: () => void }
}

function moveWindowFrom(event: Event): void {
  const press = event as MouseEvent
  if (press.button !== 0)
    return

  const craft = (globalThis as { craft?: CraftWindowDrag }).craft
  const drag = craft?.window?.startDrag
  if (typeof drag !== 'function')
    return

  const target = press.target
  if (!(target instanceof Element))
    return
  if (!target.closest('.rail, .topnav, .main-header'))
    return
  if (target.closest('a, button, summary, input, select, textarea, [role="button"], [data-rail-item]'))
    return

  drag.call(craft.window)
}

useEventListener('mousedown', moveWindowFrom, { target: document })

/*
 * Whether this window is the one in front is Craft's answer now.
 *
 * The runtime stamps `data-craft-window-active` on the root element from its
 * NSWindowDelegate, seeded at document-start and restated whenever a window is
 * attached, so the CSS above needs nothing from this file.
 *
 * What stood here was forty lines reaching the same conclusion badly. It read
 * `document.hasFocus()`, which inside a WKWebView reports whether the *web
 * view* holds first responder rather than whether the window is key — a window
 * perfectly in front with focus elsewhere painted itself grey. It then branched
 * on whether `craft.window` existed to tell a Craft window from a browser tab.
 * And it had not run at all since the edit that left `}: void {` in the middle
 * of it: one syntax error took the whole client block with it, which is why the
 * rail stayed blue behind other windows no matter what the CSS said.
 */
</script>
<!-- Loaded for every app page: `nativeConfirm` and `nativeAlert` replace the
     web dialogs on the destructive actions, and every screen has one. -->
<script src="/platform-gate.js"></script>
<script src="/native-dialog.js"></script>
<script src="/scan-updates.js"></script>
<script src="/disk-chart.js"></script>
<script src="/disk-panel.js"></script>
<!-- Replaces AppKit's default menubar with one that knows this app: every
     screen on Cmd+1..9, Rescan on Cmd+R, and Edit's roles wired so Copy and
     Paste work in the filter fields. -->
<script src="/app-menu.js"></script>
<script src="/app-toolbar.js"></script>
<script src="/auto-update.js"></script>
<script src="/schedule-notice.js"></script>
<script src="/hub-metrics.js"></script>
<script src="/prefetch.js"></script>
<!-- Wires the Settings panel above: Cmd+, from the menubar or the page, the
     profile chip in the top strip, and the controls inside it. -->
<script src="/settings-panel.js"></script>
<script src="/vpn-panel.js"></script>

</body>
</html>
