<!DOCTYPE html>
<html lang='en'>
<head>
  <meta charset='UTF-8'>
  <meta name='viewport' content='width=device-width, initial-scale=1.0'>
  <title>SystemCleaner</title>
  @appearanceBootstrap({
    storageKey: 'systemcleaner-appearance',
    appearance: { key: 'sidebarStyle', attribute: 'appearance', allowed: ['macos'], default: 'macos' },
    colorMode: { key: 'colorMode', attribute: 'color-mode', default: 'system' },
  })
  <style>
    :root {
      color-scheme: light;
      --app-bg: #f5f5f7;
      --surface: #ffffff;
      --surface-soft: #eeeef1;
      --surface-inset: #e9e9ed;
      --line: rgba(60, 60, 67, .14);
      --line-soft: rgba(60, 60, 67, .08);
      --ink: #1d1d1f;
      --secondary: #6e6e73;
      --tertiary: #8e8e93;
      --track: #d8d8dd;
      --hover: rgba(0, 0, 0, .035);
      --pressed: rgba(0, 0, 0, .075);
      --accent: #007aff;
      --green: #248a3d;
      --orange: #c45d00;
      --red: #d70015;
      --purple: #8944ab;
      --shadow: 0 10px 30px rgba(0, 0, 0, .12);
    }
    :root.dark {
      color-scheme: dark;
      --app-bg: #1a1a1c;
      --surface: #242426;
      --surface-soft: #2c2c2e;
      --surface-inset: #202022;
      --line: rgba(255, 255, 255, .1);
      --line-soft: rgba(255, 255, 255, .055);
      --ink: #f5f5f7;
      --secondary: #98989d;
      --tertiary: #6c6c70;
      --track: #3a3a3c;
      --hover: rgba(255, 255, 255, .045);
      --pressed: rgba(255, 255, 255, .1);
      --accent: #0a84ff;
      --green: #30d158;
      --orange: #ff9f0a;
      --red: #ff453a;
      --purple: #bf5af2;
      --shadow: 0 14px 38px rgba(0, 0, 0, .38);
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%; overflow: hidden; background: var(--app-bg); color: var(--ink);
      font-family: -apple-system, 'SF Pro Text', BlinkMacSystemFont, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .1s; }
    ::view-transition-group(root) { background: var(--app-bg); }
    [data-stx-content] { min-height: 100%; background: var(--app-bg); }
    [x-cloak] { display: none !important; }
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { border-radius: 3px; background: var(--line); }

    .app-chrome { display: flex; width: 100vw; height: 100vh; flex-direction: column; overflow: hidden; background: var(--app-bg); }
    .app-body { display: flex; min-width: 0; flex: 1; overflow: hidden; }
    .main { min-width: 0; flex: 1; overflow-y: auto; background: var(--app-bg); }
    .main-header { position: sticky; top: 0; z-index: 10; padding: 24px 28px 12px; background: linear-gradient(to bottom, var(--app-bg) 72%, transparent); }

    /* ---------- Icon rail ---------- */
    /* No fill and no divider: the rail sits on the same surface as the
       content column so the two read as one canvas, and the only thing that
       draws a shape is the selected button. */
    .rail {
      display: flex; width: 74px; min-width: 74px; height: 100%;
      flex-direction: column; align-items: center; gap: 22px;
      padding: 16px 0 14px;
      background: transparent;
    }
    .rail-brand { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 13px; }
    .rail-brand img { width: 28px; height: 28px; }
    /* Groups are separated by space alone. A rule between 46px buttons reads
       as a stray underline rather than a divider. */
    .rail-groups { display: flex; flex: 1; flex-direction: column; gap: 22px; min-height: 0; overflow-y: auto; scrollbar-width: none; }
    .rail-groups::-webkit-scrollbar { width: 0; height: 0; }
    .rail-group { display: flex; flex-direction: column; gap: 8px; }
    .rail-foot { display: flex; flex-direction: column; gap: 8px; }

    .rail-item {
      position: relative; display: grid; width: 46px; height: 46px; place-items: center;
      border-radius: 14px; color: var(--accent); text-decoration: none;
      transition: background .14s ease, color .14s ease, transform .14s ease;
    }
    .rail-item:hover { background: var(--hover); }
    .rail-item:active { transform: scale(.95); }
    .rail-item[data-active] { background: var(--accent); color: #fff; box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 34%, transparent); }
    .rail-item[data-active]:hover { background: var(--accent); }
    .rail-icon { width: 21px; height: 21px; }
    .rail-badge { color: var(--tertiary); cursor: default; }

    /* Labels moved into hover tooltips when the rail lost its text column. */
    .rail-tip {
      position: absolute; left: calc(100% + 10px); z-index: 50;
      padding: 5px 9px; border: .5px solid var(--line); border-radius: 7px;
      background: var(--surface); color: var(--ink); box-shadow: var(--shadow);
      font-size: 11px; font-weight: 500; white-space: nowrap;
      opacity: 0; pointer-events: none; transform: translateX(-4px);
      transition: opacity .14s ease, transform .14s ease;
    }
    .rail-item:hover .rail-tip, .rail-item:focus-visible .rail-tip { opacity: 1; transform: translateX(0); }
    .rail-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .main-title { font-size: 22px; font-weight: 700; letter-spacing: -.02em; }
    .main-subtitle { margin-top: 2px; color: var(--secondary); font-size: 12px; }
    .main-content { padding: 0 28px 32px; }

    .card-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .card, .tbl-wrap, .disk-card { border: .5px solid var(--line); background: var(--surface); }
    .card { padding: 18px; border-radius: 16px; transition: border-color .15s, box-shadow .15s; }
    .card:hover { border-color: color-mix(in srgb, var(--ink) 22%, transparent); box-shadow: 0 4px 18px rgba(0, 0, 0, .045); }
    .card-label { margin-bottom: 6px; color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .3px; text-transform: uppercase; }
    .card-value { font-size: 24px; font-weight: 700; letter-spacing: -.02em; }
    .card-detail { margin-top: 3px; color: var(--secondary); font-size: 11px; }
    .progress, .cpu-track, .folder-bar-track, .info-bar-track, .disk-usage-bar { overflow: hidden; border-radius: 3px; background: var(--track); }
    .progress { height: 5px; margin-top: 6px; }
    .progress-fill { height: 100%; border-radius: 3px; transition: width .6s ease; }

    .tbl-wrap { overflow: hidden; margin-bottom: 20px; border-radius: 16px; }
    .tbl-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: .5px solid var(--line); }
    .tbl-title { font-size: 14px; font-weight: 600; }
    .tbl-count, .updating-label { color: var(--secondary); font-size: 11px; }
    .tbl-count { margin-left: 8px; }
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 8px 14px; border-bottom: .5px solid var(--line); background: var(--hover); color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .3px; text-align: left; text-transform: uppercase; }
    tbody td { padding: 8px 14px; border-bottom: .5px solid var(--line-soft); font-size: 12px; vertical-align: middle; }
    tbody tr { transition: background .1s; }
    tbody tr:hover { background: var(--hover); }
    tbody tr:last-child td { border-bottom: none; }

    .badge { display: inline-flex; padding: 2px 7px; border-radius: 4px; font-size: 10px; font-weight: 500; }
    .badge-green { background: color-mix(in srgb, var(--green) 12%, transparent); color: var(--green); }
    .badge-orange { background: color-mix(in srgb, var(--orange) 12%, transparent); color: var(--orange); }
    .badge-red { background: color-mix(in srgb, var(--red) 12%, transparent); color: var(--red); }
    .badge-purple { background: color-mix(in srgb, var(--purple) 12%, transparent); color: var(--purple); }
    .badge-gray { background: color-mix(in srgb, var(--tertiary) 12%, transparent); color: var(--secondary); }
    .badge-blue { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
    .action-cell { min-width: 88px; white-space: nowrap; }

    .btn { padding: 4px 12px; border: .5px solid var(--line); border-radius: 6px; background: var(--surface-soft); color: var(--ink); cursor: pointer; font-family: inherit; font-size: 11px; font-weight: 500; transition: background .1s, border-color .1s; }
    .btn:hover { background: var(--pressed); }
    .btn-danger { border-color: color-mix(in srgb, var(--red) 25%, transparent); background: color-mix(in srgb, var(--red) 10%, transparent); color: var(--red); }
    .btn-danger:hover { background: color-mix(in srgb, var(--red) 18%, transparent); }
    .btn-sm { padding: 2px 8px; font-size: 10px; }
    .btn-icon { display: inline-flex; align-items: center; gap: 5px; }
    .btn-icon > span[class*='i-f7-'] { width: 12px; height: 12px; }
    .toast-glyph { width: 14px; height: 14px; flex-shrink: 0; }
    .view-link { display: inline-flex; align-items: center; gap: 5px; color: var(--accent); font-size: 13px; }
    .view-link > span { width: 13px; height: 13px; }
    .btn-active { border-color: color-mix(in srgb, var(--accent) 32%, transparent); background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }

    .cpu-bar { display: flex; align-items: center; gap: 6px; }
    .cpu-track { max-width: 60px; height: 3px; flex: 1; }
    .cpu-fill { height: 100%; border-radius: 2px; }
    .mono { font-family: 'SF Mono', Menlo, monospace; }
    .dim, .item-sub, .ring-label { color: var(--secondary); }
    .item-name { font-weight: 500; }
    .item-sub { font-size: 10px; }
    .item-row { display: flex; align-items: center; gap: 6px; }
    .item-glyph { width: 14px; height: 14px; flex-shrink: 0; color: var(--accent); }
    .run-at-load { display: inline-block; width: 13px; height: 13px; color: var(--green); }
    .item-path { max-width: 220px; overflow: hidden; color: var(--tertiary); font: 10px 'SF Mono', Menlo, monospace; text-overflow: ellipsis; white-space: nowrap; }
    .check { width: 14px; height: 14px; accent-color: var(--accent); cursor: pointer; }
    .empty-state { padding: 40px 16px; color: var(--tertiary); font-size: 13px; text-align: center; }

    .tabs { display: flex; width: fit-content; overflow: hidden; gap: 1px; margin-bottom: 16px; border-radius: 7px; background: var(--track); }
    .tab { padding: 6px 16px; border: 0; background: var(--surface); color: var(--secondary); cursor: pointer; font-family: inherit; font-size: 12px; font-weight: 500; transition: background .15s, color .15s; }
    .tab:first-child { border-radius: 7px 0 0 7px; }
    .tab:last-child { border-radius: 0 7px 7px 0; }
    .tab.active { background: var(--accent); color: #fff; }
    .tab:hover:not(.active) { background: var(--hover); color: var(--ink); }
    .panel { display: none; }
    .panel.active { display: block; }

    .toast-area { position: fixed; top: 24px; right: 24px; z-index: 100; display: flex; flex-direction: column; gap: 6px; }
    .toast { display: flex; align-items: center; gap: 6px; padding: 10px 16px; border: .5px solid var(--line); border-radius: 9px; background: color-mix(in srgb, var(--surface) 90%, transparent); box-shadow: var(--shadow); backdrop-filter: blur(20px); font-size: 12px; font-weight: 500; animation: toastIn .25s ease, toastOut .25s ease 2.5s forwards; }
    @keyframes toastIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
    @keyframes toastOut { to { opacity: 0; transform: translateX(30px); } }

    .health-ring { position: relative; width: 88px; height: 88px; flex-shrink: 0; }
    .health-ring svg { width: 88px; height: 88px; transform: rotate(-90deg); }
    .ring-bg { fill: none; stroke: var(--track); stroke-width: 7; }
    .ring-fill { fill: none; stroke-width: 7; stroke-linecap: round; }
    .ring-text { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; }
    .ring-score { font-size: 20px; font-weight: 700; }
    .ring-label { font-size: 9px; }

    .disk-layout { display: flex; height: 100%; min-height: 520px; gap: 0; }
    .disk-sidebar, .disk-inspector { display: flex; width: 240px; min-width: 240px; flex-direction: column; overflow: hidden; }
    .disk-sidebar { border-right: .5px solid var(--line); }
    .disk-inspector { border-left: .5px solid var(--line); }
    .disk-sidebar-section { padding: 14px; }
    .disk-sidebar-section + .disk-sidebar-section { border-top: .5px solid var(--line); }
    .disk-chart { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; overflow: hidden; }
    .disk-chart::before { position: absolute; inset: 0; content: ''; pointer-events: none; background: radial-gradient(ellipse at center, var(--surface), var(--app-bg)); }
    .sunburst-svg { position: relative; z-index: 1; width: 100%; height: 100%; max-width: 640px; max-height: 640px; }
    .segment { stroke: var(--app-bg); stroke-width: .8; cursor: pointer; transition: opacity .18s, filter .18s; }
    .segment:hover { filter: brightness(1.08) saturate(1.12); }
    .sunburst-svg:has(.segment:hover) .segment:not(:hover) { opacity: .2; }
    .center-bg { fill: var(--app-bg); cursor: pointer; }
    .center-bg:hover { fill: var(--surface-soft); }
    .center-ring { fill: none; stroke: var(--line); stroke-width: .5; pointer-events: none; }
    .center-text-size { fill: var(--ink); font-size: 14px; font-weight: 600; text-anchor: middle; pointer-events: none; }
    .center-text-name { fill: var(--secondary); font-size: 10px; font-weight: 500; text-anchor: middle; pointer-events: none; }
    .center-back { fill: var(--secondary); font-size: 8px; text-anchor: middle; pointer-events: none; opacity: 0; transition: opacity .15s; }
    .center-bg:hover ~ .center-back { opacity: 1; }

    .folder-list { flex: 1; overflow-y: auto; padding: 0 14px 14px; }
    .folder-item { display: flex; align-items: center; gap: 6px; padding: 5px 6px; border-radius: 5px; cursor: default; transition: background .12s; }
    .folder-item:hover { background: var(--hover); }
    .folder-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .folder-name { flex: 1; overflow: hidden; color: var(--ink); font-size: 11px; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
    .folder-size { flex-shrink: 0; color: var(--secondary); font-size: 10px; font-variant-numeric: tabular-nums; }
    .folder-bar-track { width: 40px; height: 3px; flex-shrink: 0; }
    .folder-bar-fill { height: 100%; border-radius: 2px; }

    .inspector-title { padding: 12px 14px; border-bottom: .5px solid var(--line); color: var(--secondary); font-size: 10px; font-weight: 600; letter-spacing: .4px; text-transform: uppercase; }
    .inspector-body { flex: 1; overflow-y: auto; padding: 14px; }
    .inspector-placeholder { display: flex; height: 100%; align-items: center; justify-content: center; color: var(--tertiary); font-size: 11px; text-align: center; }
    .info-card { animation: fadeSlide .15s ease; }
    @keyframes fadeSlide { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; } }
    .info-icon-row { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .info-type-icon { display: flex; width: 34px; height: 34px; align-items: center; justify-content: center; border-radius: 8px; font-size: 11px; font-weight: 700; }
    .info-type-name { font-size: 13px; font-weight: 600; word-break: break-word; }
    .info-type-kind { margin-top: 1px; color: var(--secondary); font-size: 10px; }
    .info-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: .5px solid var(--line-soft); font-size: 11px; }
    .info-label { color: var(--secondary); }
    .info-value { color: var(--ink); font-weight: 500; font-variant-numeric: tabular-nums; }
    .info-path { margin-top: 10px; padding: 6px 8px; border-radius: 5px; background: var(--surface-soft); color: var(--secondary); font: 10px/1.4 'SF Mono', Menlo, monospace; word-break: break-all; }
    .info-bar { margin-top: 12px; }
    .info-bar-label { margin-bottom: 5px; color: var(--secondary); font-size: 10px; }
    .info-bar-track { height: 5px; }
    .info-bar-fill { height: 100%; border-radius: 3px; }
    .info-bar-text { margin-top: 3px; color: var(--secondary); font-size: 10px; text-align: right; }
    .info-drill { margin-top: 12px; padding: 6px 10px; border: .5px solid color-mix(in srgb, var(--accent) 18%, transparent); border-radius: 5px; background: color-mix(in srgb, var(--accent) 7%, transparent); color: var(--accent); font-size: 10px; text-align: center; }
    .disk-card { padding: 12px; border-radius: 8px; }
    .disk-usage-bar { height: 5px; margin: 8px 0 6px; }
    .disk-usage-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--accent), var(--green)); }
    .disk-usage-text { display: flex; justify-content: space-between; color: var(--secondary); font-size: 10px; }

    .breadcrumb { display: flex; align-items: center; gap: 2px; margin-bottom: 12px; font-size: 11px; }
    .bc-item { padding: 2px 6px; border-radius: 4px; color: var(--secondary); cursor: pointer; font-weight: 500; }
    .bc-item:hover { background: var(--hover); color: var(--ink); }
    .bc-item.active { color: var(--ink); cursor: default; }
    .bc-sep { color: var(--tertiary); font-size: 9px; }
    .statusbar { display: flex; height: 26px; min-height: 26px; align-items: center; gap: 14px; padding: 0 14px; border-top: .5px solid var(--line); background: var(--surface-soft); color: var(--secondary); font-size: 10px; }
    .statusbar-dot { display: inline-block; width: 5px; height: 5px; margin-right: 4px; border-radius: 50%; }
    .statusbar-spacer { flex: 1; }

    @media (max-width: 1000px) { .disk-inspector { display: none; } }
    @media (max-width: 700px) { .disk-sidebar, .sidebar { display: none; } }

    @yield('styles')
  </style>
</head>
<body>
<div class='app-chrome'>
  <div class='app-body'>
    <AppRail active="@yield('nav')" />
    <main class='main' data-stx-content>
      @yield('body')
    </main>
  </div>
</div>
</body>
</html>
