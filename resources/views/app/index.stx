@extends('layouts/app')
@section('nav', 'dashboard')
@section('body')

<!--
  The overview: where the app opens. A health ring, one card per section with
  the figure that says whether it is worth opening today, and one button for
  the thing most people came to do. The live charts and process table that
  used to be here are System Monitor now, under Performance.

  Every figure is filled client-side by hub-metrics.ts: this page is
  prerendered, and anything computed at build time would describe the build
  machine.
-->
<div class="hub hub-overview" data-tone="overview">
  <section class="hub-hero">
    <div class="hub-ring" data-health-ring aria-label="System health">
      <span class="hub-ring-value" data-metric="health">&hellip;</span>
      <span class="hub-ring-label" data-metric="health-label">Health</span>
    </div>
    <div class="hub-hero-text">
      <h1 class="hub-title">Here is how your Mac is doing</h1>
      <p class="hub-lede">What can be cleaned, what is taking the space, and what is slowing things down, checked on this Mac and nowhere else.</p>
      <ul class="hub-facts" aria-label="This Mac">
        <li><span class="i-f7-desktopcomputer" aria-hidden="true"></span><span data-metric="macos" data-metric-fallback="macOS">macOS</span></li>
        <li><span class="i-f7-bolt-fill" aria-hidden="true"></span><span data-metric="chip" data-metric-fallback="Apple silicon">&hellip;</span></li>
        <li><span class="i-f7-clock-fill" aria-hidden="true"></span><span data-metric="uptime" data-metric-template="Up {value}">Uptime</span></li>
      </ul>
      <div class="hub-actions">
        <a class="hub-cta hub-cta-ghost" href="/app/monitor" data-stx-link>
          <span class="i-f7-waveform-path-ecg" aria-hidden="true"></span>
          System Monitor
        </a>
      </div>
    </div>
  </section>

  <OverviewSummary />

  <div class="hub-run">
    <a class="hub-run-button" href="/app/cleanup" data-stx-link>
      <span class="i-f7-sparkles" aria-hidden="true"></span>
      <span>Clean</span>
    </a>
    <span class="hub-run-caption">Review everything Quick Clean found</span>
  </div>
</div>

@endsection
