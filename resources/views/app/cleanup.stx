<script server>
const { escapeHtml } = require('@system-cleaner/core')
function esc(str) { return escapeHtml(str || '') }
</script>

@extends('layouts/app')
@section('nav', 'cleanup')
@section('body')

<div x-data="{
  selected: [],
  cleaning: {},
  toasts: [],
  toastId: 0,
  cleanCategories: [],
  diskAvail: '-',
  diskPercent: 0,
  targetsLoading: true,
  filter: 'all',

  init() {
    var self = this;
    Promise.all([
      fetch('/api/cleanup-targets', { method: 'POST' }).then(function(r) { return r.json(); }),
      fetch('/api/system-disk-info', { method: 'POST' }).then(function(r) { return r.json(); }),
    ]).then(function(results) {
      var targets = results[0];
      var disk = results[1];
      if (targets.success) self.cleanCategories = targets.targets || [];
      if (disk.success) {
        self.diskAvail = disk.fDiskFree || '-';
        self.diskPercent = disk.diskPct || 0;
      }
      self.targetsLoading = false;
      setTimeout(function() { scanCleanupSizes(); }, 50);
    }).catch(function() { self.targetsLoading = false; });
  },

  toggle(id) { this.selected = this.selected.indexOf(id) === -1 ? this.selected.concat([id]) : this.selected.filter(function(x) { return x !== id; }); },
  isOn(id) { return this.selected.includes(id); },
  allOn(ids) { const keep = this.selected.filter(id => !ids.includes(id)); this.selected = ids.every(id => this.selected.includes(id)) ? keep : keep.concat(ids); },

  safeIds() { return this.cleanCategories.filter(function(c) { return c.risk !== 'caution'; }).map(function(c) { return c.id; }); },
  allSafeSelected() { var s = this.selected; var ids = this.safeIds(); return ids.length > 0 && ids.every(function(id) { return s.indexOf(id) !== -1; }); },
  toggleAllSafe() { this.selected = this.allSafeSelected() ? [] : this.safeIds(); },
  categoriesPresent() { var seen = []; this.cleanCategories.forEach(function(c) { if (seen.indexOf(c.category) === -1) seen.push(c.category); }); return seen.sort(); },
  setFilter(c) { this.filter = c; applyCleanupFilter(c); },
  shortPath(p) {
    if (!p || p.indexOf('/Users/') !== 0) return p;
    var rest = p.slice(7);
    var slash = rest.indexOf('/');
    return '~' + (slash >= 0 ? rest.slice(slash) : '');
  },

  toast(msg, type) {
    const id = ++this.toastId;
    this.toasts = [...this.toasts, { id, msg, type: type || 'info' }];
    setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 4000);
  },

  fmtBytes(b) { if (b >= 1e12) return (b/1e12).toFixed(1)+' TB'; if (b >= 1e9) return (b/1e9).toFixed(1)+' GB'; if (b >= 1e6) return (b/1e6).toFixed(1)+' MB'; if (b >= 1e3) return (b/1e3).toFixed(1)+' KB'; return b+' B'; }
}">

<!-- Reactive toast container -->
<div class='toast-area'>
  <template x-for='note in toasts' :key='note.id'>
    <div class='toast'><span class='toast-glyph' :class="note.type === 'success' ? 'i-f7-checkmark-alt-circle-fill' : note.type === 'error' ? 'i-f7-xmark-circle-fill' : 'i-f7-exclamationmark-triangle-fill'" aria-hidden='true'></span><span x-text='note.msg'></span></div>
  </template>
</div>

<div class='main-header'>
  <div class='main-title'>Quick Clean</div>
  <div class='main-subtitle'>Remove caches, logs, and temporary files to free up disk space</div>
</div>
<div class='main-content'>
  <div x-show='targetsLoading' class='empty-state'>Loading cleanable targets...</div>
  <div x-show='!targetsLoading' x-cloak>
    <CleanupPanel />
  </div>
</div>
</div>

<script data-stx-scoped>
// Action functions that need DOM access live outside x-data to avoid
// double-quote conflicts in HTML attribute values
function _api(endpoint, data) {
  return fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data || {}) })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    });
}

// Standard error tail for any _api(...) chain. Without this, network/server
// failures used to leave in-flight flags like `cleaning[id] = true` set
// permanently and the UI button stayed frozen with no message.
function _apiCatch(label, opts) {
  return function(err) {
    if (opts && opts.clearCleaning) _exec("delete cleaning['' + " + JSON.stringify(opts.clearCleaning) + " + '']");
    var msg = (err && err.message) ? err.message : 'Network error';
    _exec("toast(" + JSON.stringify(label + ': ' + msg) + ", 'error')");
  };
}

function _scope() {
  var el = document.querySelector('[data-stx-scope]');
  return el && el.__stx_state ? el : null;
}

function _exec(stmt) {
  var el = _scope();
  if (el && el.__stx_execute) el.__stx_execute(stmt);
}

function _fmtBytes(b) {
  if (b >= 1e12) return (b/1e12).toFixed(1)+' TB';
  if (b >= 1e9) return (b/1e9).toFixed(1)+' GB';
  if (b >= 1e6) return (b/1e6).toFixed(1)+' MB';
  if (b >= 1e3) return (b/1e3).toFixed(1)+' KB';
  return b+' B';
}

async function doCleanDir(p, name, id, risk) {
  if (!await window.nativeConfirm({
    title: 'Clean ' + name + '?',
    // A cache and a folder of session transcripts warrant different sentences.
    // "Apps rebuild these files" is reassuring and, for a caution target, false.
    message: risk === 'caution'
      ? 'Its contents are removed for good. Nothing rebuilds this one - whatever is in it has to be re-downloaded or is simply gone.'
      : 'Its contents are removed. Apps rebuild these files as they need them.',
    confirmLabel: 'Clean',
    destructive: true,
  })) return;
  _exec("cleaning['' + id + ''] = true");
  _api('/api/clean-dir', { path: p }).then(function(r) {
    _exec("delete cleaning['' + id + '']");
    if (r.success) {
      try { localStorage.removeItem(CACHE_KEY); } catch (e) {}
      // An unmeasured clean really did happen; only its size is unknown.
      // Saying "freed 0 B" would read as a failure.
      var freedNote = r.measured === false ? '' : ' - freed ' + _fmtBytes(r.freedBytes);
      _exec("toast('Cleaned " + name.replace(/'/g, "\\'") + freedNote + "', 'success')");
      // Re-scan so the row's size cell reflects the cleaned-up state
      // instead of holding stale numbers until the user manually rescans.
      scanCleanupSizes(true);
    }
    else _exec("toast('Clean failed: " + (r.error || 'Unknown').replace(/'/g, "\\'") + "', 'error')");
  }).catch(_apiCatch('Clean failed', { clearCleaning: id }));
}

async function doEmptyTrash() {
  if (!await window.nativeConfirm({
    title: 'Empty the Trash?',
    message: 'Everything in it is deleted permanently. This is the one action here that cannot be recovered from.',
    confirmLabel: 'Empty Trash',
    destructive: true,
  })) return;
  _api('/api/empty-trash', {}).then(function(r) {
    if (r.success) _exec("toast('Trash emptied - freed ' + _fmtBytes(r.freedBytes) + '', 'success')");
    else _exec("toast('Failed: " + (r.error || 'Unknown').replace(/'/g, "\\'") + "', 'error')");
  }).catch(_apiCatch('Empty Trash failed'));
}

async function doCleanSelected() {
  var scope = _scope();
  if (!scope || !scope.__stx_state) return;
  var state = scope.__stx_state;
  var ids = (state.selected || []).slice();
  if (ids.length === 0) return;

  // Resolve every id against the category list the API returned, not against
  // the table. The row for a selected id is not reliably in the DOM — the
  // filter buttons hide rows, a rescan re-renders them, and `x-for` is free to
  // reuse nodes — and the old lookup treated a missing row as "no path to
  // clean" and dropped the item on the floor. Silently: the drop also skipped
  // the counter that fires the toast, so a click could clean nothing and say
  // nothing. The state has the path for every id regardless of what is on
  // screen, so ask it.
  var byId = {};
  (state.cleanCategories || []).forEach(function(c) { byId[c.id] = c; });

  var targets = [], unknown = [];
  ids.forEach(function(id) {
    var cat = byId[id];
    if (cat && cat.path) targets.push({ id: id, path: cat.path, name: cat.name, risk: cat.risk });
    else unknown.push(id);
  });

  if (targets.length === 0) {
    _exec("toast('Nothing to clean - those categories are no longer listed. Rescan and try again.', 'error')");
    return;
  }

  var cautionNames = targets.filter(function(t) { return t.risk === 'caution'; }).map(function(t) { return t.name; });
  var confirmed = false;
  try {
    confirmed = await window.nativeConfirm({
      title: 'Clean ' + targets.length + (targets.length === 1 ? ' category?' : ' categories?'),
      // Name the caution ones. A batch confirm that says only "their contents
      // are removed" is how someone loses their session history to one click.
      message: cautionNames.length > 0
        ? 'Their contents are removed. Most are caches apps rebuild, but ' + cautionNames.join(', ') + (cautionNames.length === 1 ? ' holds' : ' hold') + ' content nothing rebuilds.'
        : 'Their contents are removed. Apps rebuild these files as they need them.',
      confirmLabel: 'Clean Selected',
      destructive: true,
    });
  }
  catch (e) {
    // A dialog that cannot be drawn is not consent, so nothing is cleaned —
    // but it is also not a decision the person made, so say so rather than
    // ending the click in silence.
    _exec("toast('Could not open the confirmation dialog, so nothing was cleaned.', 'error')");
    return;
  }
  if (!confirmed) return;

  var freed = 0, failed = 0, done = 0;
  function settle(id) {
    _exec("delete cleaning['" + id + "']");
    if (++done < targets.length) return;
    try { localStorage.removeItem(CACHE_KEY); } catch (e) {}
    var cleaned = targets.length - failed;
    var msg = cleaned > 0
      ? 'Cleaned ' + cleaned + (cleaned === 1 ? ' category' : ' categories') + ' - freed ' + _fmtBytes(freed)
      : 'Nothing could be cleaned';
    if (failed > 0) msg += ' - ' + failed + ' failed';
    if (unknown.length > 0) msg += ' - ' + unknown.length + ' no longer listed';
    _exec("toast('" + msg.replace(/'/g, "\\'") + "', '" + (cleaned > 0 ? (failed > 0 ? 'info' : 'success') : 'error') + "'); selected = []");
    scanCleanupSizes(true);
  }

  targets.forEach(function(t) {
    // The id has to be interpolated into the statement here rather than left
    // as `'' + id + ''` inside the quoted string: the statement is evaluated
    // in the x-data scope, which has no `id` of its own to read.
    _exec("cleaning['" + t.id + "'] = true");
    _api('/api/clean-dir', { path: t.path }).then(function(r) {
      if (r && r.success) freed += r.freedBytes || 0;
      else failed++;
      settle(t.id);
    }).catch(function() {
      failed++;
      settle(t.id);
    });
  });
}

var CACHE_KEY = 'systemcleaner:dir-sizes';
var CACHE_TTL = 5 * 60 * 1000; // 5 minutes

function getCachedSizes() {
  try {
    var raw = localStorage.getItem(CACHE_KEY);
    if (!raw) return null;
    var cached = JSON.parse(raw);
    if (Date.now() - cached.ts > CACHE_TTL) return null;
    return cached.sizes;
  } catch { return null; }
}

function setCachedSizes(sizes) {
  try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), sizes: sizes })); }
  catch { /* storage full or unavailable */ }
}

// Last scan, kept so filtering can re-total without another walk.
var _cleanupSizes = {};

/**
 * Sum sizes without counting nested targets twice.
 *
 * Many targets live inside another one - ~/Library/Caches/Google/Chrome sits
 * under ~/Library/Caches, and so do about thirty others. Adding every row's
 * `du` figure counted those bytes once per level, and the headline "Space
 * Recoverable" came out far larger than the disk could ever give back. A path
 * with an ancestor in the same set contributes nothing; the ancestor already
 * counted it.
 */
function _sumWithoutOverlap(paths, sizes) {
  var total = 0;
  for (var i = 0; i < paths.length; i++) {
    var p = paths[i];
    var nested = false;
    for (var j = 0; j < paths.length; j++) {
      if (j !== i && p.indexOf(paths[j] + '/') === 0) { nested = true; break; }
    }
    if (!nested) total += sizes[p] || 0;
  }
  return total;
}

/** Re-total and re-count from whichever rows the current filter leaves visible. */
function recomputeCleanupTotal() {
  var rows = Array.from(document.querySelectorAll('[data-clean-path]'))
    .filter(function(r) { return r.style.display !== 'none'; });
  var paths = rows.map(function(r) { return r.getAttribute('data-clean-path'); });
  var total = _sumWithoutOverlap(paths, _cleanupSizes);

  var totalEl = document.getElementById('total-cleanable');
  if (totalEl) {
    totalEl.textContent = total > 0 ? _fmtBytes(total) : '< 1 MB';
    totalEl.classList.remove('is-scanning');
  }
  var countEl = document.getElementById('cleanup-visible-count');
  if (countEl) countEl.textContent = String(rows.length);
}

function applyCleanupFilter(cat) {
  document.querySelectorAll('[data-clean-path]').forEach(function(row) {
    var match = cat === 'all' || row.getAttribute('data-clean-category') === cat;
    row.style.display = match ? '' : 'none';
  });
  recomputeCleanupTotal();
}

function applySizes(sizes) {
  _cleanupSizes = sizes;
  var rows = document.querySelectorAll('[data-clean-path]');
  rows.forEach(function(row) {
    var bytes = sizes[row.getAttribute('data-clean-path')] || 0;
    var cell = row.querySelector('.clean-size');
    if (cell) {
      cell.textContent = bytes > 0 ? _fmtBytes(bytes) : '< 1 MB';
      cell.classList.remove('is-pending');
    }
  });
  var labelEl = document.getElementById('cleanup-sort-label');
  if (labelEl) labelEl.textContent = 'sorted by size';
  // Sort rows by size (largest first)
  var tbody = document.getElementById('cleanup-tbody');
  if (tbody) {
    var rowArr = Array.from(rows);
    rowArr.sort(function(a, b) { return (sizes[b.getAttribute('data-clean-path')] || 0) - (sizes[a.getAttribute('data-clean-path')] || 0); });
    rowArr.forEach(function(r) { tbody.appendChild(r); });
  }
  recomputeCleanupTotal();
}

function scanCleanupSizes(force) {
  // Try cache first for instant display
  if (!force) {
    var cached = getCachedSizes();
    if (cached) {
      applySizes(cached);
      return;
    }
  }

  var rows = document.querySelectorAll('[data-clean-path]');
  var paths = [];
  rows.forEach(function(r) { paths.push(r.getAttribute('data-clean-path')); });
  if (paths.length === 0) return;

  var totalEl = document.getElementById('total-cleanable');
  if (totalEl) totalEl.textContent = 'Scanning...';

  // Run scan detached so navigation doesn't kill it
  if (!window._cleanupScanPromise) {
    window._cleanupScanPromise = _api('/api/dir-sizes', { paths: paths }).then(function(r) {
      window._cleanupScanPromise = null;
      if (!r.success || !r.sizes) return;
      setCachedSizes(r.sizes);
      if (document.getElementById('total-cleanable')) {
        applySizes(r.sizes);
      }
    }).catch(function(err) {
      window._cleanupScanPromise = null;
      if (totalEl) {
        totalEl.textContent = '—';
        totalEl.classList.remove('is-scanning');
      }
      _exec("toast('Scan failed: " + (err && err.message || 'network').replace(/'/g, "\\'") + "', 'error')");
    });
  }
}

// Load after targets render (init() triggers scanCleanupSizes).
</script>
@endsection
