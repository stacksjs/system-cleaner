@extends('layouts/app')
@section('nav', 'system')
@section('body')

<style>
.system-layout { display: flex; height: 100%; min-height: 0; }

/* ── App list sidebar ───────────────────────────── */
/* `flex: 0 1 320px` rather than a hard `min-width`: the window is resizable and
   this column used to refuse to give any of it back. At 520px wide that left
   the detail card 58px — less than its own horizontal padding — so the app
   title overflowed past the window edge, the path broke mid-word, and the two
   buttons compressed into 50px-tall stubs reading "Reveal in / Finder". */
.app-list {
  flex: 0 1 320px; width: 320px; min-width: 200px;
  border-right: 0.5px solid var(--line-soft);
  display: flex; flex-direction: column; overflow: hidden;
}
.app-list-header {
  padding: 16px; border-bottom: 0.5px solid var(--line-soft);
}
.app-search {
  width: 100%; padding: 7px 10px; border-radius: 6px;
  background: var(--surface-soft); border: 0.5px solid var(--line);
  color: var(--ink); font-size: 12px; font-family: inherit; outline: none;
}
.app-search::placeholder { color: var(--tertiary); }
.app-search:focus { border-color: var(--accent); }
.app-list-meta {
  padding: 10px 16px 6px; font-size: 11px; color: var(--tertiary); font-weight: 600;
  display: flex; align-items: center; gap: 6px;
}
.app-list-meta .count {
  background: var(--surface-soft); padding: 1px 7px; border-radius: 8px;
  font-size: 10px; font-weight: 500;
}
.app-list-scroll {
  flex: 1; overflow-y: auto; padding: 4px 8px;
}
/* A button, not a div: the row does something now, so it should be reachable
   by Tab and announce itself as pressable. The reset keeps the list looking
   like a list. */
.app-row {
  display: flex; align-items: center; gap: 9px;
  width: 100%; padding: 7px 10px; border: 0; border-radius: 8px;
  background: none; color: inherit; font: inherit; text-align: left; cursor: pointer;
  transition: background 0.1s;
}
.app-row:hover { background: var(--hover); }
.app-row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.app-row.is-selected { background: var(--accent); color: #fff; }
.app-row.is-selected .app-row-size { color: rgba(255,255,255,0.75); }

/* The glyph sits under the image and shows through when a bundle has no icon
   and `onerror` hides the <img>. Stacking beats swapping: no layout shift, and
   nothing to reset when the row is reused for another app. */
.app-row-icon { position: relative; display: block; width: 18px; height: 18px; flex: none; }
.app-row-glyph { position: absolute; inset: 0; font-size: 18px; color: var(--tertiary); }
.app-row-img { position: absolute; inset: 0; width: 18px; height: 18px; object-fit: contain; }

.app-row-name { flex: 1; min-width: 0; font-size: 13px; font-weight: 450; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.app-row-size { font-size: 12px; color: var(--tertiary); font-family: 'SF Mono', Menlo, monospace; white-space: nowrap; }

/* ── Selected app ───────────────────────────────── */
.app-detail-head { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
.app-detail-icon { position: relative; display: block; width: 56px; height: 56px; flex: none; }
.app-detail-glyph { position: absolute; inset: 0; font-size: 56px; color: var(--tertiary); }
.app-detail-img { position: absolute; inset: 0; width: 56px; height: 56px; object-fit: contain; }
.app-detail-titles { min-width: 0; flex: 1; }
/* A long app name wraps instead of running off the edge of the card. */
.app-detail .disk-card-title { overflow-wrap: anywhere; }
.app-detail-version { font-size: 12px; color: var(--tertiary); margin-top: 2px; }
.app-detail-path strong { font-family: 'SF Mono', Menlo, monospace; font-size: 11px; overflow-wrap: anywhere; }
/* Wrap onto a second row before either button is allowed to squeeze: a button
   whose label breaks in half is harder to read than one sitting below. */
.app-detail-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
.app-detail-actions .btn { white-space: nowrap; }

/* Below this the two columns cannot both be useful: 200px of list beside a card
   that needs ~320px to show a path leaves neither readable. Stack them, and let
   each keep its own scroll so the list does not push the detail off-screen. */
@media (max-width: 700px) {
  .system-layout { flex-direction: column; }
  .app-list {
    flex: 0 0 auto; width: 100%; min-width: 0; max-height: 40%;
    border-right: none; border-bottom: 0.5px solid var(--line-soft);
  }
  .system-main { flex: 1; min-height: 0; padding: 16px; }
  .disk-card { padding: 18px 20px; border-radius: 12px; }
  .app-detail-head { gap: 12px; }
}

.app-empty { padding: 20px; color: var(--tertiary); font-size: 12px; text-align: center; }
/* The page owns the full remaining height so both columns scroll internally
   rather than the whole pane scrolling as one. */
.system-content { padding: 0; height: calc(100vh - 74px); }

/* ── Main panel ─────────────────────────────────── */
/* Top-aligned. Centering a single card in the full pane left the volume
   readout floating in the middle of an otherwise empty column. */
.system-main {
  flex: 1; min-width: 0; display: flex; align-items: flex-start; justify-content: flex-start;
  padding: 24px 28px; overflow-y: auto;
}
.disk-card {
  background: var(--surface); border: 0.5px solid var(--line);
  border-radius: 16px; padding: 24px 28px; width: 100%; max-width: 560px;
}
.disk-card-header {
  display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
  margin-bottom: 16px;
}
.disk-card-title { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
/* `nowrap` and `flex: none`: at a narrow window "99% full" wrapped onto two
   lines and pushed the volume name into wrapping with it. */
.disk-card-pct { font-size: 13px; font-weight: 500; color: var(--tertiary); white-space: nowrap; flex: none; }
.disk-card-meta { display: flex; flex-direction: column; gap: 4px; margin-bottom: 20px; }
.disk-card-row { font-size: 12px; color: var(--secondary); }
.disk-card-row strong { color: var(--ink); font-weight: 600; }
.disk-bar-wrap {
  display: flex; align-items: center; gap: 10px;
}
.disk-bar-label { font-size: 11px; color: var(--tertiary); white-space: nowrap; font-family: 'SF Mono', Menlo, monospace; }
.disk-bar-track {
  /* `min-width` so the bar survives a narrow card. `flex: 1` alone has a basis
     of zero, so the two labels either side took the whole row and the bar —
     the one thing the row exists to show — collapsed to nothing. */
  flex: 1; min-width: 80px; height: 8px; background: var(--track);
  border-radius: 4px; overflow: hidden;
}
.disk-bar-fill {
  height: 100%; border-radius: 4px;
  background: linear-gradient(90deg, #0a84ff 0%, #0a84ff 100%);
  transition: width 0.6s ease;
}
.disk-card-footer {
  margin-top: 16px; padding-top: 12px; border-top: 0.5px solid var(--line-soft);
}
.disk-card-stat-row { display: flex; flex-wrap: wrap; gap: 8px 20px; }
.disk-card-stat { font-size: 11px; color: var(--tertiary); white-space: nowrap; }
.disk-card-stat strong { color: var(--ink); }
</style>

<div x-data="{
  apps: [],
  search: '',
  loading: true,
  sizesLoading: false,
  selected: null,
  totalSize: 0,
  disk: null,

  init() {
    var self = this;
    fetch('/api/system-disk-info', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) { if (d.success) self.disk = d; });

    fetch('/api/system-apps', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sizes: false }) })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        self.apps = data.apps || [];
        self.loading = false;
        if (data.sizesPending) self.loadAppSizes();
      })
      .catch(function() { self.loading = false; });
  },

  loadAppSizes() {
    var self = this;
    self.sizesLoading = true;
    fetch('/api/system-apps', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sizes: true }) })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        self.apps = data.apps || [];
        self.totalSize = self.apps.reduce(function(s, a) { return s + (a.sizeBytes || 0); }, 0);
        self.sizesLoading = false;
      })
      .catch(function() { self.sizesLoading = false; });
  },

  fmtSize: function(bytes) {
    if (bytes == null) return '...';
    if (bytes >= 1e9) return (bytes / 1e9).toFixed(2) + ' GB';
    if (bytes >= 1e6) return (bytes / 1e6).toFixed(1) + ' MB';
    if (bytes >= 1e3) return (bytes / 1e3).toFixed(0) + ' KB';
    return bytes + ' B';
  },

  filteredApps: function() {
    if (!this.search) return this.apps;
    var q = this.search.toLowerCase();
    return this.apps.filter(function(a) { return a.name.toLowerCase().includes(q); });
  },

  iconUrl: function(app, size) {
    return '/api/app-icon?size=' + (size || 32) + '&name=' + encodeURIComponent(app.name);
  },

  select: function(app) {
    this.selected = this.selected && this.selected.name === app.name ? null : app;
  },

  reveal: function(app) {
    if (!app || !app.appPath) return;
    fetch('/api/reveal-in-finder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: app.appPath })
    }).catch(function() {});
  }
}">

<div class='main-header'>
  <div class='main-title'>System</div>
  <div class='main-subtitle'>
    <span x-show='loading'>Loading apps...</span>
    <span x-show='!loading' x-cloak>
      <span>{{ apps.length + ' apps' }}</span>
      <span x-show='sizesLoading'> · sizing...</span>
      <span x-show='!sizesLoading' x-cloak>{{ ' · ' + fmtSize(totalSize) + ' total' }}</span>
    </span>
  </div>
</div>
<div class='main-content system-content'>
  <div class='system-layout'>

    <!-- ── App list ──────────────────────────────── -->
    <div class='app-list'>
      <div class='app-list-header'>
        <input type='text' class='app-search' placeholder='Search...' x-model='search' />
      </div>
      <div class='app-list-meta'>
        <span>System</span>
        <span class='count' x-text="loading ? '...' : apps.length">...</span>
      </div>
      <div class='app-list-scroll'>
        <div x-show='loading' style='padding: 20px; text-align: center; color: var(--tertiary); font-size: 12px;'>Scanning apps...</div>
        <!--
          Bind with x-text, not `{{ }}`. Interpolation inside an x-for body
          gets an `x-cloak` wrapper injected for the pre-hydration pass, and
          cloned rows never have it removed, so every row rendered but stayed
          `display: none`.
        -->
        <template x-for='app in filteredApps()' :key='app.name'>
          <button type='button' class='app-row' :class="selected && selected.name === app.name ? 'is-selected' : ''" @click='select(app)'>
            <!--
              The bundle's real icon, served by /api/app-icon. `onerror` hides
              it and reveals the glyph underneath, which is the right answer
              for a bundle with no .icns rather than a broken-image box.

              `onload` un-hides it again, and that pairing is not optional:
              x-for reuses a row element for a different app, so one bundle
              without an icon would otherwise hide the image for every app that
              scrolled through that row afterwards.
            -->
            <span class='app-row-icon'>
              <span class='app-row-glyph i-f7-app' aria-hidden='true'></span>
              <img class='app-row-img' loading='lazy' alt='' :src='iconUrl(app, 32)' onload='this.hidden = false' onerror='this.hidden = true' />
            </span>
            <span class='app-row-name' x-text='app.name'></span>
            <span class='app-row-size' x-text='fmtSize(app.sizeBytes)'></span>
          </button>
        </template>
        <div x-show='!loading && filteredApps().length === 0' class='app-empty'>No apps match that search.</div>
      </div>
    </div>

    <!-- ── Detail / disk panel ───────────────────── -->
    <div class='system-main'>
      <!--
        Selecting an app replaces the volume readout rather than sitting beside
        it: the column is one card wide, and two stacked cards put the thing
        you just clicked below the thing you did not.
      -->
      <div class='disk-card app-detail' x-show='selected' x-cloak>
        <div class='app-detail-head'>
          <span class='app-detail-icon'>
            <span class='app-detail-glyph i-f7-app' aria-hidden='true'></span>
            <img class='app-detail-img' alt='' :src="selected ? iconUrl(selected, 128) : ''" onload='this.hidden = false' onerror='this.hidden = true' />
          </span>
          <div class='app-detail-titles'>
            <div class='disk-card-title' x-text='selected ? selected.name : ""'></div>
            <div class='app-detail-version' x-text="selected && selected.version && selected.version !== '?' ? 'Version ' + selected.version : 'Version unknown'"></div>
          </div>
        </div>
        <div class='disk-card-meta'>
          <div class='disk-card-row'>Size: <strong x-text='selected ? fmtSize(selected.sizeBytes) : ""'></strong></div>
          <div class='disk-card-row app-detail-path'>Location: <strong x-text='selected ? selected.appPath : ""'></strong></div>
        </div>
        <div class='app-detail-actions'>
          <button class='btn btn-sm' @click='reveal(selected)'>Reveal in Finder</button>
          <button class='btn btn-sm' @click='selected = null'>Close</button>
        </div>
      </div>

      <div class='disk-card' x-show='!selected'>
        <div class='disk-card-header'>
          <div>
            <div class='disk-card-title'>Macintosh HD</div>
          </div>
          <div class='disk-card-pct'>{{ disk ? disk.fDiskPct + '% full' : '...' }}</div>
        </div>
        <div class='disk-card-meta'>
          <div class='disk-card-row'>Location: <strong>/</strong></div>
          <div class='disk-card-row'>Available: <strong>{{ disk ? disk.fDiskFree : '...' }}</strong></div>
          <div class='disk-card-row' x-show='disk && disk.diskPurgeable > 0' x-cloak>Purgeable: <strong>{{ disk.fDiskPurgeable }}</strong></div>
        </div>
        <div class='disk-bar-wrap'>
          <span class='disk-bar-label'>{{ disk ? disk.fDiskUsed : '...' }}</span>
          <div class='disk-bar-track'>
            <div class='disk-bar-fill' :style="disk ? disk.fDiskBarStyle : 'width: 0%'"></div>
          </div>
          <span class='disk-bar-label'>{{ disk ? disk.fDiskTotal : '...' }}</span>
        </div>
        <div class='disk-card-footer'>
          <div class='disk-card-stat-row'>
            <div class='disk-card-stat'>Apps: <span x-text="loading ? '...' : fmtSize(totalSize)">...</span></div>
            <div class='disk-card-stat'>Free: <strong>{{ disk ? disk.fDiskFree : '...' }}</strong></div>
            <div class='disk-card-stat'>Used: <strong>{{ disk ? disk.fDiskUsed : '...' }}</strong></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
</div>
@endsection
