@extends('layouts/app')
@section('nav', 'duplicates')
@section('body')

<!--
  Duplicate finder.

  No `//` comments and no double quotes inside this `x-data`: STX flattens the
  attribute onto one line before evaluating it, and either would take the whole
  object down silently. `tests/xdata-parses.test.ts` guards both.

  Commentary that belongs to this state:

  - Selection is by path and never includes a group's keeper. Every group keeps
    one copy no matter what is ticked, because the point of the screen is to
    reclaim the redundant copies, not to delete the file.
  - `selectAllDuplicates()` is the one-click path, and it selects
    everything-but-the-keeper across every group. That is only defensible
    because the scan hashes candidates in full before calling them identical —
    see packages/disk/src/duplicates.ts.
  - The scan runs in the agent, not the page. Navigating away leaves it
    running, so `rejoin()` asks the server what happened rather than showing an
    empty screen over a live scan.
-->
<div x-data="{
  groups: [],
  groupCount: 0,
  duplicateCount: 0,
  wastedBytes: 0,
  wastedFormatted: '0 B',
  scanned: false,
  scanning: false,
  truncated: false,
  scanTime: '',
  scanRoot: '',
  customRoot: '',
  minSizeMB: 1,
  selected: [],
  deleting: false,
  scanProgress: '',
  scanProgressPath: '',
  progressTimer: null,
  rejoinTimer: null,
  toasts: [],
  toastId: 0,

  init() { this.rejoin(); },

  post(endpoint, data) {
    return fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data || {}),
    }).then(function(r) {
      if (!r.ok && r.status !== 403 && r.status !== 409) throw new Error('HTTP ' + r.status);
      return r.json();
    });
  },

  scan() {
    if (this.scanning) return;
    var self = this;
    this.scanning = true;
    this.scanProgress = '';
    this.scanProgressPath = '';
    this.pollProgress();
    this.post('/api/duplicates-scan', { path: this.scanRoot, minSizeMB: this.minSizeMB }).then(function(r) {
      self.scanning = false;
      self.stopProgress();
      if (!r.success) { self.toast(r.error || 'Scan failed', 'error'); return; }
      self.applyResult(r);
      if (window.notifyIfAway) {
        window.notifyIfAway({
          elapsedMs: (parseFloat(String(r.scanTime || '0')) || 0) * 1000,
          title: 'Duplicate scan finished',
          body: r.duplicateCount + ' redundant copies, ' + r.wastedFormatted + ' reclaimable.',
        });
      }
    }).catch(function(err) {
      self.scanning = false;
      self.stopProgress();
      self.toast('Scan failed: ' + (err && err.message ? err.message : 'network'), 'error');
    });
  },

  applyResult(r) {
    this.groups = r.groups || [];
    this.groupCount = r.groupCount || 0;
    this.duplicateCount = r.duplicateCount || 0;
    this.wastedBytes = r.wastedBytes || 0;
    this.wastedFormatted = r.wastedFormatted || '0 B';
    this.truncated = !!r.truncated;
    this.scanTime = r.scanTime || '';
    this.scanned = true;
    var present = {};
    this.groups.forEach(function(g) { g.files.forEach(function(f) { present[f.path] = true; }); });
    this.selected = this.selected.filter(function(p) { return present[p]; });
  },

  rejoin() {
    var self = this;
    this.post('/api/scan-progress').then(function(d) {
      if (!d || !d.scanning || d.kind !== 'duplicates') { self.collectFinished(); return; }
      self.scanning = true;
      self.pollProgress();
      self.watchForResult();
    }).catch(function() {});
  },

  watchForResult() {
    var self = this;
    if (this.rejoinTimer) clearInterval(this.rejoinTimer);
    this.rejoinTimer = setInterval(function() {
      self.post('/api/scan-progress').then(function(d) {
        if (d && d.scanning) return;
        clearInterval(self.rejoinTimer);
        self.rejoinTimer = null;
        self.scanning = false;
        self.stopProgress();
        self.collectFinished();
      }).catch(function() {});
    }, 700);
  },

  collectFinished() {
    var self = this;
    this.post('/api/last-scan', { kind: 'duplicates' }).then(function(d) {
      if (!d || !d.result || !d.result.success) return;
      self.applyResult(d.result);
    }).catch(function() {});
  },

  pollProgress() {
    var self = this;
    this.stopProgress();
    this.progressTimer = setInterval(function() {
      self.post('/api/scan-progress').then(function(d) {
        if (!d || !d.scanning) return;
        var n = d.scanned;
        var count = n >= 1e6 ? (n / 1e6).toFixed(1) + 'M' : n >= 1e3 ? Math.round(n / 1e3) + 'k' : String(n);
        self.scanProgress = count + ' items · ' + Math.round(d.elapsedMs / 1000) + 's';
        self.scanProgressPath = self.shortPath(d.path || '');
      }).catch(function() {});
    }, 400);
  },

  stopProgress() {
    if (this.progressTimer) { clearInterval(this.progressTimer); this.progressTimer = null; }
    this.scanProgress = '';
    this.scanProgressPath = '';
  },

  async chooseFolder() {
    var picked = await window.nativeChooseFolder('Choose a folder to search for duplicates');
    if (!picked) return;
    this.customRoot = picked;
    this.scanRoot = picked;
  },

  customRootLabel() {
    if (!this.customRoot) return '';
    var parts = this.customRoot.split('/').filter(Boolean);
    return parts.length > 0 ? parts[parts.length - 1] : this.customRoot;
  },

  isOn(p) { return this.selected.indexOf(p) !== -1; },
  toggle(p) {
    this.selected = this.selected.indexOf(p) === -1
      ? this.selected.concat([p])
      : this.selected.filter(function(x) { return x !== p; });
  },

  redundantPaths() {
    var paths = [];
    this.groups.forEach(function(g) {
      g.files.forEach(function(f) { if (!f.keep) paths.push(f.path); });
    });
    return paths;
  },

  allDuplicatesSelected() {
    var paths = this.redundantPaths();
    if (paths.length === 0) return false;
    var self = this;
    return paths.every(function(p) { return self.isOn(p); });
  },

  selectAllDuplicates() {
    this.selected = this.allDuplicatesSelected() ? [] : this.redundantPaths();
  },

  selectGroup(group) {
    var paths = group.files.filter(function(f) { return !f.keep; }).map(function(f) { return f.path; });
    var touched = {};
    paths.forEach(function(p) { touched[p] = true; });
    var self = this;
    if (paths.every(function(p) { return self.isOn(p); })) {
      this.selected = this.selected.filter(function(p) { return !touched[p]; });
      return;
    }
    this.selected = this.selected.filter(function(p) { return !touched[p]; }).concat(paths);
  },

  selectedBytes() {
    var picked = {};
    this.selected.forEach(function(p) { picked[p] = true; });
    var total = 0;
    this.groups.forEach(function(g) {
      g.files.forEach(function(f) { if (picked[f.path]) total += f.sizeBytes; });
    });
    return total;
  },

  async remove(mode) {
    if (this.deleting || this.selected.length === 0) return;
    var count = this.selected.length;
    var size = this.fmtBytes(this.selectedBytes());
    var permanent = mode === 'permanent';

    if (!await window.nativeConfirm({
      title: permanent
        ? 'Permanently delete ' + count + ' copy(ies)?'
        : 'Move ' + count + ' copy(ies) to the Trash?',
      message: 'Every group keeps one copy. ' + size + (permanent ? ' is freed immediately and cannot be recovered.' : ' is freed, and you can put them back from Finder.'),
      confirmLabel: permanent ? 'Delete' : 'Move to Trash',
      destructive: permanent,
    })) return;

    var self = this;
    this.deleting = true;
    this.post('/api/bulk-delete', { paths: this.selected, mode: mode, source: 'duplicates' }).then(function(r) {
      self.deleting = false;
      var gone = {};
      (r.succeeded || []).forEach(function(p) { gone[p] = true; });

      self.groups = self.groups
        .map(function(g) {
          return Object.assign({}, g, { files: g.files.filter(function(f) { return !gone[f.path]; }) });
        })
        .filter(function(g) { return g.files.length > 1; });

      self.selected = self.selected.filter(function(p) { return !gone[p]; });
      self.groupCount = self.groups.length;
      self.duplicateCount = self.redundantPaths().length;
      self.wastedBytes = Math.max(0, self.wastedBytes - (r.freedBytes || 0));
      self.wastedFormatted = self.fmtBytes(self.wastedBytes);

      if ((r.succeeded || []).length > 0)
        self.toast('Removed ' + r.succeeded.length + ' copy(ies) - freed ' + r.freedFormatted, 'success');
      if ((r.skipped || []).length > 0)
        self.toast(r.skipped.length + ' skipped: ' + r.skipped[0].reason, 'info');
      if ((r.failed || []).length > 0)
        self.toast(r.failed.length + ' failed: ' + r.failed[0].error, 'error');
    }).catch(function(err) {
      self.deleting = false;
      self.toast('Delete failed: ' + (err && err.message ? err.message : 'network'), 'error');
    });
  },

  reveal(p) { this.post('/api/reveal-in-finder', { path: p }).catch(function() {}); },

  shortPath(p) {
    if (!p || p.indexOf('/Users/') !== 0) return p;
    var rest = p.slice(7);
    var slash = rest.indexOf('/');
    return '~' + (slash >= 0 ? rest.slice(slash) : '');
  },

  fmtDate(value) {
    if (!value) return '-';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '-';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  },

  fmtBytes(b) {
    if (!b) return '0 B';
    if (b >= 1e12) return (b/1e12).toFixed(1)+' TB';
    if (b >= 1e9) return (b/1e9).toFixed(1)+' GB';
    if (b >= 1e6) return (b/1e6).toFixed(1)+' MB';
    if (b >= 1e3) return (b/1e3).toFixed(1)+' KB';
    return b+' B';
  },

  toast(msg, type) {
    var id = ++this.toastId;
    this.toasts = [...this.toasts, { id: id, msg: msg, type: type || 'info' }];
    var self = this;
    setTimeout(function() { self.toasts = self.toasts.filter(function(t) { return t.id !== id; }); }, 5000);
  },
}">

<div class='toast-area'>
  <template x-for='toast in toasts' :key='toast.id'>
    <div class='toast'>
      <span class='toast-glyph' :class="toast.type === 'success' ? 'i-f7-checkmark-alt-circle-fill' : toast.type === 'error' ? 'i-f7-xmark-circle-fill' : 'i-f7-exclamationmark-triangle-fill'" aria-hidden='true'></span>
      <span x-text='toast.msg'></span>
    </div>
  </template>
</div>

<div class='main-header'>
  <div class='main-title'>Duplicates</div>
  <div class='main-subtitle'>Find files that are byte-for-byte identical and keep one of each</div>
</div>
<div class='main-content'>
  <DuplicatesPanel />
</div>
</div>
@endsection
