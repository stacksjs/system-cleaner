@extends('layouts/app')
@section('nav', 'processes')
@section('body')

<style>
.live-indicator {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  /* Auto rather than 8px: it is the right-hand item in the bar now, not a
     trailing word after "sorted by CPU". */
  margin-left: auto;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  transition: color 0.3s;
}
.live-indicator.connected { color: #30d158; }
.live-indicator.disconnected { color: #ff9f0a; }
.live-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  transition: background 0.3s;
}
.live-indicator.connected .live-dot {
  background: #30d158;
  animation: live-pulse 2s ease-in-out infinite;
}
.live-indicator.disconnected .live-dot {
  background: #ff9f0a;
  animation: none;
}
@keyframes live-pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(48, 209, 88, 0.4); }
  50% { opacity: 0.6; box-shadow: 0 0 0 4px rgba(48, 209, 88, 0); }
}
</style>

<!--
  No comments inside the `x-data` literal below. STX collapses the attribute
  onto one line before evaluating it, so a `//` comment swallows the rest of
  the object and the whole block fails to parse — leaving every binding on the
  page empty, with nothing in the console. `tests/xdata-parses.test.ts` guards
  this.

  Two things it used to say inline:
  - `killing` is an in-flight guard so a double click cannot post twice.
  - A refused kill answers 403 with the reason in the body, so the body is read
    first and a status-code message is only the fallback.
-->
<div id='processes-scope' x-data="{
  processes: [],
  totalCPU: 0,
  totalMemUsed: 0,
  feedConnected: false,
  feedLabel: 'Loading',
  selected: [],
  killedPids: [],
  killing: {},
  toasts: [],
  toastId: 0,

  toggle(id) { this.selected = this.selected.indexOf(id) === -1 ? this.selected.concat([id]) : this.selected.filter(function(x) { return x !== id; }); },
  isOn(id) { return this.selected.includes(id); },
  isKilled(pid) { return this.killedPids.includes(pid); },

  toast(msg, type) {
    const id = ++this.toastId;
    this.toasts = [...this.toasts, { id, msg, type: type || 'info' }];
    setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 4000);
  },

  async confirmKill(p) {
    if (!await window.nativeConfirm({
      title: 'Force quit ' + p.name + '?',
      message: 'PID ' + p.pid + '. Unsaved work in this process is lost.',
      confirmLabel: 'Force Quit',
      destructive: true,
    })) return;
    if (this.killing[p.pid]) return;
    this.killing = { ...this.killing, [p.pid]: true };
    fetch('/api/kill-process', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pid: p.pid }),
    })
      .then(r => {
        return r.json().catch(() => null).then(data => {
          if (data && typeof data.success === 'boolean') return data;
          throw new Error('HTTP ' + r.status);
        });
      })
      .then(r => {
        const next = { ...this.killing }; delete next[p.pid]; this.killing = next;
        if (r.success) {
          this.killedPids = [...this.killedPids, p.pid];
          this.toast(p.name + ' killed (PID ' + p.pid + ')', 'success');
        } else {
          this.toast('Kill failed: ' + (r.error || 'Unknown'), 'error');
        }
      })
      .catch(err => {
        const next = { ...this.killing }; delete next[p.pid]; this.killing = next;
        this.toast('Kill failed: ' + (err.message || 'network error'), 'error');
      });
  }
}">

<!-- Reactive toast container -->
<div class='toast-area'>
  <template x-for='toast in toasts' :key='toast.id'>
    <div class=toast><span class=toast-glyph :class="toast.type === success ? i-f7-checkmark-alt-circle-fill : toast.type === error ? i-f7-xmark-circle-fill : i-f7-exclamationmark-triangle-fill" aria-hidden="true"></span><span x-text="toast.msg"></span></div>
  </template>
</div>

<div class='main-header'>
  <div class='main-title'>Background Processes</div>
  <div class='main-subtitle'>Active processes using notable CPU or memory</div>
</div>
<div class='main-content'>
  <ProcessesPanel />
</div>
</div>

<script data-stx-scoped>
// ── Process feed ──────────────────────────────────────────────
// The same-origin API works in development and through the production TLS
// gateway. A ts-broadcasting socket is used only when the host explicitly
// exposes one through `window.__broadcastUrl` or `window.__broadcastPort`.

(function() {
  function applySnapshot(snapshot, label) {
    if (!snapshot || !Array.isArray(snapshot.processes)) return;
    window.__latestProcs = snapshot;
    window.__procFeedLabel = label;

    var scope = document.getElementById('processes-scope');
    if (scope && scope.__stx_execute) {
      scope.__stx_execute('processes = window.__latestProcs.processes; totalCPU = window.__latestProcs.totalCPU; totalMemUsed = window.__latestProcs.totalMemUsed; feedConnected = true; feedLabel = window.__procFeedLabel');
    }
  }

  function markUnavailable() {
    var scope = document.getElementById('processes-scope');
    if (scope && scope.__stx_execute) {
      scope.__stx_execute("feedConnected = false; feedLabel = 'Unavailable'");
    }
  }

  async function poll() {
    if (!document.getElementById('processes-scope')) return;
    try {
      var response = await fetch('/api/live-processes', { method: 'POST' });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      applySnapshot(await response.json(), 'Auto refresh');
    } catch (error) {
      markUnavailable();
    }
  }

  // Keep one lightweight timer across STX navigations and refresh immediately
  // whenever this panel is mounted again.
  poll();
  if (!window.__procPollTimer) {
    window.__procPollTimer = setInterval(poll, 5000);
  }
  window.addEventListener('stx:load', function() {
    if (window.__latestProcs) applySnapshot(window.__latestProcs, window.__procFeedLabel || 'Auto refresh');
    else poll();
  }, { once: true });

  var configuredUrl = typeof window.__broadcastUrl === 'string' ? window.__broadcastUrl : '';
  var configuredPort = window.__broadcastPort;
  if (!configuredUrl && configuredPort == null) return;
  if (window.__procWs && window.__procWs.readyState <= 1) return;

  var retryTimer = null;
  function connect() {
    if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
    var ws = null;
    try {
      var wsProto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      var wsUrl = configuredUrl || (wsProto + '//' + window.location.hostname + ':' + configuredPort + '/ws');
      ws = new WebSocket(wsUrl);
    } catch (error) {
      retryTimer = setTimeout(connect, 3000);
      return;
    }

    window.__procWs = ws;
    ws.onmessage = function(event) {
      try {
        var message = JSON.parse(event.data);
        if (message.event === 'connection_established') {
          ws.send(JSON.stringify({ event: 'subscribe', channel: 'processes' }));
        } else if (message.event === 'subscription_succeeded' && message.channel === 'processes') {
          if (window.__latestProcs) applySnapshot(window.__latestProcs, 'Live');
        } else if (message.event === 'processes.updated' && message.channel === 'processes') {
          applySnapshot(message.data, 'Live');
        }
      } catch (error) {}
    };
    ws.onclose = function() {
      window.__procWs = null;
      retryTimer = setTimeout(connect, 3000);
    };
  }

  connect();
})();
</script>
@endsection
