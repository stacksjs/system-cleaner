<script server>
const { escapeHtml } = require('@system-cleaner/core')
function esc(str) { return escapeHtml(str || '') }
</script>

@extends('layouts/app')
@section('nav', 'startup')
@section('body')

<!--
  No comments inside the `x-data` literal below. STX collapses the attribute
  onto one line before evaluating it, so a `//` comment swallows the rest of
  the object and the whole block fails to parse — leaving every binding on the
  page empty, with nothing in the console. `tests/xdata-parses.test.ts` guards
  this.

  The counts below are methods rather than `get` accessors: the stx runtime
  does not evaluate getters declared on an x-data object literal, so every
  count rendered as 0 while the rows themselves showed the right state.
-->

<div x-data="{
  selected: [],
  startupFilter: 'all',
  startupItems: [],
  loading: true,
  disabledItems: [],
  removedItems: [],
  toasts: [],
  toastId: 0,

  init() {
    var self = this;
    fetch('/api/startup-items', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success) {
          self.startupItems = d.items || [];
          self.disabledItems = (d.items || []).filter(function(i) { return i.disabled; }).map(function(i) { return i.id; });
        }
        self.loading = false;
      })
      .catch(function() { self.loading = false; });
  },

  enabledStartup() { return this.startupItems.filter(function(i) { return !this.disabledItems.includes(i.id); }.bind(this)); },
  disabledStartup() { return this.startupItems.filter(function(i) { return this.disabledItems.includes(i.id); }.bind(this)); },
  enabledIds() { return this.enabledStartup().map(function(i) { return i.id; }); },
  startupSources(scope) { const seen = []; this.startupItems.forEach(function(i) { if (i.scope === scope && seen.indexOf(i.type) === -1) { seen.push(i.type); } }); const names = { agent: 'Launch agents', daemon: 'Launch daemons', registry: 'Registry', 'startup-folder': 'Startup folder' }; const labels = seen.map(function(t) { return names[t] || t; }); return labels.length ? labels.join(' + ') : 'None found'; },

  deadStartup() { return this.startupItems.filter(function(i) { return i.targetMissing && !this.removedItems.includes(i.id); }.bind(this)); },
  deadIds() { return this.deadStartup().map(function(i) { return i.id; }); },
  deadPaths() { return this.deadStartup().map(function(i) { return i.filepath; }); },

  toggle(id) { this.selected = this.selected.indexOf(id) === -1 ? this.selected.concat([id]) : this.selected.filter(function(x) { return x !== id; }); },
  isOn(id) { return this.selected.includes(id); },
  isDisabled(id) { return this.disabledItems.includes(id); },
  isRemoved(id) { return this.removedItems.includes(id); },
  allOn(ids) { const keep = this.selected.filter(id => !ids.includes(id)); this.selected = ids.every(id => this.selected.includes(id)) ? keep : keep.concat(ids); },
  setFilter(f) { this.startupFilter = f; },
  rowVisible(item) {
    if (this.startupFilter === 'all') return true;
    if (this.startupFilter === 'enabled') return !this.isDisabled(item.id);
    if (this.startupFilter === 'dead') return !!item.targetMissing;
    if (this.startupFilter === 'vendor') return item.category === 'vendor' || item.category === 'other' || item.category === 'dev';
    if (this.startupFilter === 'system') return item.category === 'system';
    return true;
  },

  toast(msg, type) {
    const id = ++this.toastId;
    this.toasts = [...this.toasts, { id, msg, type: type || 'info' }];
    setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 4000);
  }
}">

<!-- Reactive toast container -->
<div class='toast-area'>
  <template x-for='note in toasts' :key='note.id'>
    <div class='toast'><span class='toast-glyph' :class="note.type === 'success' ? 'i-f7-checkmark-alt-circle-fill' : note.type === 'error' ? 'i-f7-xmark-circle-fill' : 'i-f7-exclamationmark-triangle-fill'" aria-hidden='true'></span><span x-text='note.msg'></span></div>
  </template>
</div>

<div class='main-header'>
  <div class='main-title'>Startup Items</div>
  <div class='main-subtitle'>Launch Agents & Daemons that run when your Mac starts</div>
</div>
<div class='main-content'>
  <div x-show='loading' class='empty-state'>Scanning startup items...</div>
  <div x-show='!loading' x-cloak>
    <StartupPanel />
  </div>
</div>
</div>

<script data-stx-scoped>
function _api(endpoint, data) {
  return fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data || {}) })
    .then(function(r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    });
}

function _exec(stmt) {
  var el = document.querySelector('[data-stx-scope]');
  if (el && el.__stx_execute) el.__stx_execute(stmt);
}

function _toastErr(label) {
  return function(err) {
    var msg = (err && err.message) ? err.message : 'network error';
    _exec("toast(" + JSON.stringify(label + ': ' + msg) + ", 'error')");
  };
}

async function doToggle(fp, name, action, itemId) {
  var verb = action === 'disable' ? 'Disable' : 'Enable';
  if (!await window.nativeConfirm({
    title: verb + ' ' + name + '?',
    message: 'This changes what runs when you log in.',
    confirmLabel: verb,
  })) return;
  _api('/api/toggle-startup', { filepath: fp, label: name, action: action }).then(function(r) {
    if (r.success) {
      var method = action === 'disable' ? 'disabledItems = [...disabledItems, \'' + itemId + '\']' : 'disabledItems = disabledItems.filter(function(x){ return x !== \'' + itemId + '\' })';
      _exec(method);
      _exec("toast('" + name.replace(/'/g, "\\'") + " " + action + "d', 'success')");
    } else {
      _exec("toast('Failed: " + (r.error || 'Unknown').replace(/'/g, "\\'") + "', 'error')");
    }
  }).catch(_toastErr(verb + ' failed'));
}

async function doRemove(fp, name, itemId) {
  if (!await window.nativeConfirm({
    title: 'Permanently delete ' + name + '?',
    message: 'The launch agent is unloaded and its file removed. This cannot be undone.',
    confirmLabel: 'Delete',
    destructive: true,
  })) return;
  _api('/api/remove-startup', { filepath: fp }).then(function(r) {
    if (r.success) {
      _exec("removedItems = [...removedItems, " + JSON.stringify(itemId) + "]");
      _exec("toast('" + name.replace(/'/g, "\\'") + " removed', 'success')");
    } else {
      _exec("toast('Failed: " + (r.error || 'Unknown').replace(/'/g, "\\'") + "', 'error')");
    }
  }).catch(_toastErr('Remove failed'));
}

/**
 * Delete every entry whose program is missing.
 *
 * The dialog names the count and says why it is safe, because "delete 4
 * startup items" on a screen full of load-bearing daemons reads as the most
 * dangerous button on the page rather than the only harmless one. The server
 * re-checks each path against a fresh scan, so a stale list here cannot
 * remove something that has since been reinstalled.
 */
async function doRemoveDead(paths, ids, names) {
  if (!paths.length) return;

  if (!await window.nativeConfirm({
    title: 'Delete ' + paths.length + (paths.length === 1 ? ' dead startup item?' : ' dead startup items?'),
    message: 'Each one points at a program that is no longer installed, so none of them can run: '
      + names.join(', ') + '. '
      + 'The entries are unloaded and their files deleted. This cannot be undone, but reinstalling the app restores them.',
    confirmLabel: 'Delete',
    destructive: true,
  })) return;

  _api('/api/remove-dead-startup', { filepaths: paths }).then(function(r) {
    const gone = (r.succeeded || []).length;
    const failed = (r.failed || []).length;

    if (gone > 0) {
      // Match the ids back from the paths the server confirmed, so a partly
      // authorized batch greys out exactly the rows that went.
      const removed = ids.filter(function(id, idx) { return (r.succeeded || []).indexOf(paths[idx]) !== -1; });
      _exec('removedItems = [...removedItems, ...' + JSON.stringify(removed) + ']');
      _exec('selected = []');
    }

    let msg = gone > 0
      ? 'Removed ' + gone + (gone === 1 ? ' dead item' : ' dead items')
      : 'Nothing was removed';
    if (failed > 0) msg += ' - ' + failed + ' failed (' + ((r.failed || [])[0] || {}).error + ')';
    _exec('toast(' + JSON.stringify(msg) + ', ' + (gone > 0 ? (failed > 0 ? "'info'" : "'success'") : "'error'") + ')');
  }).catch(_toastErr('Remove failed'));
}

window.doToggle = doToggle;
window.doRemove = doRemove;
window.doRemoveDead = doRemoveDead;
</script>
@endsection
