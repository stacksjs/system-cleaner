@extends('layouts/app')
@section('nav', 'large-files')
@section('body')

<!-- Agent-owned sessions preserve progress, results and options across routes.
     Selection is keyed by path and replaced by assignment, never mutated. -->
<div x-data="{
  files: [],
  selected: [],
  filter: '',
  activeCategory: '',
  minSizeMB: 100,
  scanRoot: '',
  customRoot: '',
  matched: 0,
  totalBytes: 0,
  truncated: false,
  scanTime: '',
  scanning: false,
  cancelling: false,
  cancelled: false,
  scanId: '',
  scanStatus: '',
  scanProgress: '',
  scanProgressPath: '',
  scanStalled: false,
  scanned: false,
  deleting: false,
  lifetimeFreed: '0 B',
  runCount: 0,
  toasts: [],
  toastId: 0,

  init() {
    this.refreshHistory();
    attachScanPage(this, 'large-files');
  },

  post(endpoint, data) {
    return fetch(endpoint, {
      method: 'POST',
      cache: 'no-store',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data || {}),
    }).then(function(r) {
      if (!r.ok && r.status !== 409 && r.status !== 403) throw new Error('HTTP ' + r.status);
      return r.json();
    });
  },

  refreshHistory() {
    var self = this;
    this.post('/api/cleanup-history').then(function(r) {
      if (!r.success) return;
      self.lifetimeFreed = r.lifetimeFreedFormatted;
      self.runCount = r.runCount;
    }).catch(function() {});
  },

  scan() { startScanPage(this, 'large-files', { minSizeMB: Number(this.minSizeMB), path: this.scanRoot }); },
  cancelScan() { cancelScanPage(this, 'large-files'); },

  applyResult(r) {
    this.files = r.files || [];
    this.matched = r.matched || 0;
    this.totalBytes = r.totalBytes || 0;
    this.truncated = !!r.truncated;
    this.scanTime = r.scanTime || '';
    this.scanned = true;
    var present = {};
    this.files.forEach(function(f) { present[f.path] = true; });
    this.selected = this.selected.filter(function(p) { return present[p]; });
  },

  customRootLabel() {
    if (!this.customRoot) return '';
    var parts = this.customRoot.split('/').filter(Boolean);
    return parts.length > 0 ? parts[parts.length - 1] : this.customRoot;
  },

  async chooseFolder() {
    var picked = await window.nativeChooseFolder('Choose a folder to scan');
    if (!picked) return;
    this.customRoot = picked;
    this.scanRoot = picked;
    this.rescanIfScanned();
  },

  rescanIfScanned() { if (this.scanned && !this.scanning) this.scan(); },

  visible() {
    var needle = this.filter.trim().toLowerCase();
    var cat = this.activeCategory;
    return this.files.filter(function(f) {
      if (cat && f.category !== cat) return false;
      if (!needle) return true;
      return f.name.toLowerCase().indexOf(needle) !== -1
        || f.path.toLowerCase().indexOf(needle) !== -1;
    });
  },

  categoryGroups() {
    var counts = {};
    this.files.forEach(function(f) {
      if (!counts[f.category]) counts[f.category] = { category: f.category, label: f.label, count: 0 };
      counts[f.category].count++;
    });
    return Object.keys(counts).map(function(k) { return counts[k]; })
      .sort(function(a, b) { return b.count - a.count; });
  },

  isOn(p) { return this.selected.indexOf(p) !== -1; },

  toggle(p) {
    this.selected = this.selected.indexOf(p) === -1
      ? this.selected.concat([p])
      : this.selected.filter(function(x) { return x !== p; });
  },

  selectableVisible() {
    return this.visible().filter(function(f) { return !f.protected; });
  },

  allVisibleSelected() {
    var rows = this.selectableVisible();
    if (rows.length === 0) return false;
    var self = this;
    return rows.every(function(f) { return self.isOn(f.path); });
  },

  toggleAllVisible() {
    var rows = this.selectableVisible();
    var touched = {};
    rows.forEach(function(f) { touched[f.path] = true; });
    if (this.allVisibleSelected()) {
      this.selected = this.selected.filter(function(p) { return !touched[p]; });
      return;
    }
    var keep = this.selected.filter(function(p) { return !touched[p]; });
    this.selected = keep.concat(rows.map(function(f) { return f.path; }));
  },

  clearSelection() { this.selected = []; },

  selectedBytes() {
    var chosen = {};
    this.selected.forEach(function(p) { chosen[p] = true; });
    return this.files.reduce(function(sum, f) { return chosen[f.path] ? sum + f.sizeBytes : sum; }, 0);
  },

  tableCaption() {
    if (this.scanning) return this.visible().length + ' largest so far · scanning…';
    var shown = this.visible().length;
    var suffix = this.scanTime ? ' · ' + this.scanTime : '';
    if (shown !== this.files.length) return shown + ' of ' + this.files.length + ' shown' + suffix;
    return this.files.length + ' items' + suffix;
  },

  async remove(mode) {
    if (this.scanning || this.deleting || this.selected.length === 0) return;
    var count = this.selected.length;
    var size = this.fmtBytes(this.selectedBytes());
    var permanent = mode === 'permanent';
    if (!await window.nativeConfirm({
      title: permanent
        ? 'Permanently delete ' + count + ' item' + (count === 1 ? '' : 's') + '?'
        : 'Move ' + count + ' item' + (count === 1 ? '' : 's') + ' to the Trash?',
      message: permanent
        ? size + ' is freed immediately and cannot be recovered.'
        : size + ' is freed, and you can put them back from Finder.',
      confirmLabel: permanent ? 'Delete' : 'Move to Trash',
      destructive: permanent,
    })) return;

    var self = this;
    this.deleting = true;
    this.post('/api/bulk-delete', { paths: this.selected, mode: mode, source: 'large-files' })
      .then(function(r) {
        self.deleting = false;
        var gone = {};
        (r.succeeded || []).forEach(function(p) { gone[p] = true; });
        self.files = self.files.filter(function(f) { return !gone[f.path]; });
        self.selected = self.selected.filter(function(p) { return !gone[p]; });
        self.matched = Math.max(0, self.matched - (r.succeeded || []).length);
        self.totalBytes = Math.max(0, self.totalBytes - (r.freedBytes || 0));

        if ((r.succeeded || []).length > 0)
          self.toast('Removed ' + r.succeeded.length + ' item(s) · freed ' + r.freedFormatted, 'success');
        if ((r.skipped || []).length > 0)
          self.toast(r.skipped.length + ' item(s) skipped: ' + r.skipped[0].reason, 'info');
        if ((r.failed || []).length > 0)
          self.toast(r.failed.length + ' item(s) failed: ' + r.failed[0].error, 'error');

        self.refreshHistory();
      })
      .catch(function(err) {
        self.deleting = false;
        self.toast('Delete failed: ' + (err && err.message ? err.message : 'network'), 'error');
      });
  },

  toggleProtect(file) {
    var self = this;
    var endpoint = file.protected ? '/api/unprotect-path' : '/api/protect-path';
    this.post(endpoint, { path: file.path, reason: 'Marked from Large Files' }).then(function(r) {
      if (!r.success) { self.toast('Could not update protection', 'error'); return; }
      var next = !file.protected;
      self.files = self.files.map(function(f) {
        return f.path === file.path ? Object.assign({}, f, { protected: next }) : f;
      });
      if (next) self.selected = self.selected.filter(function(p) { return p !== file.path; });
      self.toast(next ? 'Protected ' + file.name : 'Unprotected ' + file.name, 'success');
    }).catch(function() { self.toast('Could not update protection', 'error'); });
  },

  protectSelected() {
    if (this.selected.length === 0) return;
    var self = this;
    var paths = this.selected.slice();
    Promise.all(paths.map(function(p) {
      return self.post('/api/protect-path', { path: p, reason: 'Marked from Large Files' });
    })).then(function() {
      var marked = {};
      paths.forEach(function(p) { marked[p] = true; });
      self.files = self.files.map(function(f) {
        return marked[f.path] ? Object.assign({}, f, { protected: true }) : f;
      });
      self.selected = [];
      self.toast('Protected ' + paths.length + ' item(s)', 'success');
    }).catch(function() { self.toast('Could not protect every item', 'error'); });
  },

  reveal(p) {
    revealPath(p);
  },

  shortPath(p) {
    if (!p || p.indexOf('/Users/') !== 0) return p;
    var rest = p.slice(7);
    var slash = rest.indexOf('/');
    return '~' + (slash >= 0 ? rest.slice(slash) : '');
  },

  fmtDate(value) {
    if (!value) return '-';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '-';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
  },

  fmtBytes(b) {
    if (!b) return '0 B';
    if (b >= 1e12) return (b/1e12).toFixed(1)+' TB';
    if (b >= 1e9) return (b/1e9).toFixed(1)+' GB';
    if (b >= 1e6) return (b/1e6).toFixed(1)+' MB';
    if (b >= 1e3) return (b/1e3).toFixed(1)+' KB';
    return b+' B';
  },

  toast(msg, type) {
    var id = ++this.toastId;
    this.toasts = [...this.toasts, { id: id, msg: msg, type: type || 'info' }];
    var self = this;
    setTimeout(function() { self.toasts = self.toasts.filter(function(t) { return t.id !== id; }); }, 5000);
  },
}">

<div class='toast-area'>
  <template x-for='note in toasts' :key='note.id'>
    <div class='toast'>
      <span class='toast-glyph' :class="note.type === 'success' ? 'i-f7-checkmark-alt-circle-fill' : note.type === 'error' ? 'i-f7-xmark-circle-fill' : 'i-f7-exclamationmark-triangle-fill'" aria-hidden='true'></span>
      <span x-text='note.msg'></span>
    </div>
  </template>
</div>

<div class='main-header'>
  <div class='main-title'>Large Files</div>
  <div class='main-subtitle'>Find the biggest items on your Mac and clear many of them at once</div>
</div>
<div class='main-content'>
  <LargeFilesPanel />
</div>
</div>
@endsection
