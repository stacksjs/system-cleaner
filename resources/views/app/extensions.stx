@extends('layouts/app')
@section('nav', 'extensions')
@section('body')

<!--
  The `x-data` literal below is an HTML attribute delimited by double quotes,
  so it must not contain one. `toast()` used to build its markup with
  `class="toast-glyph ..."`, which ended the attribute early and left the whole
  block unparseable — every binding on this page rendered empty. Single quotes
  inside the generated markup, always. `tests/xdata-parses.test.ts` guards this.
-->

<div x-data="{
  selected: [],
  browserExtensions: [],
  loading: true,
  totalExtSize: 0,

  init() {
    var self = this;
    fetch('/api/extensions-list', { method: 'POST' })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.success) {
          self.browserExtensions = (d.extensions || []).map(function(e) {
            return Object.assign({}, e, { size: 0, sizeStr: '—' });
          });
        }
        self.loading = false;
      })
      .catch(function() { self.loading = false; });
  },

  toggle(id) { this.selected = this.selected.indexOf(id) === -1 ? this.selected.concat([id]) : this.selected.filter(function(x) { return x !== id; }); },
  isOn(id) { return this.selected.includes(id); },
  allOn(ids) { const keep = this.selected.filter(id => !ids.includes(id)); this.selected = ids.every(id => this.selected.includes(id)) ? keep : keep.concat(ids); },
  toast(msg, type) { var d = document.createElement('div'); d.className='toast'; var glyph = type==='success'?'i-f7-checkmark-alt-circle-fill':type==='error'?'i-f7-xmark-circle-fill':'i-f7-exclamationmark-triangle-fill'; d.innerHTML='<span class=\'toast-glyph '+glyph+'\' aria-hidden=\'true\'></span><span>'+msg+'</span>'; var area = document.querySelector('.toast-area'); if(!area){area=document.createElement('div');area.className='toast-area';document.body.appendChild(area);} area.appendChild(d); setTimeout(function(){d.remove()},4000); }
}">
<div class='toast-area'></div>
<div class='main-header'>
  <div class='main-title'>Browser Extensions</div>
  <div class='main-subtitle'>Installed extensions across all browsers</div>
</div>
<div class='main-content'>
  <div x-show='loading' class='empty-state'>Scanning extensions...</div>
  <div x-show='!loading' x-cloak>
    <ExtensionsPanel />
  </div>
</div>
</div>
@endsection
