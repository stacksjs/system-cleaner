{
  "name": "system-cleaner",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "buddy": "./buddy",
    "dev": "./buddy dev",
    "build": "./buddy build views",
    "build:binaries": "bun ./scripts/build-binaries.ts",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch --no-interaction",
    "release:minor": "./buddy release --bump minor --no-interaction",
    "release:major": "./buddy release --bump major --no-interaction",
    "native": "./buddy dev:native",
    "cli": "bun run packages/cli/bin/system-cleaner.ts",
    "shoot": "bun ./scripts/shoot.ts",
    "e2e:webview": "bun ./scripts/e2e-webview.ts",
    "dev:docs": "bunpress dev docs",
    "build:docs": "bunpress build docs",
    "preview:docs": "bunpress preview docs",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "typecheck": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:check": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "test": "./buddy test"
  },
  "dependencies": {
    "@stacksjs/bun-router": "^0.0.21",
    "@stacksjs/components": "^0.2.166",
    "@stacksjs/stx": "^0.2.166",
    "@stacksjs/ts-cache": "^0.1.5",
    "@stacksjs/ts-cloud": "^0.7.108",
    "@system-cleaner/clean": "workspace:*",
    "@system-cleaner/core": "workspace:*",
    "@system-cleaner/disk": "workspace:*",
    "@system-cleaner/monitor": "workspace:*",
    "@system-cleaner/uninstall": "workspace:*",
    "@ts-charts/format": "^0.2.7",
    "@ts-charts/scale": "^0.2.7",
    "@ts-charts/shape": "^0.2.7",
    "bun-plugin-stx": "^0.2.166",
    "stacks": "^0.70.324",
    "stx-router": "^0.2.166",
    "ts-broadcasting": "^0.0.10"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/f7": "^1.2.2",
    "@types/bun": "^1.3.14",
    "better-dx": "^0.2.22",
    "puppeteer": "^24.42.0",
    "typescript": "^6.0.3"
  }
}
