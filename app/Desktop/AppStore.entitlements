<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store edition runs in the App Sandbox. These belong to
	     Craft's App Store runtime, the app's main executable; the backend and
	     agent it starts inherit the same sandbox and container. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The window talks to the agent over loopback HTTP: the agent listens,
	     the window connects. Nothing else is reached unless you ask (update
	     checks, opening a link). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Folders and files you choose in an Open panel, such as a folder to
	     scan or files to remove. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Filled in by scripts/build-desktop-app.ts from the team and bundle ID
	     the provisioning profile names. -->
	<key>com.apple.application-identifier</key>
	<string>$(APPLICATION_IDENTIFIER)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(TEAM_IDENTIFIER)</string>
</dict>
</plist>
