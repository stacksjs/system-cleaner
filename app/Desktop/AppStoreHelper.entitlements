<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This app's own binary, which Craft starts as `craft-backend` and which
	     starts the agent and the scanner from the same file: all of them run
	     inside the app's sandbox rather than one of their own. Apple allows no
	     other entitlement alongside these two. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
